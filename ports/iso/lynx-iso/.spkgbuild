# description : Minimal HTTPS-capable Lynx text browser for BFSOS live media
# homepage    : https://lynx.invisible-island.net/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : brotli openssl
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=lynx-iso
version=2.9.3
release=1
build_opt="--with-zlib
--with-bzlib
--with-ssl
--with-screen=ncursesw
--enable-ipv6
--enable-locale-charset
--disable-nls"
source="https://invisible-mirror.net/archives/lynx/tarballs/lynx${version}.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
    if [ -f "$PKG/etc/lynx/lynx.cfg" ]; then
        sed -e '/#LOCALE/     a LOCALE_CHARSET:TRUE' \
            -e '/#DEFAULT_ED/ a DEFAULT_EDITOR:vi' \
            -e '/#PERSIST/    a PERSISTENT_COOKIES:TRUE' \
            -i "$PKG/etc/lynx/lynx.cfg" || return 1
    fi
    rm -rf "$PKG/usr/share/doc" "$PKG/usr/share/man" || return 1
}
