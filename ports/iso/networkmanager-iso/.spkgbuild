# description : Minimal NetworkManager daemon plus nmcli/nmtui for BFSOS live media
# homepage    : https://networkmanager.dev/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : iptables libndp newt nss polkit systemd wpa_supplicant
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=networkmanager-iso
version=1.58.1
release=1
build_opt="-Dlibaudit=no
-Dwifi=true
-Dnmcli=true
-Dnmtui=true
-Dreadline=libreadline
-Dconfig_dhcp_default=internal
-Dconcheck=false
-Dlibpsl=false
-Dovs=false
-Dppp=false
-Dnbft=false
-Dselinux=false
-Dqt=false
-Dsession_tracking=systemd
-Dnm_cloud_setup=false
-Dclat=false
-Dmodem_manager=false
-Dintrospection=false
-Dvapi=false
-Ddocs=false
-Dman=false
-Dtests=no
-Dfirewalld_zone=false
-Dmore_logging=false"
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/$version/downloads/NetworkManager-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

pre_build() {
    grep -rl '^#!.*python$' . | xargs -r sed -i '1s/python$/python3/' || return 1
}

post_build() {
    install -d "$PKG/etc/NetworkManager/conf.d" || return 1
    cat > "$PKG/etc/NetworkManager/NetworkManager.conf" <<'EOC'
[main]
plugins=keyfile
EOC
}
