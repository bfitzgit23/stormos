# description : GNU Fortran front end matching the BFSOS GCC toolchain
# homepage    : https://gcc.gnu.org/fortran/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gcc mpfr
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# keep_static is implicit here: scratchpkg keeps *.a files.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gcc-fortran
version=16.2.0
release=4
build_opt="--prefix=/usr --libexecdir=/usr/lib --enable-languages=fortran --disable-bootstrap --disable-libmpx --with-system-zlib --with-pkgversion=BFSOS --disable-fixincludes --enable-threads=posix --enable-__cxa_atexit --enable-default-pie --enable-default-ssp --enable-multilib"
source="https://ftp.gnu.org/gnu/gcc/gcc-$version/gcc-$version.tar.xz"
options="libtool"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	(
	  set -e
	# Match the native BFSOS GCC multilib layout: 64-bit libraries in /usr/lib
	# and ordinary ELF32 compatibility libraries in /usr/lib32.
	sed -e '/m64=/s/lib64/lib/' -i.orig gcc/config/i386/t-linux64 || return 1

	install -d build || return 1
	cd build || return 1

	SED=sed ../configure $build_opt || return 1

	make -j"${JOBS:-1}" || return 1
	make DESTDIR="$PKG" -j1 install || return 1

	ln -sf gfortran "$PKG/usr/bin/f90"
	ln -sf gfortran "$PKG/usr/bin/f95"
	ln -sf gfortran "$PKG/usr/bin/g77"

	# gcc-fortran supplements the native gcc package; do not claim files that
	# are already owned by gcc/binutils.
	for owner in gcc binutils; do
	  pkginfo -l "$owner" 2>/dev/null | while read -r i; do
	    i="/${i#/}"
	    [ -f "$PKG$i" ] && rm -f "$PKG$i"
	    [ -f "$PKG${i%%.gz}" ] && rm -f "$PKG${i%%.gz}"
	  done
	done

	rm -rf "$PKG/usr/share/info" "$PKG/usr/share/gcc-$version"
	rm -rf "$PKG/usr/lib/gcc"/*/"$version"/{install-tools,include-fixed} 2>/dev/null || true
	find "$PKG" -depth -type d -empty -delete
	find "$PKG/usr/lib" "$PKG/usr/lib32" -name 'libgfortran.la' -type f -exec \
	  sed -i -e "s|-L$SRC[^ ]* ||g" {} + 2>/dev/null || true
	)
}
