# description : JSON (JavaScript Object Notation) encoder/decoder for Perl
# homepage    : https://metacpan.org/pod/JSON
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : perl
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=p5-json
version=4.11
release=1
source="https://cpan.metacpan.org/authors/id/I/IS/ISHIGAKI/JSON-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor || return 1
	make || return 1
	make install DESTDIR="$PKG" || return 1

	find "$PKG" \( \
	    -name .packlist -o \
	    -name perllocal.pod -o \
	    -name README -o \
	    -name '*.bs' \
	\) -delete
}
