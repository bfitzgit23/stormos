# description : Time zone database and related utilities
# homepage    : https://www.iana.org/time-zones
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=tzdata
version=2026d
release=1
source="https://www.iana.org/time-zones/repository/releases/${name}${version}.tar.gz https://www.iana.org/time-zones/repository/releases/tzcode${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	#
	# Build the timezone utilities and database.
	#
	make \
	    CC="gcc" \
	    CFLAGS="$CFLAGS" \
	    LDFLAGS="$LDFLAGS" \
	    TOPDIR=/usr \
	    USRDIR=/usr \
	    ETCDIR=/etc \
	    TZDIR=/usr/share/zoneinfo

	#
	# Install entirely into the package staging directory.
	#
	make \
	    DESTDIR="$PKG" \
	    TOPDIR=/usr \
	    USRDIR=/usr \
	    ETCDIR=/etc \
	    TZDIR=/usr/share/zoneinfo \
	    install

	#
	# These manual pages are supplied by the man-pages package.
	#
	rm -f \
	    "$PKG/usr/share/man/man5/tzfile.5" \
	    "$PKG/usr/share/man/man8/tzselect.8" \
	    "$PKG/usr/share/man/man8/zdump.8" \
	    "$PKG/usr/share/man/man8/zic.8"

	#
	# Remove empty manual-page directories left after cleanup.
	#
	rmdir --ignore-fail-on-non-empty \
	    "$PKG/usr/share/man/man5" \
	    "$PKG/usr/share/man/man8" \
	    2>/dev/null || true

	#
	# The administrator or installer should select /etc/localtime.
	# Do not ship an arbitrary default timezone.
	#
	rm -f "$PKG/etc/localtime"

	rmdir --ignore-fail-on-non-empty \
	    "$PKG/etc" \
	    2>/dev/null || true
}
