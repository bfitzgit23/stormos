# description : A fast compiler cache
# homepage    : https://ccache.dev/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : fmt xxhash zstd
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=ccache
version=4.14
release=1
source="https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	PKGMK_CCACHE+=' -D REDIS_STORAGE_BACKEND=OFF'

	cmake -S . -B build -G Ninja $PKGMK_CCACHE \
	  -D CMAKE_INSTALL_PREFIX=/usr \
	  -D CMAKE_INSTALL_LIBDIR=lib \
	  -D CMAKE_BUILD_TYPE=Release \
	  -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	  -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	  -D DEPS=LOCAL \
	  -D ENABLE_IPO=ON \
	  -D ENABLE_TESTING=OFF \
	  -D ENABLE_DOCUMENTATION=OFF

	cmake --build build
	DESTDIR=$PKG cmake --install build

	install -d $PKG/usr/lib/ccache
	# Stage the shared cache directory, but do not run ccache here. During
	# Bootstrap the binary is not installed until pkgadd runs after the build.
	# bootstrap.sh owns the target-specific ccache.conf sizing policy.
	install -d -m 0775 -o 82 -g 82 $PKG/var/cache/ccache

	for c in cc gcc g++ cpp c++; do
	  ln -s /usr/bin/ccache $PKG/usr/lib/ccache/$c
	done
}
