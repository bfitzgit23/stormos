# description : GNU Compiler Collection
# homepage    : https://gcc.gnu.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# keep_static is implicit here: scratchpkg keeps *.a files.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gcc
version=16.2.0
release=2
source="https://ftp.gnu.org/gnu/gcc/gcc-$version/gcc-$version.tar.xz c89 c99"
options="libtool"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# Use /usr/lib as the 64-bit library directory.
	sed \
	    -e '/m64=/s/lib64/lib/' \
	    -i.orig gcc/config/i386/t-linux64

	mkdir -v build
	cd build

	SED=sed \
	../configure \
	    --prefix=/usr \
	    --libexecdir=/usr/lib \
	    --enable-languages=c,c++,objc,obj-c++,lto \
	    --enable-lto \
	    --disable-bootstrap \
	    --disable-libmpx \
	    --with-system-zlib \
	    --with-pkgversion="BFSOS" \
	    --disable-fixincludes \
	    --enable-threads=posix \
	    --enable-__cxa_atexit \
	    --enable-default-pie \
	    --enable-default-ssp \
	    --enable-multilib

	make
	make DESTDIR="$PKG" -j1 install

	#
	# Compatibility compiler links.
	#
	# /usr/lib/cpp must resolve to /usr/bin/cpp.
	#
	install -d -m 0755 "$PKG/usr/lib"

	ln -sf ../bin/cpp "$PKG/usr/lib/cpp"
	ln -sf gcc "$PKG/usr/bin/cc"

	#
	# Install the GCC LTO plugin link for binutils.
	#
	gcc_triplet="$(./gcc/xgcc -B./gcc/ -dumpmachine)"

	install -d -m 0755 "$PKG/usr/lib/bfd-plugins"

	ln -sf \
	    "../../lib/gcc/$gcc_triplet/$version/liblto_plugin.so" \
	    "$PKG/usr/lib/bfd-plugins/liblto_plugin.so"

	#
	# Move GDB auto-load scripts to their proper location.
	#
	install -d -m 0755 \
	    "$PKG/usr/share/gdb/auto-load/usr/lib"

	for gdb_script in "$PKG"/usr/lib/*gdb.py; do
	    [ -e "$gdb_script" ] || continue

	    mv -v \
	        "$gdb_script" \
	        "$PKG/usr/share/gdb/auto-load/usr/lib/"
	done

	#
	# Install the POSIX C89 and C99 compiler wrappers.
	#
	install -D -m 0755 \
	    "$SRC/c89" \
	    "$PKG/usr/bin/c89"

	install -D -m 0755 \
	    "$SRC/c99" \
	    "$PKG/usr/bin/c99"

	rm -rf "$PKG/usr/share/$name-$version"
}

bootstrap_build() {
    if [ "$tcpkg" = gcc-pass1 ]; then
        for file in \
            gcc/config/linux.h \
            gcc/config/i386/linux.h \
            gcc/config/i386/linux64.h
        do
            cp -uv "$file" "$file.orig"

            sed \
                -e "s@/lib\(64\)\?\(32\)\?/ld@$TOOLS&@g" \
                -e "s@/usr@$TOOLS@g" \
                "$file.orig" > "$file"

            {
                echo '#undef STANDARD_STARTFILE_PREFIX_1'
                echo '#undef STANDARD_STARTFILE_PREFIX_2'
                echo "#define STANDARD_STARTFILE_PREFIX_1 \"$TOOLS/lib/\""
                echo '#define STANDARD_STARTFILE_PREFIX_2 ""'
            } >> "$file"

            touch "$file.orig"
        done

        sed -i \
            's@/lib/ld-linux.so.2@/lib32/ld-linux.so.2@g' \
            gcc/config/i386/linux64.h

        sed -i \
            '/MULTILIB_OSDIRNAMES/d' \
            gcc/config/i386/t-linux64

        echo \
            'MULTILIB_OSDIRNAMES = m64=../lib m32=../lib32' \
            >> gcc/config/i386/t-linux64

        mkdir -v build
        cd build

        ../configure \
            --with-gmp="$TOOLS" \
            --with-mpc="$TOOLS" \
            --with-mpfr="$TOOLS" \
            --target="$LFS_TGT" \
            --prefix="$TOOLS" \
            --with-glibc-version=2.44 \
            --with-sysroot="$LFS" \
            --with-newlib \
            --without-headers \
            --enable-default-pie \
            --enable-default-ssp \
            --disable-fixincludes \
            --enable-initfini-array \
            --with-local-prefix="$TOOLS" \
            --with-native-system-header-dir="$TOOLS/include" \
            --disable-nls \
            --disable-shared \
            --disable-decimal-float \
            --disable-threads \
            --disable-libatomic \
            --disable-libgomp \
            --disable-libmpx \
            --disable-libquadmath \
            --disable-libssp \
            --disable-libvtv \
            --disable-libstdcxx \
            --enable-languages=c,c++ \
            --with-multilib-list=m32,m64

        make
        make install

    elif [ "$tcpkg" = gcc-pass2 ]; then
        mkdir -v build32
        cd build32

        if ! ../libstdc++-v3/configure \
            --build=x86_64-pc-linux-gnu \
            --host="$LFS_TGT" \
            --prefix="$TOOLS" \
            --libdir="$TOOLS/lib32" \
            --disable-multilib \
            --disable-nls \
            --disable-libstdcxx-threads \
            --disable-libstdcxx-pch \
            --with-gxx-include-dir="$TOOLS/$LFS_TGT/include/c++/$version" \
            CC="$LFS_TGT-gcc -m32" \
            CXX="$LFS_TGT-g++ -m32"
        then
            mkdir -p "$HOME/BFSOS/logs/toolchain"

            if [ -f config.log ]; then
                cp -f config.log \
                    "$HOME/BFSOS/logs/toolchain/gcc-pass2-build32-config.log"
                echo "Saved failed 32-bit libstdc++ config.log to:"
                echo "  $HOME/BFSOS/logs/toolchain/gcc-pass2-build32-config.log"
            fi

            return 1
        fi

        make
        make install

        cd ..

        mkdir -v build
        cd build

        ../libstdc++-v3/configure \
            --host="$LFS_TGT" \
            --prefix="$TOOLS" \
            --disable-multilib \
            --disable-nls \
            --disable-libstdcxx-threads \
            --disable-libstdcxx-pch \
            --with-gxx-include-dir="$TOOLS/$LFS_TGT/include/c++/$version"

        make
        make install

    elif [ "$tcpkg" = gcc-pass3 ]; then
        cat \
            gcc/limitx.h \
            gcc/glimits.h \
            gcc/limity.h \
            > "$(dirname "$("$LFS_TGT-gcc" -print-libgcc-file-name)")/include-fixed/limits.h"

        for file in \
            gcc/config/linux.h \
            gcc/config/i386/linux.h \
            gcc/config/i386/linux64.h
        do
            cp -uv "$file" "$file.orig"

            sed \
                -e "s@/lib\(64\)\?\(32\)\?/ld@$TOOLS&@g" \
                -e "s@/usr@$TOOLS@g" \
                "$file.orig" > "$file"

            {
                echo '#undef STANDARD_STARTFILE_PREFIX_1'
                echo '#undef STANDARD_STARTFILE_PREFIX_2'
                echo "#define STANDARD_STARTFILE_PREFIX_1 \"$TOOLS/lib/\""
                echo '#define STANDARD_STARTFILE_PREFIX_2 ""'
            } >> "$file"

            touch "$file.orig"
        done

        sed -i \
            's@/lib/ld-linux.so.2@/lib32/ld-linux.so.2@g' \
            gcc/config/i386/linux64.h

        sed -i \
            '/MULTILIB_OSDIRNAMES/d' \
            gcc/config/i386/t-linux64

        echo \
            'MULTILIB_OSDIRNAMES = m64=../lib m32=../lib32' \
            >> gcc/config/i386/t-linux64

        mkdir -v build
        cd build

        CC="$LFS_TGT-gcc" \
        CXX="$LFS_TGT-g++" \
        AR="$LFS_TGT-ar" \
        RANLIB="$LFS_TGT-ranlib" \
        ../configure \
            --with-gmp="$TOOLS" \
            --with-mpc="$TOOLS" \
            --with-mpfr="$TOOLS" \
            --prefix="$TOOLS" \
            --with-local-prefix="$TOOLS" \
            --with-native-system-header-dir="$TOOLS/include" \
            --enable-languages=c,c++ \
            --disable-libstdcxx-pch \
            --disable-bootstrap \
            --disable-libgomp \
            --with-multilib-list=m32,m64

        make
        make install

        ln -sf gcc "$TOOLS/bin/cc"
    fi
}
