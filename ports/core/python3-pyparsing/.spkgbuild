# description : Python parsing library used by SPICE build-time code generation
# homepage    : https://github.com/pyparsing/pyparsing
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3-build python3-installer python3-setuptools python3-wheel
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-pyparsing
version=3.3.3
release=1
source="https://files.pythonhosted.org/packages/source/p/pyparsing/pyparsing-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	python3 -m build --wheel --no-isolation || return 1
	python3 -m installer --destdir="$PKG" dist/*.whl || return 1
}
