# description : Poetry core utilities for Python packaging
# homepage    : https://github.com/python-poetry/poetry-core
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3-build python3-installer
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-poetry-core
version=2.5.0
release=2
source="https://files.pythonhosted.org/packages/source/p/poetry-core/poetry_core-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	python3 -m build \
	    --wheel \
	    --skip-dependency-check \
	    --no-isolation || return 1

	python3 -m installer \
	    --compile-bytecode 2 \
	    --destdir="$PKG" \
	    dist/*.whl || return 1
}
