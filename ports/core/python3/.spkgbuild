# description : python3
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3
version=3.14.7
release=1
build_opt="--without-ensurepip
	--enable-shared
	--with-system-expat
	--with-system-ffi
	--enable-optimizations
	--disable-test-modules
	--without-static-libpython"
bootstrap_opt="--without-ensurepip --disable-test-modules --without-static-libpython"
source="https://www.python.org/ftp/python/$version/Python-$version.tar.xz https://www.linuxfromscratch.org/patches/downloads/Python/Python-$version-openssl_4-1.patch pyconfig.h"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# bootstrap.sh calls bootstrap_build() with TOOLS pointing at the
	# toolchain root; a package build stages into $PKG instead.
	TOOLS="${TOOLS:-$PKG}"
	pre_build || return 1
	bootstrap_build || return 1
	post_build || return 1
}

pre_build() {
	# Remove tests
#	rm -rvf Lib/test Lib/*/test Lib/*/tests Lib/*/idle_test
  rm -r Modules/expat
}

post_build() {
	mv $PKG/usr/include/python${version%.*}/pyconfig.h \
	   $PKG/usr/include/python${version%.*}/pyconfig-64.h
	install -m 0644 $SRC/pyconfig.h $PKG/usr/include/python${version%.*}/
	ln -s python3 $PKG/usr/bin/python
}

bootstrap_build() {
cat > Modules/Setup.local <<-EOF 
*disabled*
readline 
_ctypes
_uuid
_blake2
_zstd
EOF
./configure --prefix=$TOOLS $bootstrap_opt
make
make install
}
