# description : binutils
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=binutils
version=2.47
release=1
source="https://sourceware.org/pub/binutils/releases/binutils-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	mkdir -v build
	cd       build

	../configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-gold \
		--enable-ld=default \
		--enable-lto \
		--enable-plugins \
		--enable-shared \
		--disable-werror \
		--with-system-zlib \
		--enable-multilib \
		--with-lib-path=/usr/lib:/lib:/usr/lib32
	make DESTDIR=$PKG tooldir=/usr
	make DESTDIR=$PKG tooldir=/usr install
}

bootstrap_build() {
	mkdir -v build
	cd       build
	
	if [ "$tcpkg" = binutils-pass1 ]; then
		../configure  \
			--prefix=$TOOLS \
			--with-sysroot=$LFS \
			--target=$LFS_TGT \
			--disable-nls \
			--disable-werror \
			--enable-gprofng=no \
			--enable-new-dtags \
			--enable-default-hash-style=gnu \
			--with-lib-path=$TOOLS/lib:$TOOLS/lib32
		make
		mkdir -v $TOOLS/lib && ln -sv lib $TOOLS/lib64
		mkdir -p $TOOLS/lib32
		make install
	elif [ "$tcpkg" = binutils-pass2 ]; then
		CC=$LFS_TGT-gcc \
		AR=$LFS_TGT-ar \
		RANLIB=$LFS_TGT-ranlib \
		../configure \
			--prefix=$TOOLS \
			--enable-shared \
			--disable-nls \
			--disable-werror \
			--enable-64-bit-bfd \
			--enable-new-dtags \
    			--enable-default-hash-style=gnu \
			--with-lib-path=$TOOLS/lib \
			--enable-gprofng=no \
			--with-sysroot
		make CFLAGS="-O2 -DPATH_MAX=4096" || make -j1
		make install
		make -C ld clean
		make -C ld LIB_PATH=/usr/lib:/lib:/usr/lib32
		cp -v ld/ld-new $TOOLS/bin
	fi
}
