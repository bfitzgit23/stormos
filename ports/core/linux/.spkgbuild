# description : Optional BFSOS current/mainline Linux kernel, sources and modules
# homepage    : https://cdn.kernel.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : bc bfs-kernel-maintenance bison cpio dracut elfutils flex linux-firmware openssl zstd
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=linux
version=7.2.8
release=1
source="https://www.kernel.org/pub/linux/kernel/v7.x/linux-$version.tar.xz config"
options="!strip"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	local kernver=""

	make mrproper

	cp "$SRC/config" .config
	make olddefconfig

	# BFS kernel identity.
	scripts/config --set-str LOCALVERSION "-BFS-Linux"
	scripts/config --disable LOCALVERSION_AUTO

	# LFS-required and recommended settings.
	scripts/config --disable WERROR
	scripts/config --enable PSI
	scripts/config --disable PSI_DEFAULT_DISABLED
	scripts/config --disable IKHEADERS

	# BFSOS kernel compression policy: prefer Zstandard for the kernel and
	# installed modules. Dracut already uses compress="zstd".
	scripts/config --enable KERNEL_ZSTD
	scripts/config --disable KERNEL_GZIP
	scripts/config --enable MODULE_COMPRESS
	scripts/config --enable MODULE_COMPRESS_ZSTD
	scripts/config --enable MODULE_COMPRESS_ALL
	scripts/config --disable MODULE_COMPRESS_GZIP
	scripts/config --disable MODULE_COMPRESS_XZ

	scripts/config --enable CGROUPS
	scripts/config --enable MEMCG
	scripts/config --enable CGROUP_SCHED
	scripts/config --disable RT_GROUP_SCHED
	scripts/config --disable EXPERT

	scripts/config --enable RELOCATABLE
	scripts/config --enable RANDOMIZE_BASE

	scripts/config --enable STACKPROTECTOR
	scripts/config --enable STACKPROTECTOR_STRONG

	scripts/config --enable NET
	scripts/config --enable INET
	scripts/config --enable IPV6

	scripts/config --disable UEVENT_HELPER
	scripts/config --enable DEVTMPFS
	scripts/config --enable DEVTMPFS_MOUNT
	scripts/config --disable FW_LOADER_USER_HELPER

	scripts/config --enable DMIID
	scripts/config --enable SYSFB_SIMPLEFB

	# Keep the known-good BFSOS early-console path built in.  These are
	# explicit so future Kconfig reconciliation cannot silently turn a
	# boot-visible console dependency into a module or disable it.
	scripts/config --enable VT
	scripts/config --enable VT_CONSOLE
	scripts/config --enable SERIAL_8250
	scripts/config --enable SERIAL_8250_CONSOLE
	scripts/config --enable AGP
	scripts/config --enable FB
	scripts/config --enable DRM
	scripts/config --enable DRM_PANIC
	scripts/config --enable DRM_FBDEV_EMULATION
	scripts/config --enable DRM_SIMPLEDRM
	scripts/config --enable FRAMEBUFFER_CONSOLE

	# Hybrid laptop GPU stack — Raptor Lake iGPU + Blackwell dGPU (Gigabyte Gaming A16 CVH).
	# Keep i915/xe/nouveau as modules so GuC/HuC/DMC and (on GB206) GSP firmware load
	# from the initramfs instead of racing a built-in probe before /lib/firmware is
	# visible. DRM_ACCEL_IVPU is the Raptor Lake VPU; PCI_PWRCTRL powers the ACPI handle
	# for the dGPU; MEI GSC/PXP/CSC/VSC provides the GSC channel HuC needs.
	scripts/config --module DRM_I915
	scripts/config --module DRM_XE
	scripts/config --enable DRM_XE_DISPLAY
	scripts/config --module DRM_NOUVEAU
	scripts/config --enable DRM_NOUVEAU_BACKLIGHT
	scripts/config --enable DRM_ACCEL
	scripts/config --module DRM_ACCEL_IVPU
	scripts/config --module PCI_PWRCTRL
	scripts/config --module PCI_PWRCTRL_GENERIC
	scripts/config --module PCI_PWRCTRL_TC9563
	scripts/config --module INTEL_MEI_GSC
	scripts/config --module INTEL_MEI_GSC_PROXY
	scripts/config --module INTEL_MEI_CSC
	scripts/config --module INTEL_MEI_VSC
	scripts/config --module INTEL_MEI_PXP
	scripts/config --module INTEL_MEI_HDCP
	scripts/config --module INTEL_PMC_CORE
	scripts/config --module INTEL_PMT_CLASS
	scripts/config --module INTEL_PMT_TELEMETRY
	scripts/config --module INTEL_PMT_CRASHLOG
	scripts/config --module INTEL_PMT_DISCOVERY
	scripts/config --module INTEL_VSEC
	scripts/config --module THUNDERBOLT
	scripts/config --module USB4

	scripts/config --enable INOTIFY_USER
	scripts/config --enable TMPFS
	scripts/config --enable TMPFS_POSIX_ACL

	scripts/config --enable PCI
	scripts/config --enable PCI_MSI
	scripts/config --enable IOMMU_SUPPORT
	scripts/config --enable IRQ_REMAP
	scripts/config --enable X86_X2APIC

	scripts/config --enable IA32_EMULATION
	scripts/config --disable IA32_EMULATION_DEFAULT_DISABLED

	# Boot and storage support.
	scripts/config --enable BLK_DEV_INITRD
	scripts/config --enable BLK_DEV_NVME
	scripts/config --enable SCSI
	scripts/config --enable BLK_DEV_SD
	scripts/config --enable ATA
	scripts/config --enable SATA_AHCI

	scripts/config --enable EXT4_FS
	scripts/config --enable XFS_FS
	scripts/config --enable BTRFS_FS
	scripts/config --enable F2FS_FS

	# UEFI support.
	scripts/config --enable EFI
	scripts/config --enable EFI_STUB
	scripts/config --enable EFI_PARTITION
	scripts/config --enable VFAT_FS
	scripts/config --enable EFIVAR_FS
	scripts/config --enable NLS
	scripts/config --enable NLS_CODEPAGE_437
	scripts/config --enable NLS_ISO8859_1

	# Storage stack used by the BFS installer.
	#
	# Keep the MD core enabled, with the actual RAID personalities as modules.
	# Keep MD personalities modular. BFSOS installs a Dracut policy that
	# force-includes every installer-supported personality in each initramfs,
	# avoiding fragile host-only auto-detection.
	scripts/config --enable MD
	scripts/config --module MD_LINEAR
	scripts/config --module MD_RAID0
	scripts/config --module MD_RAID1
	scripts/config --module MD_RAID10
	scripts/config --module MD_RAID456

	# Device Mapper / LVM.
	scripts/config --module BLK_DEV_DM
	scripts/config --module DM_SNAPSHOT
	scripts/config --module DM_THIN_PROVISIONING
	scripts/config --module DM_CACHE
	scripts/config --module DM_WRITECACHE
	scripts/config --module DM_MIRROR
	scripts/config --module DM_RAID
	scripts/config --module DM_MULTIPATH
	scripts/config --module DM_DELAY
	scripts/config --module DM_ZERO

	# LUKS / encrypted and authenticated block-device support.
	scripts/config --module DM_CRYPT
	scripts/config --module DM_INTEGRITY

	# Useful integrity/verified-root targets. These do not force their use;
	# they simply guarantee that kernels built by this port can support them.
	scripts/config --module DM_VERITY

	make olddefconfig

	# Do not silently ship another kernel without the storage features the
	# installer exposes.
	grep -q '^CONFIG_MD=y$' .config || {
	    echo "Kernel configuration error: CONFIG_MD was not enabled." >&2
	    return 1
	}
	grep -q '^CONFIG_BLK_DEV_DM=m$' .config || {
	    echo "Kernel configuration error: CONFIG_BLK_DEV_DM was not built as a module." >&2
	    return 1
	}
	grep -q '^CONFIG_DM_CRYPT=m$' .config || {
	    echo "Kernel configuration error: CONFIG_DM_CRYPT was not built as a module." >&2
	    return 1
	}
	for console_option in VT VT_CONSOLE SERIAL_8250 SERIAL_8250_CONSOLE AGP FB DRM DRM_SIMPLEDRM FRAMEBUFFER_CONSOLE; do
	    grep -q "^CONFIG_${console_option}=y$" .config || {
	        echo "Kernel configuration error: CONFIG_${console_option} is not built in." >&2
	        return 1
	    }
	done
	# Hybrid GPU stack must survive Kconfig reconciliation: i915/xe/nouveau as
	# modules, XE display + IVPU enabled, PCI power control and MEI GSC present.
	for hybrid_mod in DRM_I915 DRM_XE DRM_NOUVEAU PCI_PWRCTRL PCI_PWRCTRL_GENERIC PCI_PWRCTRL_TC9563 INTEL_MEI_GSC INTEL_MEI_GSC_PROXY INTEL_MEI_CSC INTEL_MEI_VSC INTEL_MEI_PXP INTEL_MEI_HDCP INTEL_PMC_CORE INTEL_PMT_CLASS INTEL_PMT_TELEMETRY INTEL_PMT_CRASHLOG INTEL_PMT_DISCOVERY THUNDERBOLT USB4 DRM_ACCEL_IVPU INTEL_VSEC; do
	    grep -q "^CONFIG_${hybrid_mod}=m$" .config || {
	        echo "Kernel configuration error: CONFIG_${hybrid_mod} is not modular (hybrid GPU)." >&2
	        return 1
	    }
	done
	for hybrid_y in DRM_XE_DISPLAY DRM_NOUVEAU_BACKLIGHT DRM_ACCEL; do
	    grep -q "^CONFIG_${hybrid_y}=y$" .config || {
	        echo "Kernel configuration error: CONFIG_${hybrid_y} is not enabled (hybrid GPU)." >&2
	        return 1
	    }
	done
	for md_option in MD_LINEAR MD_RAID0 MD_RAID1 MD_RAID10 MD_RAID456; do
	    grep -q "^CONFIG_${md_option}=m$" .config || {
	        echo "Kernel configuration error: CONFIG_${md_option} was not built as a module." >&2
	        return 1
	    }
	done

	# Refuse to package a kernel unless the final Kconfig state will make
	# modules_install compress every installed module with Zstandard.
	for sym in KERNEL_ZSTD MODULE_COMPRESS MODULE_COMPRESS_ZSTD MODULE_COMPRESS_ALL; do
	    grep -q "^CONFIG_${sym}=y$" .config || {
	        echo "Kernel configuration error: CONFIG_${sym} is not enabled." >&2
	        return 1
	    }
	done
	for sym in KERNEL_GZIP MODULE_COMPRESS_GZIP MODULE_COMPRESS_XZ; do
	    grep -q "^# CONFIG_${sym} is not set$" .config || {
	        echo "Kernel configuration error: CONFIG_${sym} is not disabled." >&2
	        return 1
	    }
	done

	kernver="$(make -s kernelrelease)"

	case "$kernver" in
	    *-BFS-Linux) ;;
	    *)
	        echo "Unexpected kernel release: $kernver" >&2
	        return 1
	        ;;
	esac

	echo "Building kernel release: $kernver"

	make bzImage modules
	make INSTALL_MOD_PATH="$PKG" modules_install

	if [ ! -d "$PKG/lib/modules/$kernver" ]; then
	    echo "Kernel packaging error: modules_install did not create $PKG/lib/modules/$kernver" >&2
	    find "$PKG/lib/modules" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null >&2 || true
	    return 1
	fi

	# MODULE_COMPRESS_ALL must leave no raw .ko files behind and must produce
	# Zstandard-compressed .ko.zst modules. Fail here instead of shipping a
	# kernel package that silently regressed to uncompressed/XZ modules.
	if find "$PKG/lib/modules/$kernver" -type f -name '*.ko' -print -quit | grep -q .; then
	    echo "Kernel packaging error: uncompressed .ko modules remain after modules_install." >&2
	    find "$PKG/lib/modules/$kernver" -type f -name '*.ko' -print >&2
	    return 1
	fi
	if find "$PKG/lib/modules/$kernver" -type f \( -name '*.ko.gz' -o -name '*.ko.xz' \) -print -quit | grep -q .; then
	    echo "Kernel packaging error: non-Zstandard compressed modules were installed." >&2
	    find "$PKG/lib/modules/$kernver" -type f \( -name '*.ko.gz' -o -name '*.ko.xz' \) -print >&2
	    return 1
	fi
	if ! find "$PKG/lib/modules/$kernver" -type f -name '*.ko.zst' -print -quit | grep -q .; then
	    echo "Kernel packaging error: no Zstandard-compressed .ko.zst modules were installed." >&2
	    return 1
	fi

	install -Dm644 arch/x86/boot/bzImage \
	    "$PKG/boot/vmlinuz-$kernver"

	install -Dm644 System.map \
	    "$PKG/boot/System.map-$kernver"

	install -Dm644 .config \
	    "$PKG/boot/config-$kernver"

	# Distribution Dracut policy: md personalities remain modular, but every
	# BFSOS initramfs must contain the storage personalities exposed by the
	# installer so host-only detection cannot silently omit them.

	rm -rf "$PKG/lib/firmware"

	make clean
	make prepare scripts

	install -d "$PKG/usr/src"
	mv "$SRC/$name-$version" \
	    "$PKG/usr/src/linux-$kernver"

	rm -f \
	    "$PKG/lib/modules/$kernver/build" \
	    "$PKG/lib/modules/$kernver/source"

	ln -s "/usr/src/linux-$kernver" \
	    "$PKG/lib/modules/$kernver/build"

	ln -s "/usr/src/linux-$kernver" \
	    "$PKG/lib/modules/$kernver/source"

	find -L "$PKG/usr/src/linux-$kernver" \
	    -type l \
	    -delete 2>/dev/null || true
}
