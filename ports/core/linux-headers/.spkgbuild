# description : Linux userspace API headers from the BFSOS default LTS kernel line
# homepage    : https://www.kernel.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=linux-headers
version=6.18.54
release=1
source="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	make mrproper
	make headers
	find usr/include -type f ! -name '*.h' -delete
	mkdir -p $PKG/usr/include
	cp -rv usr/include/* $PKG/usr/include
}

bootstrap_build() {
	make mrproper
	make headers
	find usr/include -type f ! -name '*.h' -delete
	mkdir -p $TOOLS/include
	cp -rv usr/include/* $TOOLS/include
}
