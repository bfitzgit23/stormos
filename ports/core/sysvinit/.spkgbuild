# description : System V init and shutdown utilities
# homepage    : https://github.com/slicer69/sysvinit
# maintainer  : BFSOS maintainers
# depends     : filesystem
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=sysvinit
version=3.15
release=2
source="https://github.com/slicer69/sysvinit/archive/refs/tags/$version.tar.gz inittab"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cd "$name-$version" || return 1
	make -C src || return 1
	make -C src DESTDIR="$PKG" install || return 1

	install -d -m 0755 "$PKG/etc/inittab.d" "$PKG/etc/rc.d"
	ln -sfn /usr/lib/sysvinit/init "$PKG/sbin/init"

	# Ship a working default inittab (runlevels, console logins, commented
	# dm line); admins edit it directly as directed by the LFS book.
	install -m 0644 inittab "$PKG/etc/inittab" || return 1
}
