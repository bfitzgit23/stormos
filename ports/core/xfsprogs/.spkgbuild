# description : xfsprogs
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xfsprogs
version=7.2.0
release=1
source="https://www.kernel.org/pub/linux/utils/fs/xfs/xfsprogs/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	make configure

	export DEBUG=-DNDEBUG
	export OPTIMIZER="$CFLAGS"

	./configure \
	    --prefix=/usr \
	    --localstatedir=/var \
	    --libexecdir=/usr/lib \
	    --disable-gettext \
	    --disable-libicu

	make
	make -j1 DIST_ROOT="$PKG" install install-dev

	install -d "$PKG/sbin"

	mv "$PKG/usr/sbin/fsck.xfs" "$PKG/sbin/"
	mv "$PKG/usr/sbin/xfs_repair" "$PKG/sbin/"

	rm -rf "$PKG/usr/share/doc"

}
