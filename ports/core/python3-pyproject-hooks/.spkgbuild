# description : A low-level library for calling build-backends in pyproject.toml-based project
# homepage    : https://github.com/pypa/pyproject-hooks
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3-tomli
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-pyproject-hooks
version=1.3.3
release=1
source="https://files.pythonhosted.org/packages/source/p/pyproject_hooks/pyproject_hooks-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	/usr/bin/pip3 install --isolate --root=$PKG --ignore-installed --no-deps .
}
