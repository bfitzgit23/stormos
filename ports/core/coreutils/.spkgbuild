# description : coreutils
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=coreutils
version=9.12
release=1
build_opt="--enable-no-install-program=kill,uptime"
source="https://ftp.gnu.org/gnu/coreutils/coreutils-$version.tar.xz https://www.linuxfromscratch.org/patches/downloads/coreutils/coreutils-9.11-i18n-1.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# bootstrap.sh calls bootstrap_build() with TOOLS pointing at the
	# toolchain root; a package build stages into $PKG instead.
	TOOLS="${TOOLS:-$PKG}"
	bootstrap_build || return 1
	post_build || return 1
}

post_build() {
	mkdir -p $PKG/bin
	for i in cat chgrp chmod chown cp date dd df echo \
		false ln ls mkdir mknod mv pwd rm rmdir stty sync true uname; do
		mv $PKG/usr/bin/$i $PKG/bin
	done
	mkdir -p $PKG/usr/sbin
	mv $PKG/usr/bin/chroot $PKG/usr/sbin
	mkdir -p $PKG/usr/share/man/man8/
	mv -v $PKG/usr/share/man/man1/chroot.1 $PKG/usr/share/man/man8/chroot.8
	sed -i s/\"1\"/\"8\"/1 $PKG/usr/share/man/man8/chroot.8
}

bootstrap_build() {
	FORCE_UNSAFE_CONFIGURE=1 ./configure --prefix=$TOOLS --enable-install-program=hostname
	make
	make install
}
