# description : WPA/WPA2/WPA3 supplicant and IEEE 802.1X client
# homepage    : https://w1.fi/wpa_supplicant/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libnl openssl dbus libxml2 wireless-regdb
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=wpa_supplicant
version=2.12
release=6
source="https://w1.fi/releases/wpa_supplicant-$version.tar.gz wpa_supplicant.conf"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cat > wpa_supplicant/.config <<'EOF'
CONFIG_BACKEND=file
CONFIG_CTRL_IFACE=y
CONFIG_DEBUG_FILE=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WEXT=y
CONFIG_DRIVER_WIRED=y
CONFIG_EAP_GTC=y
CONFIG_EAP_LEAP=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_OTP=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TTLS=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_IPV6=y
CONFIG_LIBNL32=y
CONFIG_PEERKEY=y
CONFIG_PKCS12=y
CONFIG_READLINE=y
CONFIG_SMARTCARD=y
CONFIG_WPS=y
CFLAGS += -I/usr/include/libnl3
CONFIG_CTRL_IFACE_DBUS=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_CTRL_IFACE_DBUS_INTRO=y
EOF

	cd wpa_supplicant || return 1

	make -j "${JOBS:-1}" BINDIR=/usr/sbin LIBDIR=/usr/lib || return 1

	install -Dm755 wpa_cli "$PKG/usr/sbin/wpa_cli" || return 1
	install -Dm755 wpa_passphrase "$PKG/usr/sbin/wpa_passphrase" || return 1
	install -Dm755 wpa_supplicant "$PKG/usr/sbin/wpa_supplicant" || return 1

	install -d "$PKG/usr/share/man/man5" "$PKG/usr/share/man/man8" || return 1
	install -m644 doc/docbook/wpa_supplicant.conf.5 "$PKG/usr/share/man/man5/" || return 1
	install -m644 doc/docbook/wpa_cli.8 doc/docbook/wpa_passphrase.8 \
	    doc/docbook/wpa_supplicant.8 "$PKG/usr/share/man/man8/" || return 1

	install -Dm600 "$SRC/wpa_supplicant.conf" "$PKG/etc/wpa_supplicant.conf" || return 1

	install -d "$PKG/usr/lib/systemd/system" || return 1
	install -m644 systemd/*.service "$PKG/usr/lib/systemd/system/" || return 1

	install -d "$PKG/usr/share/dbus-1/system-services" "$PKG/etc/dbus-1/system.d" || return 1
	install -m644 dbus/fi.w1.wpa_supplicant1.service \
	    "$PKG/usr/share/dbus-1/system-services/" || return 1
	install -m644 dbus/dbus-wpa_supplicant.conf \
	    "$PKG/etc/dbus-1/system.d/wpa_supplicant.conf" || return 1

	install -d "$PKG/etc/sysconfig" || return 1
	cat > "$PKG/etc/sysconfig/ifconfig.wifi0" <<'EOF'
ONBOOT="no"
IFACE="wlan0"
SERVICE="wpa"

# Additional arguments to wpa_supplicant
WPA_ARGS=""

WPA_SERVICE="dhcpcd"
#DHCP_START="-b -q <insert appropriate start options here>"
#DHCP_STOP="-k <insert additional stop options here>"
EOF
}
