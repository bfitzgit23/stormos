# description : Password and account management utilities
# homepage    : https://github.com/shadow-maint/shadow
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libpwquality libxcrypt linux-pam
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=shadow
version=4.20.2
release=2
source="https://github.com/$name-maint/$name/releases/download/$version/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	./configure \
	    --prefix=/usr \
	    --sysconfdir=/etc \
	    --disable-static \
	    --with-libpam \
	    --without-libbsd \
	    --with-bcrypt \
	    --with-yescrypt \
	    --with-group-name-max-length=32 \
	    --disable-logind || return 1

	make || return 1

	# Do not package Shadow's upstream PAM policy; BFSOS owns its PAM policy.
	make \
	    DESTDIR="$PKG" \
	    exec_prefix=/usr \
	    pamddir= \
	    install || return 1
	post_build || return 1
}

pre_build() {
    sed -i 's/groups$(EXEEXT) //' src/Makefile.in || return 1

    find man -name Makefile.in \
        -exec sed -i 's/groups\.1 / /' {} \; || return 1

    find man -name Makefile.in \
        -exec sed -i 's/getspnam\.3 / /' {} \; || return 1

    find man -name Makefile.in \
        -exec sed -i 's/passwd\.5 / /' {} \; || return 1

    sed \
        -e 's@#ENCRYPT_METHOD DES@ENCRYPT_METHOD YESCRYPT@' \
        -e 's@/var/spool/mail@/var/mail@' \
        -e '/PATH=/{s@/sbin:@@;s@/bin:@@}' \
        -i etc/login.defs || return 1

    # Current BLFS compatibility fix for Shadow 4.20.2.
    sed -i '/stdio.h/i #include <stdint.h>' lib/find_new_sub_*ids.c || return 1

    # These functions are now handled by PAM modules, not login.defs.
    for FUNCTION in \
        FAIL_DELAY FAILLOG_ENAB LASTLOG_ENAB MAIL_CHECK_ENAB \
        OBSCURE_CHECKS_ENAB PORTTIME_CHECKS_ENAB QUOTAS_ENAB \
        CONSOLE MOTD_FILE FTMP_FILE NOLOGINS_FILE ENV_HZ PASS_MIN_LEN \
        SU_WHEEL_ONLY PASS_CHANGE_TRIES PASS_ALWAYS_WARN CHFN_AUTH \
        ENCRYPT_METHOD ENVIRON_FILE
    do
        sed -i "s/^${FUNCTION}/# &/" etc/login.defs || return 1
    done
}

post_build() {
    local pam_dir="$PKG/etc/pam.d"

    install -d -m 0755 "$pam_dir"

    cat > "$pam_dir/login" <<'EOF'
# Begin /etc/pam.d/login

# Set failure delay before next prompt to 3 seconds
auth      optional    pam_faildelay.so delay=3000000

# Check to make sure that the user is allowed to login
auth      requisite   pam_nologin.so

# Check to make sure that root is allowed to login
# Disabled by default. You will need to create /etc/securetty
# for this module to function.
#auth     required    pam_securetty.so

# Additional group memberships - disabled by default
#auth     optional    pam_group.so

# Include system authentication settings
auth      include     system-auth

# Check access for the user
account   required    pam_access.so

# Include system account settings
account   include     system-account

# Set default environment variables for the user
session   required    pam_env.so

# Set resource limits for the user
session   required    pam_limits.so

# Display the message of the day - disabled by default
#session  optional    pam_motd.so

# Check user's mail - disabled by default
#session  optional    pam_mail.so standard quiet

# Include system session and password settings
session   include     system-session
password  include     system-password

# End /etc/pam.d/login
EOF

    cat > "$pam_dir/passwd" <<'EOF'
# Begin /etc/pam.d/passwd

password  include     system-password

# End /etc/pam.d/passwd
EOF

    cat > "$pam_dir/su" <<'EOF'
# Begin /etc/pam.d/su

# Always allow root
auth      sufficient  pam_rootok.so

# Allow users in the wheel group to execute su without a password
# Disabled by default
#auth     sufficient  pam_wheel.so trust use_uid

# Include system authentication settings
auth      include     system-auth

# Limit su to users in the wheel group
# Disabled by default
#auth     required    pam_wheel.so use_uid

# Include system account settings
account   include     system-account

# Set default environment variables for the service user
session   required    pam_env.so

# Include system session settings
session   include     system-session

# End /etc/pam.d/su
EOF

    cat > "$pam_dir/chpasswd" <<'EOF'
# Begin /etc/pam.d/chpasswd

# Always allow root
auth      sufficient  pam_rootok.so

# Include system authentication and account settings
auth      include     system-auth
account   include     system-account
password  include     system-password

# End /etc/pam.d/chpasswd
EOF

    sed 's/chpasswd/newusers/g' \
        "$pam_dir/chpasswd" > "$pam_dir/newusers"

    cat > "$pam_dir/chage" <<'EOF'
# Begin /etc/pam.d/chage

# Always allow root
auth      sufficient  pam_rootok.so

# Include system authentication and account settings
auth      include     system-auth
account   include     system-account

# End /etc/pam.d/chage
EOF

    for program in \
        chfn \
        chgpasswd \
        chsh \
        groupadd \
        groupdel \
        groupmems \
        groupmod \
        useradd \
        userdel \
        usermod
    do
        sed "s/chage/$program/g" \
            "$pam_dir/chage" > "$pam_dir/$program"

        chmod 0644 "$pam_dir/$program"
    done

    chmod 0644 \
        "$pam_dir/login" \
        "$pam_dir/passwd" \
        "$pam_dir/su" \
        "$pam_dir/chpasswd" \
        "$pam_dir/newusers" \
        "$pam_dir/chage"

    if [ -f "$PKG/etc/login.access" ]; then
        mv "$PKG/etc/login.access" \
           "$PKG/etc/login.access.NOUSE"
    fi

    if [ -f "$PKG/etc/limits" ]; then
        mv "$PKG/etc/limits" \
           "$PKG/etc/limits.NOUSE"
    fi
}
