# description : Password-strength checking library and dictionary
# homepage    : https://github.com/cracklib/cracklib
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : autoconf automake libtool python3 xz
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=cracklib
version=2.10.3
release=3
source="https://github.com/cracklib/cracklib/releases/download/v$version/cracklib-$version.tar.xz https://github.com/cracklib/cracklib/releases/download/v$version/cracklib-words-$version.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	autoreconf -fiv || return 1

	CPPFLAGS="${CPPFLAGS} $(python3-config --includes)" \
	PYTHON=python3 \
	./configure \
	    --prefix=/usr \
	    --disable-static \
	    --with-default-dict=/usr/lib/cracklib/pw_dict || return 1

	make || return 1
	make DESTDIR="$PKG" install || return 1

	install -d "$PKG/usr/share/dict" "$PKG/usr/lib/cracklib" || return 1

	xzcat "$SRC/cracklib-words-$version.xz" \
	    > "$PKG/usr/share/dict/cracklib-words" || return 1

	ln -sfn cracklib-words "$PKG/usr/share/dict/words" || return 1

	# Keep the site-specific dictionary deterministic in the package.
	# Administrators can append local words after installation and regenerate it.
	printf '%s\n' bfs bfsos \
	    > "$PKG/usr/share/dict/cracklib-extra-words" || return 1

	# Build the CrackLib database directly into the package staging tree.
	# Using the in-tree utilities avoids create-cracklib-dict writing to the
	# live host's /usr/lib/cracklib during package creation.
	./util/cracklib-format \
	    "$PKG/usr/share/dict/cracklib-words" \
	    "$PKG/usr/share/dict/cracklib-extra-words" |
	    ./util/cracklib-packer "$PKG/usr/lib/cracklib/pw_dict" || return 1

	test -s "$PKG/usr/lib/cracklib/pw_dict.pwd" || {
	    echo "cracklib: staged pw_dict database was not created" >&2
	    return 1
	}
}
