# description : Utilities to access MS-DOS disks without mounting them
# homepage    : https://www.gnu.org/software/mtools/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=mtools
version=4.0.49
release=2
source="https://ftp.gnu.org/gnu/mtools/$name-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-floppyd
	make
	sed -i Makefile -e 's|install-scripts install-info|install-scripts|'
	make -j1 DESTDIR="$PKG" prefix=/usr install
}
