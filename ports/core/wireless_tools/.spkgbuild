# description : Legacy Linux Wireless Extensions configuration utilities
# homepage    : https://hewlettpackard.github.io/wireless-tools/Tools.html
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=wireless_tools
version=30.pre9
release=4
source="https://deb.debian.org/debian/pool/main/w/wireless-tools/wireless-tools_30~pre9.orig.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	build_opt

	install -d "$PKG/usr/sbin"

	install -m755 \
	    iwconfig \
	    iwlist \
	    iwpriv \
	    iwspy \
	    iwgetid \
	    iwevent \
	    ifrename \
	    "$PKG/usr/sbin/"

	install -d "$PKG/usr/include"

	install -m644 \
	    iwlib.h \
	    wireless.h \
	    "$PKG/usr/include/"

	install -d \
	    "$PKG/usr/share/man/man5" \
	    "$PKG/usr/share/man/man7" \
	    "$PKG/usr/share/man/man8"

	install -m644 \
	    iftab.5 \
	    "$PKG/usr/share/man/man5/"

	install -m644 \
	    wireless.7 \
	    "$PKG/usr/share/man/man7/"

	install -m644 \
	    iwconfig.8 \
	    iwlist.8 \
	    iwpriv.8 \
	    iwspy.8 \
	    iwgetid.8 \
	    iwevent.8 \
	    ifrename.8 \
	    "$PKG/usr/share/man/man8/"
}
