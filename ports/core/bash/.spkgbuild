# description : bash
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=bash
version=5.3
release=1
build_opt="--prefix=/usr
            --without-bash-malloc
            --with-installed-readline
            --docdir=/usr/share/doc/$name-$version"
source="https://ftp.gnu.org/gnu/bash/bash-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# bootstrap.sh calls bootstrap_build() with TOOLS pointing at the
	# toolchain root; a package build stages into $PKG instead.
	TOOLS="${TOOLS:-$PKG}"
	bootstrap_build || return 1
	post_build || return 1
}

post_build() {
	mkdir -p $PKG/bin
	mv $PKG/usr/bin/bash $PKG/bin
	
#	install -d $PKG/etc
#	install -m644 $SRC/bashrc $PKG/etc
#	install -m644 $SRC/profile $PKG/etc
}

bootstrap_build() {
	./configure --prefix=$TOOLS --without-bash-malloc bash_cv_strtold_broken=no
	make -j1
	make install
	ln -sv bash $TOOLS/bin/sh
}
