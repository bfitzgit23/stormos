# description : prt-get
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=prt-get
version=5.19.10
release=3
source="https://crux.nu/files/prt-get-$version.tar.xz prt-get.conf prt-get.aliases bfsos.git README"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
    install -m 644 "$SRC"/prt-get.{conf,aliases} "$PKG/etc/" || return 1
    install -d "$PKG/var/lib/pkg" "$PKG/etc/ports" "$PKG/var/log/pkgbuild" || return 1
    install -m 644 "$SRC/bfsos.git" "$PKG/etc/ports/bfsos.git" || return 1
    touch "$PKG/var/lib/pkg/prt-get.locker" || return 1

    # sysup can contain a pkgutils update plus packages whose recipes require
    # the new pkgmk extension.  Always let the real prt-get bring pkgutils
    # current first, then calculate/execute the remaining sysup transaction.
    install -d "$PKG/usr/libexec" || return 1
    mv "$PKG/usr/bin/prt-get" "$PKG/usr/libexec/prt-get.real" || return 1
    cat > "$PKG/usr/bin/prt-get" <<'EOF_WRAPPER'
#!/bin/sh
set -eu

real=/usr/libexec/prt-get.real
want_sysup=no
want_update=no
test_mode=no
no_new_deps=no
help_requested=no
collect_update_targets=no
update_targets=""
filtered_args=""

# --no-new-deps is a BFSOS front-end option; remove it before invoking the
# upstream prt-get binary so upstream does not see an unknown option.
for arg in "$@"; do
    case "$arg" in
        --no-new-deps)
            no_new_deps=yes
            continue
            ;;
        --help|-h)
            help_requested=yes
            ;;
    esac
    filtered_args="${filtered_args}${arg}
"
done

# Rebuild positional parameters without word-splitting spaces inside an
# argument.  prt-get package names/options cannot contain literal newlines.
old_ifs=$IFS
IFS='
'
set -f
# shellcheck disable=SC2086
set -- $filtered_args
set +f
IFS=$old_ifs

for arg in "$@"; do
    case "$arg" in
        --test|-t) test_mode=yes ;;
        sysup)
            want_sysup=yes
            collect_update_targets=no
            ;;
        update)
            want_update=yes
            collect_update_targets=yes
            continue
            ;;
        depinst|install|remove|search|info|listinst|quickdiff|quickdep|isinst)
            # If another command token follows an earlier accidental "update"
            # token, do not keep harvesting arbitrary arguments as packages.
            [ "$want_update" = yes ] || collect_update_targets=no
            ;;
    esac

    if [ "$collect_update_targets" = yes ]; then
        case "$arg" in
            -*) ;;
            *)
                # Only retain real port names. This avoids mistaking an option
                # value for an update target.
                if "$real" info "$arg" >/dev/null 2>&1; then
                    update_targets="$update_targets $arg"
                fi
                ;;
        esac
    fi
done

print_bfsos_help() {
    cat <<'EOF_HELP'

BFSOS update options:
  --no-new-deps    For update/sysup only, detect and report newly required
                   dependencies but do not install them automatically.
                   Explicit dependency commands such as depinst are unchanged.

Examples:
  prt-get update --no-new-deps <package>
  prt-get sysup --no-new-deps
EOF_HELP
}

if [ "$help_requested" = yes ]; then
    status=0
    "$real" "$@" || status=$?
    print_bfsos_help
    exit "$status"
fi

bfs_missing_deps() {
    [ "$#" -gt 0 ] || return 0

    closure=$("$real" quickdep "$@" 2>/dev/null || true)
    [ -n "$closure" ] || return 0

    # CRUX documents this exact isinst/quickdep mechanism for discovering
    # dependencies added after a package was originally installed.
    # shellcheck disable=SC2086
    "$real" isinst $closure 2>/dev/null | awk '/not installed/ {print $2}'
}

bfs_refresh_new_deps() {
    label=$1
    shift
    [ "$#" -gt 0 ] || return 0

    missing=$(bfs_missing_deps "$@")
    [ -n "$missing" ] || return 0

    echo "BFSOS dependency refresh ($label): newly required packages:"
    # shellcheck disable=SC2086
    printf '  %s\n' $missing

    if [ "$no_new_deps" = yes ]; then
        echo "WARNING: automatic installation of newly required dependencies is disabled for this transaction." >&2
        echo "BFSOS dependency refresh: intentionally skipped new dependencies:" >&2
        # shellcheck disable=SC2086
        printf '  %s\n' $missing >&2
        return 0
    fi

    if [ "$test_mode" = yes ]; then
        echo "BFSOS dependency refresh: test mode; dependencies were not installed"
        return 0
    fi

    # depinst preserves normal prt-get recursion/alias behavior. Only the
    # missing closure is supplied, so already-installed dependencies are not
    # rebuilt merely because an updated package gained a new hard dependency.
    # shellcheck disable=SC2086
    "$real" depinst $missing
}

if [ "$no_new_deps" = yes ] && [ "$want_sysup" = no ] && [ "$want_update" = no ]; then
    echo "WARNING: --no-new-deps only affects update and sysup; this command is unchanged." >&2
fi

if [ "$want_sysup" = yes ]; then
    outdated=$("$real" quickdiff 2>/dev/null || true)

    # Keep package-management tooling first *when it is actually stale*.  The
    # previous unconditional update rebuilt/reinstalled pkgutils on every sysup.
    if [ "$test_mode" = no ] && printf '%s\n' "$outdated" | grep -qx 'pkgutils'; then
        echo "BFSOS sysup preflight: pkgutils is stale; updating package-management tooling first"
        "$real" update pkgutils || {
            status=$?
            echo "BFSOS sysup preflight: pkgutils update failed (status $status); sysup aborted" >&2
            exit "$status"
        }
        # Re-evaluate after the tooling update so dependency closure and sysup
        # operate on the current package database.
        outdated=$("$real" quickdiff 2>/dev/null || true)
    fi
    if [ -n "$outdated" ]; then
        # shellcheck disable=SC2086
        bfs_refresh_new_deps sysup $outdated
    fi
elif [ "$want_update" = yes ] && [ -n "$update_targets" ]; then
    # shellcheck disable=SC2086
    bfs_refresh_new_deps update $update_targets
fi

exec "$real" "$@"
EOF_WRAPPER
    chmod 0755 "$PKG/usr/bin/prt-get" || return 1

    install -Dm644 "$SRC/README" "$PKG/usr/share/doc/prt-get/README.BFSOS" || return 1

    # Keep the packaged manual discoverable even though the implementation is
    # a BFSOS front-end policy layered over upstream prt-get.
    if [ -f "$PKG/usr/share/man/man8/prt-get.8" ]; then
        cat >> "$PKG/usr/share/man/man8/prt-get.8" <<'EOF_MAN'
.SH BFSOS UPDATE OPTIONS
.TP
.B --no-new-deps
For
.B update
and
.B sysup,
detect and report newly required dependencies but do not install those newly
introduced dependencies automatically.  The requested package update/system
update is still attempted.  Explicit dependency installation through
.B depinst
is unchanged.  Without this option, BFSOS retains its normal automatic
new-dependency installation behavior.
.PP
Examples:
.nf
prt-get update --no-new-deps <package>
prt-get sysup --no-new-deps
.fi
EOF_MAN
    fi
}
