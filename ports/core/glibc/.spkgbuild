# description : GNU C Library
# homepage    : https://www.gnu.org/software/libc/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : linux-headers
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# keep_static is implicit here: scratchpkg keeps *.a files.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=glibc
version=2.44
release=4
source="https://ftp.gnu.org/gnu/glibc/glibc-$version.tar.xz glibc-fhs-1.patch glibc-2.44-upstream_fix-1.patch genlocales ld.so.conf nsswitch.conf"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	local configure_flags

	configure_flags="
        --prefix=/usr
        --with-headers=/usr/include
        --disable-profile
        --disable-werror
        --enable-kernel=5.10
        --enable-stack-protector=strong
        --enable-multi-arch
        --disable-nscd
        libc_cv_include_x86_isa_level=no
    "

	#
	# The root filesystem uses:
	#
	# /lib    -> usr/lib
	# /lib64  -> lib
	#
	ln -sfn lib "$PKG/lib64"

	#
	# Build and install the native 64-bit Glibc.
	#
	mkdir -v build
	cd build

	../configure \
	    --libexecdir=/usr/lib \
	    libc_cv_slibdir=/lib \
	    $configure_flags

	make

	sed \
	    '/test-installation/s@$(PERL)@echo not running@' \
	    -i ../Makefile

	make install_root="$PKG" install

	install -d -m 0755 \
	    "$PKG/usr/lib/locale" \
	    "$PKG/etc/ld.so.conf.d"

	install -m 0644 \
	    "$SRC/ld.so.conf" \
	    "$PKG/etc/ld.so.conf"

	install -m 0644 \
	    "$SRC/nsswitch.conf" \
	    "$PKG/etc/nsswitch.conf"

	#
	# Create the list consumed by the genlocales helper.
	#
	sed \
	    -e '1,3d' \
	    -e 's|/| |g' \
	    -e 's|\\| |g' \
	    -e 's|^|#|g' \
	    "$SRC/glibc-$version/localedata/SUPPORTED" \
	    > "$PKG/etc/locales"

	install -D -m 0755 \
	    "$SRC/genlocales" \
	    "$PKG/usr/bin/genlocales"

	#
	# Generate the minimal C locale required by the base system.
	#
	LC_ALL=C \
	./elf/ld.so \
	    --library-path . \
	    "$PKG/usr/bin/localedef" \
	    --force \
	    --quiet \
	    --inputfile="$SRC/$name-$version/localedata/locales/C" \
	    --charmap="$SRC/$name-$version/localedata/charmaps/UTF-8" \
	    "$PKG/usr/lib/locale/C" \
	    || true

	sed -i '/#C\.UTF-8 /d' "$PKG/etc/locales"

	#
	# These programs are supplied by the tzdata package.
	#
	rm -f \
	    "$PKG/usr/bin/zdump" \
	    "$PKG/usr/sbin/zic" \
	    "$PKG/usr/bin/tzselect"

	#
	# Build and install the 32-bit Glibc.
	#
	cd ..

	mkdir -v build32
	cd build32

	CC="gcc -m32 -mstackrealign" \
	CXX="g++ -m32 -mstackrealign" \
	CFLAGS="-O2 -march=i686 -pipe -Wno-error=parentheses" \
	CXXFLAGS="-O2 -march=i686 -pipe -Wno-error=parentheses" \
	../configure \
	    --host=i686-pc-linux-gnu \
	    --libdir=/usr/lib32 \
	    --libexecdir=/usr/lib32 \
	    libc_cv_slibdir=/usr/lib32 \
	    $configure_flags

	make
	make install_root="$PWD/DESTDIR" install

	install -d -m 0755 \
	    "$PKG/usr/lib32" \
	    "$PKG/usr/include/gnu"

	cp -a \
	    DESTDIR/usr/lib32/. \
	    "$PKG/usr/lib32/"

	install -m 0644 \
	    DESTDIR/usr/include/gnu/lib-names-32.h \
	    DESTDIR/usr/include/gnu/stubs-32.h \
	    "$PKG/usr/include/gnu/"

	#
	# 32-bit dynamic linker compatibility path.
	#
	# BFSOS uses merged /usr:
	#   /lib -> /usr/lib
	#
	# ELF32 binaries request /lib/ld-linux.so.2, so install the
	# compatibility symlink in /usr/lib where /lib resolves.
	#
	ln -sfn \
	    ../lib32/ld-linux.so.2 \
	    "$PKG/usr/lib/ld-linux.so.2"

	#
	# Locale data is architecture-independent. Both 64-bit and 32-bit
	# Glibc use /usr/lib/locale.
	#
	ln -sfn \
	    ../lib/locale \
	    "$PKG/usr/lib32/locale"

	echo "/usr/lib32" \
	    > "$PKG/etc/ld.so.conf.d/lib32.conf"
}

bootstrap_build() {
    # Patch sources are applied automatically by files/pkgmk.bootstrap before
    # this function runs, in source=() order.

    #
    # Temporary 32-bit Glibc.
    #
    mkdir -v build32
    cd build32

    echo "slibdir=$TOOLS/lib32" > configparms

    ../configure \
        --prefix="$TOOLS" \
        --host="$LFS_TGT32" \
        --build="$(../scripts/config.guess)" \
        --libdir="$TOOLS/lib32" \
        --enable-kernel=5.10 \
        --with-headers="$TOOLS/include" \
        CC="$LFS_TGT-gcc -m32" \
        CXX="$LFS_TGT-g++ -m32"

    make
    make install

    #
    # GCC's -m32 multilib search expects the 32-bit runtime under
    # $TOOLS/$LFS_TGT/lib32. Glibc installs it in $TOOLS/lib32.
    # Provide the target-layout compatibility link before GCC pass 2.
    #
    mkdir -p "$TOOLS/$LFS_TGT"
    ln -sfn ../lib32 "$TOOLS/$LFS_TGT/lib32"

    cd ..

    #
    # Temporary 64-bit Glibc.
    #
    mkdir -v build
    cd build

    ../configure \
        --prefix="$TOOLS" \
        --host="$LFS_TGT" \
        --build="$(../scripts/config.guess)" \
        --enable-kernel=5.10 \
        --with-headers="$TOOLS/include"

    make
    make install

    # GCC 16.2 contains UTF-8 pathnames.  Stage 2 still uses libarchive/bsdtar
    # linked to this temporary glibc, so the temporary toolchain must have its
    # own usable UTF-8 locale archive under $TOOLS/lib/locale.
    mkdir -p "$TOOLS/lib/locale"
    "$TOOLS/bin/localedef" \
        --force --quiet \
        --inputfile="$SRC/$name-$version/localedata/locales/C" \
        --charmap="$SRC/$name-$version/localedata/charmaps/UTF-8" \
        C.UTF-8

    # Do not consider the temporary glibc complete if its own locale tools
    # cannot load the locale.  This catches the mixed-host/target locale bug
    # before GCC pass 2 or libarchive encounters a UTF-8 archive pathname.
    if ! LC_ALL=C.utf8 "$TOOLS/bin/locale" charmap 2>/dev/null | grep -Fxiq UTF-8; then
        echo "ERROR: temporary glibc C.utf8 locale is not usable" >&2
        return 1
    fi
}
