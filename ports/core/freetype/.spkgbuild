# description : Font rasterization library
# homepage    : https://www.freetype.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libpng which
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=freetype
version=2.14.3
release=1
source="https://downloads.sourceforge.net/freetype/freetype-$version.tar.xz https://downloads.sourceforge.net/freetype/freetype-doc-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		sed -ri "s:.*(AUX_MODULES.*valid):\1:" modules.cfg &&

		sed -r "s:.*(#.*SUBPIXEL_RENDERING) .*:\1:" \
	    	-i include/freetype/config/ftoption.h  &&

	        ./configure --prefix=/usr --enable-freetype-config --disable-static
	        make
	        make DESTDIR=$PKG install
	        mkdir -p $PKG/usr/share/doc/freetype-$version
	install -v -m755 -d $PKG/usr/share/doc/freetype-$version &&
	cp -v -R docs/*     $PKG/usr/share/doc/freetype-$version &&
	rm -v $PKG/usr/share/doc/freetype-$version/freetype-config.1
}
