# description : URL transfer tool
# homepage    : https://curl.se/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : ca-certificates openssl
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=curl
version=8.22.0
release=1
build_opt="
	--with-openssl
	--enable-threaded-resolver
	--with-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt
	--without-brotli
	--without-libidn2
	--without-libpsl
	--without-librtmp
	--without-nghttp2"
source="https://$name.se/download/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# bootstrap.sh calls bootstrap_build() with TOOLS pointing at the
	# toolchain root; a package build stages into $PKG instead.
	TOOLS="${TOOLS:-$PKG}"
	bootstrap_build || return 1
}

bootstrap_build() {
autoreconf 
./configure --prefix=$TOOLS \
        --disable-static \
        --enable-threaded-resolver \
        --with-openssl \
        --without-libpsl \
        --without-brotli \
        --without-librtmp \
        --without-nghttp2 \
        --without-libidn2 \
        --with-ca-bundle=$TOOLS/etc/ssl/cert.pem
 make
 make install
}
