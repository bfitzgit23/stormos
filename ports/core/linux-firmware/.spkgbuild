# description : Firmware files for Linux
# homepage    : https://gitlab.com/kernel-firmware/linux-firmware
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : rdfind
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=linux-firmware
version=20260916
release=1
source="https://www.kernel.org/pub/linux/kernel/firmware/$name-$version.tar.xz"
options="!strip"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	make -j1 \
	    DESTDIR="$PKG" \
	    FIRMWAREDIR=/lib/firmware \
	    install

	make \
	    DESTDIR="$PKG" \
	    FIRMWAREDIR=/lib/firmware \
	    dedup

	find "$PKG" \
	    \( -name ChangeLog -o -name README \) \
	    -delete
}
