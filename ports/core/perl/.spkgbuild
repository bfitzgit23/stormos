# description : perl
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=perl
version=5.44.0
release=1
source="https://www.cpan.org/src/5.0/perl-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	BUILD_ZLIB=False \
	BUILD_BZIP2=0 \
	sh Configure -des -Dprefix=/usr                 \
	                  -Dvendorprefix=/usr           \
	                  -Dprivlib=/usr/lib/perl5/${version%.*}/core_perl \
	                  -Darchlib=/usr/lib/perl5/${version%.*}/core_perl \
	                  -Dsitelib=/usr/lib/perl5/${version%.*}/site_perl \
	                  -Dsitearch=/usr/lib/perl5/${version%.*}/site_perl \
	                  -Dvendorlib=/usr/lib/perl5/${version%.*}/vendor_perl \
	                  -Dvendorarch=/usr/lib/perl5/${version%.*}/vendor_perl \
	                  -Dman1dir=/usr/share/man/man1 \
	                  -Dman3dir=/usr/share/man/man3 \
	                  -Dpager="/usr/bin/less -isR"  \
	                  -Duseshrplib                  \
	          	  -Dusethreads
	make
	make DESTDIR=$PKG install
}

bootstrap_build() {
	sh Configure -des -Dprefix=$TOOLS -Dlibs=-lm
	make
	cp -v perl cpan/podlators/scripts/pod2man $TOOLS/bin
	mkdir -pv $TOOLS/lib/perl5/$version
	cp -Rv lib/* $TOOLS/lib/perl5/$version
}
