# description : firewalling, NAT, and packet mangling for linux
# homepage    : https://netfilter.org/projects/nftables/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : jansson libedit python3 libmnl libnftnl
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=nftables
version=1.1.7
release=1
source="https://www.netfilter.org/pub/nftables/nftables-$version.tar.xz nftables.nft nftables.service"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	PYTHON_VERSION=$(python3 -c 'import sys; print("%s.%s" % sys.version_info[:2])')

	autoreconf -vfi

	PYTHON_PATH=/usr/lib/python${PYTHON_VERSION}/site-packages/ \
	./configure \
		--prefix=/usr \
		--sbindir=/usr/bin \
		--sysconfdir=/usr/share \
		--with-cli=readline \
		--with-json \
		--with-python-bin=/usr/bin/python3 \
		--disable-debug
	make
	make DESTDIR=$PKG install

	/usr/bin/python3 -m compileall -d / $PKG/usr/lib
	/usr/bin/python3 -O -m compileall -d / $PKG/usr/lib

	install -Dm644 $SRC/nftables.service $PKG/usr/lib/systemd/system/nftables.service
	install -D -m 600 $SRC/nftables.nft $PKG/etc/nftables.nft


}
