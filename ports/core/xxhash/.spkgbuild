# description : Extremely fast non-cryptographic hash algorithm
# homepage    : https://github.com/Cyan4973/xxHash
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xxhash
version=0.8.4
release=1
source="https://github.com/Cyan4973/xxHash/archive/v$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	ls
	cmake -S build/cmake -B build -G Ninja \
	  -D CMAKE_INSTALL_PREFIX=/usr \
	  -D CMAKE_INSTALL_LIBDIR=lib \
	  -D CMAKE_BUILD_TYPE=Release \
	  -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	  -Wno-dev
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
