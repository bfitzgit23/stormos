# description : python3-packaging
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3-flit-core
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-packaging
version=26.3
release=1
source="https://files.pythonhosted.org/packages/source/p/packaging/packaging-${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 wheel \
	    -w dist --no-cache-dir --no-build-isolation --no-deps .
	PIP_CONFIG_FILE=/dev/null /usr/bin/pip3 install \
	    --no-index --find-links dist --root="$PKG" --ignore-installed --no-deps packaging
}
