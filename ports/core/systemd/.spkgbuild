# description : System and service manager for Linux
# homepage    : https://github.com/systemd/systemd
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : linux-pam polkit
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=systemd
version=261.3
release=1
source="https://github.com/$name/$name/archive/v$version/$name-$version.tar.gz https://anduin.linuxfromscratch.org/LFS/$name-man-pages-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -i \
	    -e 's/GROUP="render"/GROUP="video"/' \
	    -e 's/GROUP="sgx", //' \
	    rules.d/50-udev-default.rules.in

	mkdir -v build || return 1
	cd build || return 1

	meson setup .. \
	    --prefix=/usr \
	    --buildtype=release \
	    -D default-dnssec=no \
	    -D firstboot=false \
	    -D install-tests=false \
	    -D ldconfig=false \
	    -D man=auto \
	    -D sysusers=true \
	    -D rpmmacrosdir=no \
	    -D homed=disabled \
	    -D userdb=false \
	    -D mode=release \
	    -D pam=enabled \
	    -D pamconfdir=/etc/pam.d \
	    -D dev-kvm-mode=0660 \
	    -D nobody-group=nogroup \
	    -D sysupdate=disabled \
	    -D ukify=disabled \
	    -D docdir=/usr/share/doc/$name-$version || return 1

	ninja || return 1
	DESTDIR="$PKG" ninja install || return 1

	install -d -m 0755 "$PKG/usr/share/man"

	tar -xf \
	    "$PKGMK_SOURCE_DIR/$name-man-pages-$version.tar.xz" \
	    --no-same-owner \
	    --strip-components=1 \
	    -C "$PKG/usr/share/man"

	#
	# systemd installs:
	#
	# /usr/lib/environment.d/99-environment.conf
	#     -> ../../../etc/environment
	#
	# Supply the target so the installed link is not dangling.
	#
	install -d -m 0755 "$PKG/etc"
	install -m 0644 /dev/null "$PKG/etc/environment"

	#
	# Install the PAM configuration owned by Systemd.
	#
	install -d -m 0755 "$PKG/etc/pam.d"

	cat > "$PKG/etc/pam.d/systemd-user" <<'EOF'
# Begin /etc/pam.d/systemd-user

account  required    pam_access.so
account  include     system-account

session  required    pam_env.so
session  required    pam_limits.so
session  required    pam_unix.so
session  required    pam_loginuid.so
session  optional    pam_keyinit.so force revoke
session  optional    pam_systemd.so

auth     required    pam_deny.so
password required    pam_deny.so

# End /etc/pam.d/systemd-user
EOF

	chmod 0644 "$PKG/etc/pam.d/systemd-user"
}
