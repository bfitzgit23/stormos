# description : A simple pythonic template language written in Python
# homepage    : https://palletsprojects.com/p/jinja/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3-babel python3-markupsafe python3-build python3-wheel python3-installer
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-jinja2
version=3.1.6
release=1
source="https://pypi.org/packages/source/J/Jinja2/jinja2-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	/usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
	/usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
