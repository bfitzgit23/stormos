# description : GNU pico clone (a tiny text editor)
# homepage    : https://www.nano-editor.org
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : file ncurses bzip2 xz
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=nano
version=9.2
release=1
source="https://www.nano-editor.org/dist/v${version%%.*}/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		./configure --prefix=/usr     \
	            --sysconfdir=/etc \
	            --enable-utf8     \
	            --docdir=/usr/share/doc/$name-$version &&
	make
		make DESTDIR=$PKG install
		install -D -m 644 doc/sample.nanorc $PKG/usr/etc/nanorc
	rm -rf $PKG/usr/share/info/dir
	mkdir -p $PKG/etc
	cat > $PKG/etc/nanorc << "EOF"
set autoindent
set constantshow
set fill 72
set historylog
set multibuffer
set nohelp
set positionlog
set quickblank
set regexp
EOF
}
