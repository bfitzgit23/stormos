# description : readline
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=readline
version=8.3
release=1
source="https://ftp.gnu.org/gnu/readline/readline-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -i '/MV.*old/d' Makefile.in
	sed -i '/{OLDSUFF}/c:' support/shlib-install
		./configure --prefix=/usr --disable-static --with-curses 
		make SHLIB_LIBS="-lncursesw"
		make SHLIB_LIBS="-lncursesw" DESTDIR=$PKG install
}

bootstrap_build() {
       sed -i '/MV.*old/d' Makefile.in
sed -i '/{OLDSUFF}/c:' support/shlib-install
ARCH="x86_64"  CFLAGS+="-fPIC"
        ./configure --prefix=$TOOLS --disable-static --with-curses
        make SHLIB_LIBS="-L$TOOLS/lib/ -lncursesw"
        make SHLIB_LIBS="-L$TOOLS/lib/ -lncursesw" install
}
