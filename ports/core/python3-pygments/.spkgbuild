# description : Python syntax highlighter
# homepage    : https://pygments.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3-build python3-installer python3-wheel python3-hatchling python3-packaging
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-pygments
version=2.21.0
release=1
source="https://files.pythonhosted.org/packages/source/P/Pygments/pygments-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	  python3 -m build --wheel --no-isolation
	python3 -m installer --destdir="$PKG" dist/*.whl
}
