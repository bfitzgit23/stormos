# description : 80x86 assembler
# homepage    : https://www.nasm.us/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=nasm
version=3.02
release=4
source="https://www.nasm.us/pub/nasm/releasebuilds/$version/$name-$version.tar.xz https://www.nasm.us/pub/nasm/releasebuilds/$version/$name-$version-xdoc.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	./configure \
	    --prefix=/usr || return $?

	make -j "${JOBS:-1}" || return $?

	make DESTDIR="$PKG" install || return $?

	install -d \
	    "$PKG/usr/share/doc/$name-$version/html" || return $?

	for f in doc/html/*.html; do
	    [ -e "$f" ] || continue
	    cp -v "$f" \
	        "$PKG/usr/share/doc/$name-$version/html/" || return $?
	done

	for f in doc/*.txt doc/*.ps doc/*.pdf; do
	    [ -e "$f" ] || continue
	    cp -v "$f" \
	        "$PKG/usr/share/doc/$name-$version/" || return $?
	done
}
