# description : Internationalized Domain Names in Applications (IDNA)
# homepage    : https://pypi.org/project/idna/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3 python3-build python3-installer python3-flit-core
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-idna
version=3.20
release=1
source="https://files.pythonhosted.org/packages/source/i/idna/idna-${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	python3 -m build \
	    --no-isolation \
	    --wheel || return 1

	python3 -m installer \
	    --destdir="$PKG" \
	    dist/*.whl || return 1
}
