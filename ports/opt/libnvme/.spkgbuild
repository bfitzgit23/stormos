# description : The libnvme package is a library which provides type definitions for NVMe specification structures, enumerations, and bit fields, helper functions to construct, dispatch, and decode commands and payloads, and utilities to connect, scan, and manage NVMe devices on a Linux system.
# homepage    : https://github.com/linux-nvme/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libnvme
version=1.16.2
release=2
source="https://github.com/linux-nvme/$name/archive/refs/tags/v$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1


		mkdir build &&
		cd    build &&

	meson setup --prefix=/usr --buildtype=release -Dlibdbus=auto .. &&
	ninja
		DESTDIR=$PKG ninja install
}
