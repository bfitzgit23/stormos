# description : GLib-based client library for accessing the online accounts database
# homepage    : https://gitlab.com/accounts-sso/libaccounts-glib
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : check glib libxml2 meson ninja sqlite
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libaccounts-glib
version=1.27
release=1
source="https://gitlab.com/accounts-sso/$name/-/archive/VERSION_$version/$name-VERSION_$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dtests=false \
	    -Ddocs=false || return 1
	meson compile -C build || return 1
	DESTDIR="$PKG" meson install -C build || return 1
}
