# description : Official DirectX headers available under an open source license
# homepage    : https://github.com/microsoft/DirectX-Headers
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=directx-headers
version=1.619.5
release=1
source="https://github.com/microsoft/DirectX-Headers/archive/v$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup DirectX-Headers-$version build \
	  --prefix=/usr \
	  --buildtype=plain \
	  --wrap-mode nodownload \
	  -D b_lto=false \
	  -D b_pie=true \
	  -D build-test=false

	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
