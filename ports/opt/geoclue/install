#!/bin/sh
#
# BFSOS scratchpkg install script, generated from the CRUX scripts by scripts/bfs-ports-to-spkgbuild.py.
# scratchpkg calls this with $1 = pre-install|post-install|pre-upgrade|
# post-upgrade|pre-remove|post-remove, $2 = new version, $3 = old version.

case $1 in
	post-install)
		set -eu

		# BFSOS no longer ships a distro/maintainer Google Geolocation API key.
		# Remove the legacy BFSOS override created by older package releases. Users who
		# need a provider-specific key should create a separate local conf.d override.
		rm -f /etc/geoclue/conf.d/90-lfs-google.conf

		exit 0
		;;
esac
