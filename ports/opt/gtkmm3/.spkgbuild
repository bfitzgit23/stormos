# description : A C++ wrapper for GTK3+
# homepage    : https://www.gtkmm.org/en/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : atkmm cairomm-1.0 glibmm-2.4 gtk3 pangomm
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gtkmm3
version=3.24.11
release=3
source="https://download.gnome.org/sources/gtkmm/${version%.*}/gtkmm-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup gtkmm-$version build \
	  --prefix=/usr \
	  --sysconfdir=/etc \
	  --buildtype=plain \
	  --wrap-mode nodownload \
	  -D b_lto=true \
	  -D b_pie=true \
	  -D build-demos=false \
	  -D build-tests=false
	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
