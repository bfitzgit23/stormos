# description : Public Suffix List library
# homepage    : https://github.com/rockdaboot/libpsl
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libidn2 publicsuffix-list
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libpsl
version=0.23.3
release=1
source="https://github.com/rockdaboot/$name/releases/download/$version/$name-$version.tar.lz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	  --prefix=/usr \
	  --buildtype=plain \
	  --wrap-mode nodownload \
	  -D b_lto=true \
	  -D b_pie=true \
	  -D runtime=libidn2 \
	  -D builtin=true \
	  -D psl_file=/usr/share/publicsuffix/effective_tld_names.dat \
	  -D psl_testfile=/usr/share/publicsuffix/test_psl.txt \
	  -D tests=false

	ninja -j "${JOBS:-1}" -C build
	DESTDIR="$PKG" meson install -C build
}
