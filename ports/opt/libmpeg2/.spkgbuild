# description : MPEG1/MPEG2 decoder (includes libmpeg2)
# homepage    : https://libmpeg2.sourceforge.io/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : sdl12-compat
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libmpeg2
version=0.5.1
release=2
source="https://download.videolan.org/contrib/libmpeg2/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -i 's/static const/static/' libmpeg2/idct_mmx.c || return 1

	./configure \
	  --prefix=/usr \
	  --enable-shared \
	  --disable-static || return 1

	make -j "${JOBS:-1}" || return 1
	make DESTDIR="$PKG" install || return 1

	install -v -m755 -d \
	  "$PKG/usr/share/doc/$name-$version" || return 1

	install -v -m644 \
	  README \
	  doc/libmpeg2.txt \
	  "$PKG/usr/share/doc/$name-$version/" || return 1
}
