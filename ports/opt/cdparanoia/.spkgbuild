# description : The CDParanoia package contains a CD audio extraction tool. This is useful for extracting .wav files from audio CDs. A CDDA capable CDROM drive is needed. Practically all drives supported by Linux can be used.
# homepage    : https://xiph.org
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=cdparanoia
version=10.2
release=1
skip_patch=1
source="https://downloads.xiph.org/releases/$name/$name-III-$version.src.tgz https://www.linuxfromscratch.org/patches/blfs/svn/$name-III-$version-gcc_fixes-1.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		patch -Np1 -i ../$name-III-$version-gcc_fixes-1.patch &&
	./configure --prefix=/usr --mandir=/usr/share/man &&
	make -j1
	 make prefix=$PKG/usr MANDIR=$PKG/usr/share/man install
	chmod -v 755 $PKG/usr/lib/libcdda_*.so.0.10.2 &&
	rm -fv $PKG/usr/lib/libcdda_*.a
}
