# description : Library for high quality hyphenation and justification
# homepage    : https://github.com/hunspell/hyphen
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=hyphen
version=2.8.9
release=1
source="https://github.com/hunspell/hyphen/archive/refs/tags/v$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	./configure --prefix=/usr

	make
	make DESTDIR="$PKG" install

	pushd "$PKG/usr/share/hyphen/"
	en_US_aliases="en_AG en_AU en_BS en_BW en_BZ en_CA en_DK en_GB en_GH en_HK en_IE en_IN en_JM en_NA en_NZ en_PH en_SG en_TT en_ZA en_ZW"
	for lang in $en_US_aliases; do
	  ln -s hyph_en_US.dic "hyph_$lang.dic"
	done
	popd

	install -d -m 0755 "$PKG/usr/share/myspell/dicts"
	pushd "$PKG/usr/share/myspell/dicts"
	for file in "$PKG"/usr/share/hyphen/*; do
	  ln -sv "/usr/share/hyphen/$(basename "$file")" .
	done
	popd
}
