# description : A 2D graphics library with support for multiple output devices
# homepage    : https://www.cairographics.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : fontconfig glib pixman libxext libxrender xcb-util libpng
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=cairo
version=1.18.4
release=3
source="https://mirror.subgraph.com/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . --prefix=/usr --buildtype=release -Dxlib-xcb=enabled || return $?
	meson compile -C build -j "${JOBS:-1}" || return $?
	DESTDIR="$PKG" meson install -C build || return $?
}
