# description : All-in-one voice and text chat for gamers
# homepage    : https://discord.com/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : alsa-lib gtk3 libnotify libx11 libxcomposite libxcursor libxdamage libxext libxfixes libxi libxrandr libxrender libxscrnsaver libxtst nspr nss
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=discord
version=1.0.158
release=4
source="https://dl.discordapp.net/apps/linux/$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	install -d "$PKG/opt/discord"
	cp -a . "$PKG/opt/discord/"

	install -d "$PKG/usr/bin"

	cat > "$PKG/usr/bin/discord" <<'SCRIPT'
#!/bin/sh
exec /opt/discord/discord "$@"
SCRIPT

	chmod 755 "$PKG/usr/bin/discord"

	install -d "$PKG/usr/share/applications"
	install -m 644 discord.desktop \
	    "$PKG/usr/share/applications/discord.desktop"

	sed -i \
	    's|^Exec=.*|Exec=/usr/bin/discord %U|' \
	    "$PKG/usr/share/applications/discord.desktop"

	install -d "$PKG/usr/share/pixmaps"
	ln -s /opt/discord/discord.png \
	    "$PKG/usr/share/pixmaps/discord.png"
}
