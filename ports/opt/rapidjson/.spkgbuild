# description : Fast JSON parser and generator for C++
# homepage    : https://github.com/Tencent/rapidjson
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=rapidjson
version=20250205.24b5e7a
release=1
_commit=24b5e7a8b27f42fa16b96fc70aade9106cf7102f
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DRAPIDJSON_BUILD_DOC=OFF
           -DRAPIDJSON_BUILD_EXAMPLES=OFF
           -DRAPIDJSON_BUILD_TESTS=OFF
           -DCMAKE_POLICY_VERSION_MINIMUM=3.5"
source="https://github.com/Tencent/rapidjson/archive/$_commit/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
