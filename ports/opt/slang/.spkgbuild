# description : S-Lang (slang) is an interpreted language that may be embedded into an application to make the application extensible. It provides facilities required by interactive applications such as display/screen management, keyboard input and keymaps.
# homepage    : https://www.jedsoft.org/releases/$name
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=slang
version=2.3.3
release=1
source="https://www.jedsoft.org/releases/$name/$name-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		./configure --prefix=/usr \
	            --sysconfdir=/etc \
	            --with-readline=gnu &&
	make -j1
		make DESTDIR=$PKG install_doc_dir=/usr/share/doc/$name-$version   \
	     SLSH_DOC_DIR=/usr/share/doc/$name-$version/slsh \
	     install
}
