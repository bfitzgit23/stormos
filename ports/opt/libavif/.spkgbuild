# description : AV1 Image File Format library
# homepage    : https://github.com/AOMediaCodec/libavif
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake ninja libaom dav1d svt-av1 gdk-pixbuf
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libavif
version=1.4.2
release=2
source="https://github.com/AOMediaCodec/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cmake -S . -B build -G Ninja \
	    -DCMAKE_INSTALL_PREFIX=/usr \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DAVIF_CODEC_AOM=SYSTEM \
	    -DAVIF_CODEC_DAV1D=SYSTEM \
	    -DAVIF_CODEC_SVT=SYSTEM \
	    -DAVIF_BUILD_GDK_PIXBUF=ON \
	    -DAVIF_LIBYUV=OFF || return 1
	ninja -C build || return 1
	DESTDIR="$PKG" ninja -C build install || return 1
}
