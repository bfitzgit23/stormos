#!/bin/sh
#
# BFSOS scratchpkg install script, generated from the CRUX scripts by scripts/bfs-ports-to-spkgbuild.py.
# scratchpkg calls this with $1 = pre-install|post-install|pre-upgrade|
# post-upgrade|pre-remove|post-remove, $2 = new version, $3 = old version.

case $1 in
	pre-install)
		if [ -e /usr/include/glib-2.0 ]; then
		    rm -rf /usr/include/glib-2.0.old &&
		    mv -vf /usr/include/glib-2.0{,.old}
		fi
		;;
	post-install)
		# compile needed glib schemas
		glib-compile-schemas /usr/share/glib-2.0/schemas
		;;
esac
