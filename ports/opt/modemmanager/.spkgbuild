# description : Unified high-level API for mobile broadband modems
# homepage    : https://gitlab.freedesktop.org/mobile-broadband/ModemManager
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libgudev glib gobject-introspection libmbim libqmi polkit vala
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=modemmanager
version=1.24.2
release=3
source="https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$version/ModemManager-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dbash_completion=false \
	    -Dqrtr=false || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1

	DESTDIR="$PKG" \
	    meson install -C build || return 1
}
