# description : Graphical console client for libvirt virtual machines
# homepage    : https://virt-manager.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gtk3 gtk-vnc libvirt libvirt-glib libxml2 spice-gtk spice-protocol vte
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=virt-viewer
version=11.0
release=2
build_opt=(
    -Dlibvirt=enabled
    -Dvnc=enabled
    -Dspice=enabled
    -Dovirt=disabled
    -Dvte=enabled
    -Dgit_werror=disabled
)
source="https://gitlab.com/virt-viewer/virt-viewer/-/archive/v$version/virt-viewer-v$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}

pre_build() {
    sed -i \
        -e "/^[[:space:]]*desktop,$/d" \
        -e "/^[[:space:]]*mimetypes,$/d" \
        -e "/^[[:space:]]*metainfo,$/d" \
        data/meson.build
}
