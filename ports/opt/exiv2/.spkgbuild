# description : Exiv2 is a C++ library and a command line utility for managing image and video metadata.
# homepage    : https://github.com/Exiv2/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake brotli curl inih
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=exiv2
version=0.28.9
release=1
source="https://github.com/$name/$name/archive/v$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	mkdir build &&
	cd    build &&

	cmake -DCMAKE_INSTALL_PREFIX=/usr  \
	      -DCMAKE_BUILD_TYPE=Release   \
	      -DEXIV2_ENABLE_VIDEO=yes     \
	      -DEXIV2_ENABLE_WEBREADY=yes  \
	      -DEXIV2_ENABLE_CURL=yes      \
	      -DEXIV2_BUILD_SAMPLES=no     \
	      -G "Unix Makefiles" .. &&
	make
	make DESTDIR=$PKG install
}
