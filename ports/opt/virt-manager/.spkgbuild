# description : Graphical virtual machine manager for libvirt
# homepage    : https://virt-manager.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gtk3 gtk-vnc libisoburn libosinfo libvirt libvirt-glib libvirt-python python3 python3-argcomplete python3-cairo python3-gobject python3-requests spice spice-gtk spice-protocol swtpm virt-viewer vte
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=virt-manager
version=5.1.0
release=5
build_opt=(
    -Dtests=disabled
    -Dupdate-icon-cache=false
    -Dcompile-schemas=false
    -Ddefault-graphics=vnc
    -Ddefault-hvs="['qemu']"
)
source="https://github.com/virt-manager/virt-manager/archive/refs/tags/v$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
