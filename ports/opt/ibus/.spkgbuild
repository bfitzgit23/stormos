# description : ibus
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : unicode-character-database dconf iso-codes vala glib gobject-introspection gtk3 libnotify
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=ibus
version=1.5.34
release=2
source="https://github.com/${name}/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -e 's@/desktop/ibus@/org/freedesktop/ibus@g' \
	    -i data/dconf/org.freedesktop.ibus.gschema.xml
	SAVE_DIST_FILES=1 NOCONFIGURE=1 ./autogen.sh &&

	PYTHON=python3                     \
	./configure --prefix=/usr          \
	            --sysconfdir=/etc      \
	            --disable-python2      \
	            --disable-appindicator \
	            --disable-gtk2         \
	            --disable-emoji-dict   &&
	make
	make DESTDIR="$PKG" install
}
