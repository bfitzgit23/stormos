# description : The GPGME package is a C library that allows cryptography support to be added to a program. It is designed to make access to public key crypto engines like GnuPG or GpgSM easier for applications. GPGME provides a high-level crypto API for encryption, decryption, signing, signature verification and key management.
# homepage    : https://www.gnupg.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libassuan
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gpgme
version=2.2.0
release=3
source="https://gnupg.org/ftp/gcrypt/$name/$name-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		mkdir build &&
	cd    build &&

	../configure --prefix=/usr --disable-gpg-test &&
	make PYTHONS=
		make DESTDIR=$PKG install PYTHONS=
	rm -rf $PKG/usr/share/info/
}
