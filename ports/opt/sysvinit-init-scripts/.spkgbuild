# description : LFS/BLFS SysVinit service scripts
# homepage    : https://www.linuxfromscratch.org/blfs/
# maintainer  : BFSOS maintainers
# depends     : sysvinit lfs-bootscripts dbus networkmanager acpid bluez gpm chrony
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=sysvinit-init-scripts
version=1
release=1
source="dbus networkmanager acpid bluetooth gpm chronyd cups avahi sshd samba rsyncd krb5 nftables wpa_supplicant bfs-kernel-finalize virtlogd libvirtd xdm sysconfig-xdm pipewire.desktop pipewire-pulse.desktop wireplumber.desktop"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	install -d -m 0755 "$PKG/etc/rc.d/init.d" \
	                  "$PKG/etc/rc.d/rc0.d" \
	                  "$PKG/etc/rc.d/rc1.d" \
	                  "$PKG/etc/rc.d/rc2.d" \
	                  "$PKG/etc/rc.d/rc3.d" \
	                  "$PKG/etc/rc.d/rc4.d" \
	                  "$PKG/etc/rc.d/rc5.d" \
	                  "$PKG/etc/rc.d/rc6.d" \
	                  "$PKG/etc/rc.d/rcS.d" \
	                  "$PKG/etc/sysconfig" \
	                  "$PKG/etc/xdg/autostart" || return 1

	# Every script installs; only the default set below receives rc?.d
	# links (the sysvinit equivalent of the services the installer enables
	# via ports/opt/calamares/services-openrc.conf).  Optional services are
	# enabled by the admin with the ln commands documented in the header of
	# each script:
	#
	#   sshd          ln -sf ../init.d/sshd rc3.d/S30sshd    (K30 on 0 1 6)
	#   samba         ln -sf ../init.d/samba rc3.d/S45samba  (K49 on 0 1 6)
	#   rsyncd        ln -sf ../init.d/rsyncd rc3.d/S30rsyncd (K30 on 0 1 6)
	#   krb5          ln -sf ../init.d/krb5 rc3.d/S28krb5    (K42 on 0 1 6)
	#   nftables      ln -sf ../init.d/nftables rc3.d/S19nftables (before network)
	#   wpa_supplicant ln -sf ../init.d/wpa_supplicant rc3.d/S20wpa_supplicant
	#                 (only when NetworkManager does not manage wifi)
	#   virtlogd      ln -sf ../init.d/virtlogd rc3.d/S85virtlogd (K22 on 0 1 6)
	#   libvirtd      ln -sf ../init.d/libvirtd rc3.d/S86libvirtd (K21 on 0 1 6)
	#   display manager: set DISPLAY_MANAGER in /etc/sysconfig/xdm, then
	#                 uncomment the dm:5 line in /etc/inittab and run init q
	#
	# bfs-kernel-finalize links early (S17) when kernel maintenance is used:
	#   ln -sf ../init.d/bfs-kernel-finalize rc3.d/S17bfs-kernel-finalize
	for service in dbus networkmanager acpid bluetooth gpm chronyd \
	               cups avahi sshd samba rsyncd krb5 nftables \
	               wpa_supplicant bfs-kernel-finalize virtlogd libvirtd \
	               xdm; do
	    install -m 0755 "$service" "$PKG/etc/rc.d/init.d/$service" || return 1
	done

	install -m 0644 sysconfig-xdm "$PKG/etc/sysconfig/xdm" || return 1

	# The PipeWire session stack is per-user; it is launched by the desktop
	# session from XDG autostart, identically to the OpenRC profile.
	for entry in pipewire.desktop pipewire-pulse.desktop wireplumber.desktop; do
	    install -m 0644 "$entry" "$PKG/etc/xdg/autostart/$entry" || return 1
	done

	# enable <S-number> <K-number> <script>: start links in rc2-rc5, stop
	# links in rc0/rc1/rc6.  Numbers follow the BLFS bootscripts convention
	# so they coexist with the base scripts shipped by lfs-bootscripts.
	enable() {
	    local sn=$1 kn=$2 svc=$3 rc
	    for rc in 2 3 4 5; do
	        ln -sf "../init.d/$svc" "$PKG/etc/rc.d/rc${rc}.d/S${sn}${svc}" || return 1
	    done
	    for rc in 0 1 6; do
	        ln -sf "../init.d/$svc" "$PKG/etc/rc.d/rc${rc}.d/K${kn}${svc}" || return 1
	    done
	}

	# Default set (chronyd mirrors the BLFS ntpd S36/K46 slot):
	enable 18 32 acpid
	enable 29 30 dbus
	enable 33 28 networkmanager
	enable 34 28 avahi
	enable 35 27 bluetooth
	enable 35 00 cups
	enable 36 46 chronyd
	enable 70 10 gpm
}
