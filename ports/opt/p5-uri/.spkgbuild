# description : Uniform Resource Identifiers (absolute and relative)
# homepage    : https://github.com/libwww-perl/URI
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : perl
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=p5-uri
version=5.37
release=1
source="http://search.cpan.org/CPAN/authors/id/O/OA/OALDERS/URI-${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor
	make OPTIMIZE="$CFLAGS" DESTDIR="$PKG" install

	find "$PKG" -depth \
		-type f \( -name .packlist -o -name \*.bs -o -name perllocal.pod \) -delete , \
		-type f -name autosplit.ix \( -exec grep -q '^[[:space:]]*package' {} \; -o -delete \) , \
		-type d -empty -exec rmdir {} +
}
