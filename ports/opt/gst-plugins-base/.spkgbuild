# description : An essential exemplary set of plugins for GStreamer
# homepage    : https://gstreamer.freedesktop.org/modules/gst-plugins-base.html
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gstreamer libvorbis opus mesa
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gst-plugins-base
version=1.28.7
release=1
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build \
	    --prefix=/usr \
	    --buildtype=release \
	    --wrap-mode=nodownload \
	    -Dpackage-origin="https://www.bfsos.org/" \
	    -Dpackage-name="GStreamer $version BFSOS" || return 1

	ninja -C build || return 1
	DESTDIR="$PKG" ninja -C build install || return 1

	test -f "$PKG/usr/lib/pkgconfig/gstreamer-gl-1.0.pc" || {
	    echo "ERROR: gst-plugins-base built without required GstGL support" >&2
	    return 1
	}
}
