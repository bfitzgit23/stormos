# description : The BlueZ package contains the Bluetooth protocol stack for Linux.
# homepage    : https://www.kernel.org/pub/linux/bluetooth/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : dbus glib libical
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=bluez
version=5.87
release=2
build_opt="--prefix=/usr
            --sysconfdir=/etc
            --localstatedir=/var
            --disable-manpages
            --enable-library"
source="https://www.kernel.org/pub/linux/bluetooth/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
install -v -dm755 $PKG/etc/bluetooth &&
install -v -m644 src/main.conf $PKG/etc/bluetooth/main.conf
}
