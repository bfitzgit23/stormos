# description : Seat management daemon and libseat library
# homepage    : https://sr.ht/~kennylevinsen/seatd/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : meson systemd
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=seatd
version=0.9.3
release=1
source="https://github.com/kennylevinsen/seatd/archive/refs/tags/${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	    --prefix=/usr \
	    --buildtype=release \
	    --wrap-mode=nodownload \
	    -Dwerror=false \
	    -Dlibseat-logind=systemd \
	    -Dlibseat-seatd=enabled \
	    -Dlibseat-builtin=disabled \
	    -Dserver=enabled \
	    -Dexamples=disabled \
	    -Dman-pages=disabled || return 1

	meson compile -C build || return 1

	DESTDIR="$PKG" meson install -C build || return 1
}
