# description : The Aspell package contains an interactive spell checking program and the Aspell libraries. Aspell can either be used as a library or as an independent spell checker.
# homepage    : https://ftp.gnu.org/gnu/aspell/dict/en/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : aspell which
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# scratchpkg rejects '-' in `version`; the upstream version 2026.02.25-0 is kept verbatim in the source URLs below.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=aspell6-en
version=2026.02.25
release=1
source="https://ftp.gnu.org/gnu/aspell/dict/en/$name-2026.02.25-0.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	./configure &&
	make
		make DESTDIR=$PKG install
}
