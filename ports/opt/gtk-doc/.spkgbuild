# description : The GTK-Doc package contains a code documenter. This is useful for extracting specially formatted comments from the code to create API documentation. This package is optional; if it is not installed, packages will not build the documentation. This does not mean that you will not have any documentation. If GTK-Doc is not available, the install process will copy any pre-built documentation to your system.
# homepage    : https://download.gnome.org/sources/gtk-doc/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : docbook-xml docbook-xsl-nons itstool libxslt python3-pygments
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gtk-doc
version=1.36.1
release=2
build_opt=(
  -Dtests=false
)
source="https://download.gnome.org/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
