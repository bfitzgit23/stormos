# description : Multicast DNS/DNS-SD service discovery stack
# homepage    : https://github.com/avahi/avahi
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glib gobject-introspection gtk3 libdaemon
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# scratchpkg rejects '-' in `version`; the upstream version 0.9-rc5 is kept verbatim in the source URLs below.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=avahi
version=0.9
release=3
build_opt="\
    --disable-static \
    --disable-libevent \
    --disable-mono \
    --disable-monodoc \
    --disable-python \
    --disable-qt3 \
    --disable-qt4 \
    --disable-manpages \
    --enable-core-docs \
    --with-distro=none"
source="https://github.com/avahi/avahi/archive/v0.9-rc5/avahi-0.9-rc5.tar.gz https://www.linuxfromscratch.org/patches/blfs/svn/avahi-0.9-rc5-ipv6_race_condition_fix-1.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}

pre_build() {
    autoreconf -fiv || return 1

    if prt-get isinst qt5 >/dev/null 2>&1; then
        build_opt="$build_opt --enable-qt5"
    else
        build_opt="$build_opt --disable-qt5"
    fi
}
