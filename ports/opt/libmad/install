#!/bin/sh
#
# BFSOS scratchpkg install script, generated from the CRUX scripts by scripts/bfs-ports-to-spkgbuild.py.
# scratchpkg calls this with $1 = pre-install|post-install|pre-upgrade|
# post-upgrade|pre-remove|post-remove, $2 = new version, $3 = old version.

case $1 in
	post-install)
		cat > /usr/lib/pkgconfig/mad.pc << "EOF"
prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: mad
Description: MPEG audio decoder
Requires:
Version: 0.15.1b
Libs: -L${libdir} -lmad
Cflags: -I${includedir}
EOF
		;;
esac
