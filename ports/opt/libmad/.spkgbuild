# description : libmad is a high-quality MPEG audio decoder capable of 24-bit output.
# homepage    : https://downloads.sourceforge.net/mad/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libmad
version=0.15.1b
release=1
skip_patch=1
source="https://downloads.sourceforge.net/mad/$name-$version.tar.gz https://www.linuxfromscratch.org/patches/blfs/svn/$name-$version-fixes-1.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	patch -Np1 -i ../$name-$version-fixes-1.patch                &&
	sed "s@AM_CONFIG_HEADER@AC_CONFIG_HEADERS@g" -i configure.ac &&
	touch NEWS AUTHORS ChangeLog                                 &&
	autoreconf -fi                                               &&

	./configure --prefix=/usr --disable-static &&
	make
		make DESTDIR=$PKG install
}
