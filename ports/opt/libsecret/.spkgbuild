# description : libsecret
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glib gobject-introspection libgcrypt gnutls vala python3-gi_docgen docbook-xml docbook-xsl-nons libxslt valgrind
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libsecret
version=0.21.7
release=2
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	prt-get isinst bash-completion || \
	  PKGMK_LIBSECRET+=' -D bash_completion=disabled'
	prt-get isinst docbook-xsl || PKGMK_LIBSECRET+=' -D manpage=false'
	prt-get isinst vala || PKGMK_LIBSECRET+=' -D vapi=false'

	meson setup build . $PKGMK_LIBSECRET \
	  --prefix=/usr \
	  --buildtype=plain \
	  --wrap-mode nodownload \
	  -D b_lto=true \
	  -D b_pie=true \
	  -D gtk_doc=false
	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install -C build

	rm -rf "$PKG/usr/share/locale"
}
