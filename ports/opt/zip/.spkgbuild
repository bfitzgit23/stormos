# description : The Zip package contains Zip utilities. These are useful for compressing files into ZIP archives.
# homepage    : https://downloads.sourceforge.net/infozip/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=zip
version=3.0
release=1
source="https://downloads.sourceforge.net/infozip/${name}${version//./}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -i '205 s/CC=gcc/CC="gcc -std=gnu89"/' unix/Makefile
	make -f unix/Makefile generic_gcc
	make -f unix/Makefile INSTALL=install prefix=$PKG/usr MANDIR=$PKG/usr/share/man/man1 install
}
