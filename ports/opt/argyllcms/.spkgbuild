# description : An ICC compatible color management system with support for different colorimeter hardware
# homepage    : https://www.argyllcms.com/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : ftjam libpng libtiff libxinerama libxrandr libxxf86vm
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=argyllcms
version=3.5.0
release=2
source="https://www.argyllcms.com/Argyll_V${version}_src.zip"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -i 's:^TEST=="/lib/udev/usb-db", IMPORT{program}="usb-db %p":IMPORT{builtin}="hwdb --subsystem=usb":' usb/55-Argyll.rules
	echo "LINKFLAGS += ${LDFLAGS} ;" >> Jamtop
	CCOPTFLAG="$CFLAGS"
	jam -q -fJambase ${MAKEFLAGS} -sPREFIX=/usr -sDESTDIR=$PKG -sREFSUBDIR=share/argyllcms/ref all
	jam -q -fJambase ${MAKEFLAGS} -sPREFIX=/usr -sDESTDIR=$PKG -sREFSUBDIR=share/argyllcms/ref install

	rm $PKG/usr/bin/License.txt
}
