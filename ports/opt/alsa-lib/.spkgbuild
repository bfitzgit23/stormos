# description : ALSA libraries
# homepage    : http://www.alsa-project.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=alsa-lib
version=1.2.16.1
release=1
source="https://www.alsa-project.org/files/pub/lib/$name-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
		./configure &&
	make
	#make doc
		make DESTDIR=$PKG install

	#install -v -d -m755 $PKG/usr/share/doc/$name-$version/html/search &&
	#install -v -m644 doc/doxygen/html/*.* \
	#                $PKG/usr/share/doc/$name-$version/html &&
	#install -v -m644 doc/doxygen/html/search/* \
	#                $PKG/usr/share/doc/$name-$version/html/search
}
