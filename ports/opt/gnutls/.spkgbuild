# description : Secure communications library implementing TLS, DTLS, and related protocols
# homepage    : https://gnutls.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libunistring nettle p11-kit libtasn1
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gnutls
version=3.8.13
release=1
source="https://mirrors.dotsrc.org/gcrypt/$name/v${version:0:3}/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	local configure_options=(
	--prefix=/usr
	--docdir=/usr/share/doc/$name-$version
	--with-default-trust-store-pkcs11=pkcs11:
	)
	if pkgconf --exists libbrotlienc 2>/dev/null; then
	    configure_options+=(--with-brotli)
	else
	    configure_options+=(--without-brotli)
	fi

	if pkgconf --exists libidn2 2>/dev/null; then
	    configure_options+=(--with-idn)
	else
	    configure_options+=(--without-idn)
	fi

	./configure "${configure_options[@]}"

	make
	make DESTDIR="$PKG" install

	rm -rf \
	    "$PKG/usr/share/doc" \
	    "$PKG/usr/share/info" \
	    "$PKG/usr/share/locale"
}
