# description : liba52 is a free library for decoding ATSC A/52 (also known as AC-3) streams. The A/52 standard is used in a variety of applications, including digital television and DVD.
# homepage    : https://liba52.sourceforge.net/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=liba52
version=0.8.0
release=1
source="https://distfiles.adelielinux.org/source/a52dec/a52dec-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		./configure --prefix=/usr \
	            --mandir=/usr/share/man \
	            --enable-shared \
	            --disable-static \
	            CFLAGS="${CFLAGS:--g -O2} $([ $(uname -m) = x86_64 ] && echo -fPIC)" &&
	make
		make DESTDIR=$PKG install
	cp liba52/a52_internal.h $PKG/usr/include/a52dec &&
	install -v -m644 -D doc/liba52.txt \
	    $PKG/usr/share/doc/liba52-0.7.4/liba52.txt
}
