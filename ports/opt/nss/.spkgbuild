# description : Mozilla Network Security Services (NSS)
# homepage    : https://firefox-source-docs.mozilla.org/security/nss/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : nspr sqlite zlib
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=nss
version=3.129
release=1
source="https://archive.mozilla.org/pub/security/nss/releases/NSS_${version//./_}_RTM/src/nss-$version.tar.gz nss-config.in nss.pc.in nss-softokn.pc.in nss-util.pc.in"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cd nss || return 1

	make BUILD_OPT=1 \
	    NSPR_INCLUDE_DIR=/usr/include/nspr \
	    USE_SYSTEM_ZLIB=1 \
	    ZLIB_LIBS=-lz \
	    NSS_ENABLE_WERROR=0 \
	    USE_64=1 \
	    NSS_USE_SYSTEM_SQLITE=1 || return 1

	cd ../dist || return 1

	install -d "$PKG/usr/bin" "$PKG/usr/include/nss" "$PKG/usr/lib/pkgconfig" || return 1
	install -m755 Linux*/lib/*.so "$PKG/usr/lib" || return 1
	install -m644 Linux*/lib/*.chk "$PKG/usr/lib" || return 1
	cp -RL public/nss/* "$PKG/usr/include/nss" || return 1
	cp -RL private/nss/* "$PKG/usr/include/nss" || return 1

	# These tools are part of the maintained NSS package contract.  modutil is
	# required for PKCS#11 module/trust-store diagnostics and was previously
	# missing from BFSOS.
	for tool in certutil modutil pk12util; do
	    test -x "Linux"*/bin/$tool || return 1
	    install -m755 Linux*/bin/$tool "$PKG/usr/bin/$tool" || return 1
	done

	install -m755 "$SRC/nss-config.in" "$PKG/usr/bin/nss-config" || return 1
	sed -i "s/@VERSION@/$version/g" "$PKG/usr/bin/nss-config" || return 1

	nspr_version=$(pkg-config --modversion nspr) || return 1
	nss_libs='-L/usr/lib -lssl3 -lsmime3 -lnss3 -lnssutil3'
	nss_cflags='-I/usr/include/nss'

	sed "$SRC/nss.pc.in" \
	    -e 's,%prefix%,/usr,g' \
	    -e 's,%exec_prefix%,/usr,g' \
	    -e 's,%libdir%,/usr/lib,g' \
	    -e 's,%includedir%,/usr/include/nss,g' \
	    -e "s,%NSS_VERSION%,$version,g" \
	    -e "s,%NSPR_VERSION%,$nspr_version,g" \
	    -e "s,%FULL_NSS_LIBS%,$nss_libs,g" \
	    -e "s,%FULL_NSS_CFLAGS%,$nss_cflags,g" \
	    > "$PKG/usr/lib/pkgconfig/nss.pc" || return 1

	sed "$SRC/nss-util.pc.in" \
	    -e 's,%prefix%,/usr,g' \
	    -e 's,%exec_prefix%,/usr,g' \
	    -e 's,%libdir%,/usr/lib,g' \
	    -e 's,%includedir%,/usr/include/nss,g' \
	    -e "s,%NSS_VERSION%,$version,g" \
	    -e "s,%NSPR_VERSION%,$nspr_version,g" \
	    > "$PKG/usr/lib/pkgconfig/nss-util.pc" || return 1

	sed "$SRC/nss-softokn.pc.in" \
	    -e 's,%prefix%,/usr,g' \
	    -e 's,%exec_prefix%,/usr,g' \
	    -e 's,%libdir%,/usr/lib,g' \
	    -e 's,%includedir%,/usr/include/nss,g' \
	    -e "s,%NSS_VERSION%,$version,g" \
	    -e "s,%NSPR_VERSION%,$nspr_version,g" \
	    -e "s,%NSSUTIL_VERSION%,$version,g" \
	    > "$PKG/usr/lib/pkgconfig/nss-softokn.pc" || return 1
	post_build || return 1
}

post_build() {
    # p11-kit owns libnssckbi.so so NSS consumers use the system trust store.
    rm -f "$PKG/usr/lib/libnssckbi.so"
}
