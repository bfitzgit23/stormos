# description : GIO-style APIs for desktop portals
# homepage    : https://github.com/flatpak/libportal
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glib gobject-introspection gtk3 gtk4 meson ninja
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libportal
version=0.10.0
release=2
source="https://github.com/flatpak/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build \
	    --prefix=/usr \
	    --buildtype=release \
	    -D vapi=false \
	    -D docs=false || return 1
	meson compile -C build || return 1
	DESTDIR="$PKG" meson install --no-rebuild -C build || return 1
}
