# description : ISO Country/Language/Currency codes
# homepage    : https://salsa.debian.org/iso-codes-team/iso-codes
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gettext python3 meson
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=iso-codes
version=4.20.1
release=6
source="https://deb.debian.org/debian/pool/main/i/iso-codes/iso-codes_${version}.orig.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	    --prefix=/usr \
	    --buildtype=release \
	    --wrap-mode=nodownload &&

	meson compile -C build -j ${JOBS:-1} &&

	DESTDIR="$PKG" meson install -C build &&

	rm -rf "$PKG/usr/share/locale"
}
