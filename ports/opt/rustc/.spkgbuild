# description : Rust compiler and Cargo toolchain
# homepage    : https://www.rust-lang.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake curl ninja python3
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=rustc
version=1.98.1
release=3
source="https://static.rust-lang.org/dist/rustc-$version-src.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	local prefix="/opt/rustc-$version"
	local i686_cc="$PWD/.bfs-i686-gcc"
	local i686_cxx="$PWD/.bfs-i686-g++"

	#
	# BFSOS uses a multilib GCC rather than a separate i686 cross compiler.
	# Rust bootstrap expects a compiler executable for each target, so provide
	# small wrappers which force the 32-bit ABI.
	#
	cat > "$i686_cc" <<'EOF_CC'
#!/bin/sh
exec /usr/bin/gcc -m32 "$@"
EOF_CC

	cat > "$i686_cxx" <<'EOF_CXX'
#!/bin/sh
exec /usr/bin/g++ -m32 "$@"
EOF_CXX

	chmod +x "$i686_cc" "$i686_cxx"

	cat > bootstrap.toml <<EOF_BOOTSTRAP
change-id = "ignore"

[llvm]
download-ci-llvm = false
link-shared = false
ninja = true

[build]
docs = false
locked-deps = true
tools = ["cargo", "clippy", "rustdoc", "rustfmt"]
target = [
    "x86_64-unknown-linux-gnu",
    "i686-unknown-linux-gnu",
]

[install]
prefix = "$prefix"
docdir = "share/doc/rustc-$version"

[rust]
channel = "stable"
lld = false
lto = "thin"
codegen-units = 1
codegen-tests = false

[target.x86_64-unknown-linux-gnu]
cc = "/usr/bin/gcc"
cxx = "/usr/bin/g++"
ar = "/usr/bin/gcc-ar"
ranlib = "/usr/bin/gcc-ranlib"
linker = "/usr/bin/gcc"

[target.i686-unknown-linux-gnu]
cc = "$i686_cc"
cxx = "$i686_cxx"
ar = "/usr/bin/gcc-ar"
ranlib = "/usr/bin/gcc-ranlib"
linker = "$i686_cc"
EOF_BOOTSTRAP

	python3 x.py build || return 1

	DESTDIR="$PKG" python3 x.py install || return 1

	test -x "$PKG$prefix/bin/rustc" || {
	    echo "ERROR: rustc was not installed into package staging tree"
	    return 1
	}

	test -x "$PKG$prefix/bin/cargo" || {
	    echo "ERROR: cargo was not installed into package staging tree"
	    return 1
	}

	#
	# BFSOS multilib requires the 32-bit Rust standard library.
	#
	test -d "$PKG$prefix/lib/rustlib/i686-unknown-linux-gnu/lib" || {
	    echo "ERROR: i686 Rust target was not installed"
	    return 1
	}

	ls "$PKG$prefix/lib/rustlib/i686-unknown-linux-gnu/lib"/libstd-*.rlib \
	    >/dev/null 2>&1 || {
	    echo "ERROR: i686 Rust standard library is missing"
	    return 1
	}

	install -d "$PKG/opt"
	ln -sfn "rustc-$version" "$PKG/opt/rustc"

	install -d "$PKG/usr/bin"

	for tool in \
	    rustc \
	    cargo \
	    rustdoc \
	    rustfmt \
	    cargo-fmt \
	    cargo-clippy \
	    clippy-driver
	do
	    if [ -x "$PKG$prefix/bin/$tool" ]; then
	        ln -sfn "/opt/rustc/bin/$tool" "$PKG/usr/bin/$tool"
	    fi
	done
}
