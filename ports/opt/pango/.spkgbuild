# description : A library for layout and rendering of text
# homepage    : https://www.gtk.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : fontconfig freetype harfbuzz fribidi
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=pango
version=1.58.2
release=2
source="https://download.gnome.org/sources/$name/${version:0:4}/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
		--prefix=/usr \
		--buildtype=plain \
		--wrap-mode nodownload \
		-D b_lto=true \
		-D b_pie=true \
		-D introspection=enabled
	meson compile -C build -j ${JOBS:-1}
	DESTDIR=$PKG meson install -C build
}
