# description : Lightweight NTP client/server used by the BFSOS live environment
# homepage    : https://chrony-project.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gnutls libcap libedit libseccomp nettle
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=chrony
version=4.9
release=2
build_opt="--with-user=chrony"
source="https://chrony-project.org/releases/chrony-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
    install -d "$PKG/etc" "$PKG/usr/lib/systemd/system" \
        "$PKG/usr/lib/sysusers.d" "$PKG/usr/lib/tmpfiles.d" || return 1

    cat > "$PKG/etc/chrony.conf" <<'EOC'
pool pool.ntp.org iburst

driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync

# NetworkManager may drop transient source fragments here on live systems.
sourcedir /run/chrony-dhcp
EOC

    cat > "$PKG/usr/lib/sysusers.d/chrony.conf" <<'EOC'
u chrony - "chrony time synchronization" /var/lib/chrony
EOC

    cat > "$PKG/usr/lib/tmpfiles.d/chrony.conf" <<'EOC'
d /var/lib/chrony 0750 chrony chrony -
d /run/chrony-dhcp 0755 chrony chrony -
EOC

    cat > "$PKG/usr/lib/systemd/system/chronyd.service" <<'EOC'
[Unit]
Description=chrony NTP client/server
After=network.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/sbin/chronyd -n
ExecReload=/usr/bin/chronyc reload sources

[Install]
WantedBy=multi-user.target
EOC
}
