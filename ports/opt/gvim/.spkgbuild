# description : GTK version of the vim editor
# homepage    : https://www.vim.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gtk3 vim libxt
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gvim
version=9.2.1036
release=1
source="https://github.com/vim/vim/archive/v${version}/vim-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cd src

	sed -i '/^CFLAGS/d' Makefile

	./configure \
		--prefix=/usr \
		--with-vim-name=gvim \
		--with-x=yes \
		--enable-gui=gtk3 \
		--enable-multibyte \
		--enable-cscope \
		--disable-gpm \
		--disable-nls

	make VIMRTDIR=
	make VIMRTDIR= DESTDIR=$PKG installvimbin install-icons

	sed -ri '/\[.+\]=/d' $PKG/usr/share/applications/*.desktop
}
