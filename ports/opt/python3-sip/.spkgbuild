# description : SIP bindings generator used by PyQt
# homepage    : https://www.riverbankcomputing.com/software/sip/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : python3-build python3-installer python3-packaging python3-setuptools python3-wheel
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=python3-sip
version=6.10.0
release=2
source="https://files.pythonhosted.org/packages/source/s/sip/sip-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	python3 -m build --wheel --skip-dependency-check --no-isolation || return 1
	python3 -m installer --compile-bytecode 2 --destdir="$PKG" dist/*.whl || return 1
}
