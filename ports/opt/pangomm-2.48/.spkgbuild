# description : C++ interface to pango
# homepage    : https://gitlab.gnome.org/GNOME/pangomm
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cairomm glibmm-2.68 pango
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=pangomm-2.48
version=2.56.2
release=3
source="https://ftp.gnome.org/pub/GNOME/sources/${name%-*}/${version%.*}/${name%-*}-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build \
	  --prefix=/usr \
	  --buildtype=plain \
	  --wrap-mode nodownload \
	  -D b_lto=true \
	  -D b_pie=true
	meson compile -C build
	DESTDIR=$PKG meson install -C build
}
