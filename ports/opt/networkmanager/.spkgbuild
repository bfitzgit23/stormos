# description : Core NetworkManager daemon, nmcli, nm-online and nmtui
# homepage    : https://networkmanager.dev/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : curl iptables libndp libpsl newt nss polkit systemd wpa_supplicant
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=networkmanager
version=1.58.1
release=2
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/$version/downloads/NetworkManager-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	grep -rl '^#!.*python$' . |
	    xargs -r sed -i '1s/python$/python3/' || return 1

	meson setup build \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dlibaudit=no \
	    -Dnmtui=true \
	    -Dovs=false \
	    -Dppp=false \
	    -Dnbft=false \
	    -Dselinux=false \
	    -Dqt=false \
	    -Dsession_tracking=systemd \
	    -Dnm_cloud_setup=false \
	    -Dclat=false \
	    -Dmodem_manager=false \
	    -Dintrospection=false \
	    -Dvapi=false \
	    -Ddocs=false || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1

	DESTDIR="$PKG" meson install -C build || return 1

	install -d "$PKG/etc/NetworkManager/conf.d" || return 1

	cat > "$PKG/etc/NetworkManager/NetworkManager.conf" <<'EOC'
[main]
plugins=keyfile
EOC
}
