# description : BFSOS OpenRC service scripts
# homepage    : https://github.com/OpenRC/openrc
# maintainer  : BFSOS maintainers
# depends     : openrc dbus networkmanager acpid bluez gpm chrony pipewire wireplumber
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=openrc-init-scripts
version=4
release=1
source="networkmanager acpid bluetooth dbus gpm chronyd cups sshd samba avahi-daemon nftables rsyncd krb5-kdc krb5-kadmind wpa_supplicant bfs-kernel-finalize sddm lightdm plasmalogin virtlogd libvirtd pipewire.desktop pipewire-pulse.desktop wireplumber.desktop"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	install -d -m 0755 "$PKG/etc/init.d" \
	                  "$PKG/etc/xdg/autostart" || return 1

	# SysV-style daemon services live in /etc/init.d.  Optional services
	# (cups, sshd, samba, avahi-daemon, nftables, rsyncd, Kerberos,
	# wpa_supplicant, virtlogd, libvirtd and the display managers) install
	# their scripts unconditionally; they are only enabled by an admin or by
	# the installer service list, and fail cleanly when the matching package
	# is not installed.  Enable with e.g.:
	#   rc-update add nftables default
	#   rc-update add sddm default   (after configuring the VT/inittab)
	for service in networkmanager acpid bluetooth dbus gpm chronyd \
	               cups sshd samba avahi-daemon nftables rsyncd \
	               krb5-kdc krb5-kadmind wpa_supplicant \
	               bfs-kernel-finalize sddm lightdm plasmalogin \
	               virtlogd libvirtd; do
	    install -m 0755 "$service" "$PKG/etc/init.d/$service" || return 1
	done

	# PipeWire session stack is per-user; without a per-user service manager
	# it is launched by the desktop session from XDG autostart (as documented
	# by LFS/BLFS and the Gentoo OpenRC wiki).
	for entry in pipewire.desktop pipewire-pulse.desktop wireplumber.desktop; do
	    install -m 0644 "$entry" "$PKG/etc/xdg/autostart/$entry" || return 1
	done
}
