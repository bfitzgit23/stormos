# description : The JasPer Project is an open-source initiative to provide a free software-based reference implementation of the JPEG-2000 codec.
# homepage    : https://github.com/jasper-software/jasper/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake libjpeg-turbo
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=jasper
version=4.2.9
release=2
source="https://github.com/jasper-software/$name/archive/version-$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	mkdir BUILD &&
	cd    BUILD &&

	cmake -DCMAKE_INSTALL_PREFIX=/usr    \
	      -DCMAKE_BUILD_TYPE=Release     \
	      -DCMAKE_SKIP_INSTALL_RPATH=YES \
	      -DJAS_ENABLE_DOC=NO            \
	      -DALLOW_IN_SOURCE_BUILD=YES    \
	      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/$name-$version \
	      ..  &&

	make
		make DESTDIR=$PKG install
}
