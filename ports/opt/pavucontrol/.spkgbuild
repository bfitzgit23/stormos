# description : GTK volume control for PulseAudio-compatible sound servers
# homepage    : https://freedesktop.org/software/pulseaudio/pavucontrol/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gtkmm json-glib libsigc++ pulseaudio
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=pavucontrol
version=6.2
release=2
build_opt=(
    -Dlynx=disabled
)
source="https://www.freedesktop.org/software/pulseaudio/pavucontrol/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}

pre_build() {
    if prt-get isinst libcanberra >/dev/null 2>&1; then
        build_opt+=( -Daudio-feedback=enabled )
    else
        build_opt+=( -Daudio-feedback=disabled )
    fi
}
