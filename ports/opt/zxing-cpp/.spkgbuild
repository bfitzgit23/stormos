# description : C++ barcode image processing library
# homepage    : https://github.com/zxing-cpp/zxing-cpp
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=zxing-cpp
version=3.1.1
release=2
build_opt="-DCMAKE_INSTALL_PREFIX=/usr
           -DCMAKE_BUILD_TYPE=Release
           -DZXING_C_API=OFF
           -DZXING_EXAMPLES=OFF
           -DZXING_EXAMPLES_QT=OFF
           -DZXING_BLACKBOX_TESTS=OFF
           -DZXING_UNIT_TESTS=OFF
           -DZXING_PYTHON_MODULE=OFF
           -DZXING_READERS=ON
           -DZXING_WRITERS=BOTH"
source="https://github.com/zxing-cpp/zxing-cpp/releases/download/v$version/zxing-cpp-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
