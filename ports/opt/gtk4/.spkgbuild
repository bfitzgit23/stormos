# description : gtk4
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : fribidi gdk-pixbuf graphene iso-codes libepoxy libxkbcommon pango gobject-introspection python3-gobject wayland-protocols glib colord cups python3-docutils python3-gi_docgen vulkan-loader gst-plugins-bad gst-plugins-ugly shaderc sassc
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gtk4
version=4.24.0
release=1
build_opt="--prefix=/usr
            --buildtype=release
            -Dbroadway-backend=true
            -Dintrospection=enabled
            -Dvulkan=enabled
	    -Dbuild-tests=false
	    -Dbuild-testsuite=false
            -Dbuild-examples=false
            -Dbuild-demos=false"
source="https://gitlab.gnome.org/GNOME/gtk/-/archive/$version/gtk-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
