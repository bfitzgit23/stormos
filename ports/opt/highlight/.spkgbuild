# description : highlight
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : boost lua
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=highlight
version=4.21
release=5
source="http://www.andre-simon.de/zip/${name}-${version}.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -i '/GZIP/s/^/#/' makefile || return 1

	# BFSOS ships Highlight as the CLI syntax-highlighter.  The optional Qt5
	# GUI is intentionally omitted so packages such as Evolution do not pull
	# the legacy Qt5 stack into an otherwise GTK/GNOME installation.
	make || return 1

	mkdir -p "${PKG}/usr/share/doc/${name}-${version}" || return 1
	make \
	    DESTDIR="${PKG}" \
	    doc_dir=/usr/share/doc/${name}-${version}/ \
	    install || return 1
}
