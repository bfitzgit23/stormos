# description : C++ wrapper for the cairo graphics library.
# homepage    : http://cairographics.org/cairomm/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cairo libsigc++2
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=cairomm-1.0
version=1.14.6
release=4
source="https://cairographics.org/releases/cairomm-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup bld . \
	  --prefix=/usr \
	  --buildtype=release \
	  -D build-tests=false \
	  -D build-documentation=false \
	  -D b_lto=true \
	  -D b_pie=true

	ninja -C bld -j ${JOBS:-1}
	DESTDIR=$PKG ninja -C bld install
}
