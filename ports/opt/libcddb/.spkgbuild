# description : libcddb
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# keep_static is implicit here: scratchpkg keeps *.a files.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libcddb
version=1.3.2
release=1
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.bz2 switch-default-server-to-gnudb.org.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	CFLAGS+=" -Wno-error=implicit-int -Wno-error=incompatible-pointer-types"
		./configure --prefix=/usr \
			--without-cdio

		make
		make DESTDIR=$PKG install
}

pre_build() {
sed -e '/DEFAULT_SERVER/s/freedb.org/gnudb.gnudb.org/' \
    -e '/DEFAULT_PORT/s/888/&0/'                       \
    -i include/cddb/cddb_ni.h                          &&
sed '/^Genre:/s/Trip-Hop/Electronic/' -i tests/testdata/920ef00b.txt &&
sed '/DISCID/i# Revision: 42'         -i tests/testcache/misc/12340000
}
