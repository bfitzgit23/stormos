# description : GLib-based library for talking to WWAN modems using the Mobile Broadband Interface Model (MBIM) protocol.
# homepage    : https://gitlab.freedesktop.org/mobile-broadband/libmbim
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glib meson ninja
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libmbim
version=1.34.0
release=1
source="https://gitlab.freedesktop.org/mobile-broadband/libmbim/-/archive/$version/libmbim-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dgtk_doc=false \
	    -Dman=false || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1

	DESTDIR="$PKG" \
	    meson install -C build || return 1
}
