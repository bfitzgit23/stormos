# description : Libraries and utilities used for parsing XML files.
# homepage    : https://gitlab.gnome.org/GNOME/libxml2
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : doxygen
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libxml2
version=2.15.4
release=4
build_opt=(
    --prefix=/usr
    --sysconfdir=/etc
    --with-history
    --with-python=yes
    --disable-static
)
source="https://download.gnome.org/sources/libxml2/${version%.*}/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	./configure "${build_opt[@]}" || return 1
	make || return 1
	make DESTDIR="$PKG" install || return 1
	post_build || return 1
}

post_build() {
    find "$PKG" -type f -name '*.la' -delete

    rm -rf \
        "$PKG/usr/share/doc" \
        "$PKG/usr/share/info"
}
