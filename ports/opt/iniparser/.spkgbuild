# description : ini file parser
# homepage    : https://github.com/ndevilla/iniparser
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : chrpath cmake
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=iniparser
version=4.2.6
release=1
source="https://github.com/ndevilla/iniparser/archive/v$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cmake -S . -B build \
	    -DCMAKE_INSTALL_PREFIX=/usr \
	    -DCMAKE_INSTALL_LIBDIR=lib \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DBUILD_TESTING=OFF \
	    -DBUILD_EXAMPLES=OFF \
	    -DBUILD_DOCS=OFF \
	    -DBUILD_SHARED_LIBS=ON \
	    -DBUILD_STATIC_LIBS=OFF \
	    -Wno-dev || return 1

	cmake --build build -j "${JOBS:-1}" || return 1

	DESTDIR="$PKG" cmake --install build || return 1

	# Preserve BFSOS's historical flat-header compatibility.
	if [ -d "$PKG/usr/include/iniparser" ]; then
	    for h in "$PKG"/usr/include/iniparser/*.h; do
	        [ -e "$h" ] || continue
	        ln -sf "iniparser/$(basename "$h")" \
	            "$PKG/usr/include/$(basename "$h")" || return 1
	    done
	fi
}
