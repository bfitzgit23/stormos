# description : A multi-platform toolkit for creating graphical user interfaces
# homepage    : https://www.gtk.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : at-spi2-core gdk-pixbuf libepoxy pango libxkbcommon
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gtk3
version=3.24.52
release=4
build_opt=(
  -Dman=true
  -Dbroadway_backend=true
  -Dtests=false
  -Dinstalled_tests=false
)
source="https://download.gnome.org/sources/gtk/3.24/gtk-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}

pre_build() {
  if ! prt-get isinst colord >/dev/null 2>&1; then
    build_opt+=(
      -Dcolord=no
    )
  fi

  if prt-get isinst libxkbcommon >/dev/null 2>&1 &&
     prt-get isinst wayland-protocols >/dev/null 2>&1; then
    build_opt+=(
      -Dwayland_backend=true
    )
  else
    build_opt+=(
      -Dwayland_backend=false
    )
  fi
}
