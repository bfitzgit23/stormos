# description : C runtime (crt) for mingw-w64 toolchain
# homepage    : https://www.mingw-w64.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# keep_static is implicit here: scratchpkg keeps *.a files.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=mingw-w64-crt
version=14.0.0
release=2
_binutils_version=2.47
_gcc_version=16.2.0
source="https://sourceforge.net/projects/mingw-w64/files/mingw-w64/mingw-w64-release/mingw-w64-v$version.tar.bz2 \ https://ftp.gnu.org/gnu/binutils/binutils-$_binutils_version.tar.xz \ https://gcc.gnu.org/pub/gcc/releases/gcc-$_gcc_version/gcc-$_gcc_version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	local bootstrap="$SRC/sysroot"
	local old_path="$PATH"
	local T OPTS

	# BFSOS pkgmk exports DESTDIR/INSTALLROOT aliases to $PKG globally.
	# Temporary bootstrap installs MUST NOT inherit those variables or the
	# private sysroot gets redirected into the package staging tree.
	bootstrap_make_install() {
	        env -u DESTDIR \
	            -u DEST_DIR \
	            -u INSTALLROOT \
	            -u install_root \
	            -u INSTALL_ROOT \
	            "$@"
	}

	# Always build a private bootstrap toolchain.  This keeps the CRT
	# package reproducible and avoids a circular dependency on an already
	# installed final mingw-w64-gcc package.  The bootstrap tree is
	# build-only and must never appear in $PKG.
	rm -rf "$bootstrap"
	mkdir -p "$bootstrap" || return 1

	for T in i686-w64-mingw32 x86_64-w64-mingw32; do
	        rm -rf "build-binutils-$T"
	        mkdir -p "build-binutils-$T" || return 1
	        cd "build-binutils-$T" || return 1

	        "../binutils-$_binutils_version/configure" \
	                --target="$T" \
	                --disable-multilib \
	                --prefix="$bootstrap" \
	                --with-sysroot="$bootstrap" || return 1

	        sed -i -e '/^MAKEINFO/s:=.*:= true:' Makefile || return 1
	        make || return 1
	        bootstrap_make_install make install || return 1
	        cd .. || return 1
	done

	PATH="$bootstrap/bin:$old_path"
	export PATH

	for T in i686-w64-mingw32 x86_64-w64-mingw32; do
	        rm -rf "build-headers-$T"
	        mkdir -p "build-headers-$T" || return 1
	        cd "build-headers-$T" || return 1

	        "../mingw-w64-v$version/mingw-w64-headers/configure" \
	                --host="$T" \
	                --prefix="$bootstrap/$T" || return 1

	        bootstrap_make_install make install || return 1
	        cd .. || return 1
	done

	# Retain the conventional /mingw sysroot alias used by the existing
	# MinGW bootstrap layout.
	ln -sfn "$bootstrap/x86_64-w64-mingw32" "$bootstrap/mingw" || return 1
	mkdir -p "$bootstrap/x86_64-w64-mingw32/lib" || return 1
	ln -sfn lib "$bootstrap/x86_64-w64-mingw32/lib64" || return 1

	for T in i686-w64-mingw32 x86_64-w64-mingw32; do
	        rm -rf "build-gcc-$T"
	        mkdir -p "build-gcc-$T" || return 1
	        cd "build-gcc-$T" || return 1

	        "../gcc-$_gcc_version/configure" \
	                --target="$T" \
	                --prefix="$bootstrap" \
	                --with-sysroot="$bootstrap" \
	                --disable-multilib \
	                --disable-nls \
	                --disable-werror \
	                --enable-languages=c \
	                --enable-threads=win32 || return 1

	        make all-gcc || return 1
	        bootstrap_make_install make install-gcc || return 1
	        cd .. || return 1
	done

	for T in i686-w64-mingw32 x86_64-w64-mingw32; do
	        test -x "$bootstrap/bin/$T-gcc" || {
	                echo "ERROR: $name: bootstrap compiler missing: $bootstrap/bin/$T-gcc" >&2
	                return 1
	        }
	done

	# Build the real CRT payload into $PKG.
	for T in x86_64-w64-mingw32 i686-w64-mingw32; do
	        rm -rf "build-$T"
	        mkdir -p "build-$T" || return 1
	        cd "build-$T" || return 1

	        if [ "$T" = "x86_64-w64-mingw32" ]; then
	                OPTS="--enable-lib64 --disable-lib32"
	        else
	                OPTS="--enable-lib32 --disable-lib64"
	        fi

	        CC="$bootstrap/bin/$T-gcc" \
	        AR="$bootstrap/bin/$T-ar" \
	        AS="$bootstrap/bin/$T-as" \
	        LD="$bootstrap/bin/$T-ld" \
	        NM="$bootstrap/bin/$T-nm" \
	        RANLIB="$bootstrap/bin/$T-ranlib" \
	        DLLTOOL="$bootstrap/bin/$T-dlltool" \
	        WINDRES="$bootstrap/bin/$T-windres" \
	        "../mingw-w64-v$version/mingw-w64-crt/configure" \
	                --prefix="/usr/$T" \
	                --host="$T" \
	                $OPTS \
	                --enable-wildcard \
	                --with-sysroot="$bootstrap" || return 1

	        make || return 1
	        make DESTDIR="$PKG" install || return 1
	        cd .. || return 1
	done

	PATH="$old_path"
	export PATH

	# Never allow the private bootstrap tree to become package payload.
	if [ -e "$PKG/var/cache/pkg/build-work" ]; then
	        echo "ERROR: $name: build-work/sysroot leaked into package staging" >&2
	        return 1
	fi

	# Require the core CRT/startup/import-library payload for both targets.
	for T in i686-w64-mingw32 x86_64-w64-mingw32; do
	        for f in \
	                dllcrt2.o \
	                crt2.o \
	                libmingw32.a \
	                libmingwthrd.a \
	                libmingwex.a \
	                libmoldname.a \
	                libmsvcrt.a \
	                libkernel32.a \
	                libuser32.a \
	                libadvapi32.a \
	                libshell32.a; do
	                test -f "$PKG/usr/$T/lib/$f" || {
	                        echo "ERROR: $name: missing /usr/$T/lib/$f" >&2
	                        return 1
	                }
	        done
	done
}
