# description : The Cdrdao package contains CD recording utilities. These are useful for burning a CD in disk-at-once mode.
# homepage    : https://downloads.sourceforge.net/cdrdao/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libao libvorbis libmad lame
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=cdrdao
version=1.2.6
release=2
source="https://downloads.sourceforge.net/$name/$name-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		./configure --prefix=/usr --mandir=/usr/share/man &&
	make
		make DESTDIR=$PKG install &&
	install -v -m755 -d $PKG/usr/share/doc/$name-$version &&
	install -v -m644 README $PKG/usr/share/doc/$name-$version
}
