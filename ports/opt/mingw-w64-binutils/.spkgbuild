# description : GNU binutils for mingw-w64 toolchain
# homepage    : https://www.gnu.org/software/binutils/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=mingw-w64-binutils
version=2.47
release=2
source="https://ftp.gnu.org/gnu/binutils/binutils-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	for T in {i686,x86_64}-w64-mingw32; do
		mkdir build-$T
		cd build-$T
		../configure \
			--prefix=/usr \
			--target=$T \
			--disable-nls \
			--disable-multilib
		sed -i -e '/^MAKEINFO/s:=.*:= true:' Makefile
		make
		make DESTDIR=$PKG install
		cd ..
	done
	rm -r $PKG/usr/share/info
	rm $PKG/usr/lib/bfd-plugins/libdep.so
}
