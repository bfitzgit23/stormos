# description : Video4Linux utilities and libraries for media devices
# homepage    : https://www.linuxtv.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : alsa-lib glu libjpeg-turbo
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=v4l-utils
version=1.32.0
release=5
source="https://www.linuxtv.org/downloads/$name/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	qt_opts=(
	    -Dqv4l2=disabled
	    -Dqvidcap=disabled
	)

	# qv4l2/qvidcap are optional. Prefer Qt6 if already installed,
	# otherwise allow Qt5 if it is already installed. Never pull Qt
	# into v4l-utils as a required dependency.
	if prt-get isinst qt6 >/dev/null 2>&1; then
	    echo "v4l-utils: Qt6 installed; enabling Qt GUI utilities"
	    qt_opts=(
	        -Dqv4l2=enabled
	        -Dqvidcap=enabled
	    )
	elif prt-get isinst qt5 >/dev/null 2>&1; then
	    echo "v4l-utils: Qt5 installed; enabling Qt GUI utilities"
	    qt_opts=(
	        -Dqv4l2=enabled
	        -Dqvidcap=enabled
	    )
	else
	    echo "v4l-utils: no Qt installed; GUI utilities disabled"
	fi

	meson setup build . \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dgconv=disabled \
	    -Ddoxygen-doc=disabled \
	    "${qt_opts[@]}" \
	    || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1

	DESTDIR="$PKG" meson install -C build || return 1

	# This file must NEVER be shipped by v4l-utils. It belongs to glibc.
	if [ -e "$PKG/usr/lib/gconv/gconv-modules" ]; then
	    echo "ERROR: v4l-utils unexpectedly staged usr/lib/gconv/gconv-modules"
	    return 1
	fi
}
