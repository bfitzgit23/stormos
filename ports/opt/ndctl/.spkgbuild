# description : Utility library for managing the libnvdimm and CXL subsystems in the Linux kernel
# homepage    : https://github.com/pmem/ndctl
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : iniparser json-c keyutils meson ninja libtraceevent
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=ndctl
version=85
release=1
source="ndctl-$version.tar.gz::https://github.com/pmem/ndctl/archive/refs/tags/v$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	local tracefs_opt="disabled"

	if prt-get isinst libtracefs >/dev/null 2>&1; then
	    tracefs_opt="enabled"
	fi

	meson setup build \
	    --prefix=/usr \
	    --buildtype=plain \
	    --wrap-mode=nodownload \
	    -Db_lto=false \
	    -Db_pie=true \
	    -Dversion-tag="$version" \
	    -Dasciidoctor=disabled \
	    -Ddocs=disabled \
	    -Dsystemd=enabled \
	    -Dlibtracefs="$tracefs_opt" || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1

	DESTDIR="$PKG" \
	    meson install -C build || return 1

	if ! prt-get isinst bash-completion >/dev/null 2>&1; then
	    rm -rf "$PKG/usr/share/bash-completion"
	fi
}
