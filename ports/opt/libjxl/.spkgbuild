# description : libjxl
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : brotli cmake giflib highway lcms2 libjpeg-turbo libpng gdk-pixbuf
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libjxl
version=0.12.0
release=1
build_opt="-D CMAKE_INSTALL_PREFIX=/usr
      -D CMAKE_BUILD_TYPE=Release
      -D BUILD_TESTING=OFF
      -D BUILD_SHARED_LIBS=ON
      -D JPEGXL_ENABLE_SKCMS=OFF
      -D JPEGXL_ENABLE_SJPEG=OFF
      -D JPEGXL_ENABLE_PLUGINS=ON
      -D JPEGXL_INSTALL_JARDIR=/usr/share/java
      -G Ninja .."
source="https://github.com/${name}/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
