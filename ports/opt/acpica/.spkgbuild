# description : ACPI Component Architecture iASL compiler
# homepage    : https://www.intel.com/content/www/us/en/developer/topic-technology/open/acpica/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : bison flex
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=acpica
version=20260408
release=3
source="https://github.com/open-acpica/acpica/releases/download/$version/acpica-unix-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	make iasl -j "${JOBS:-1}" || return 1

	mkdir -p "$PKG/usr/bin"
	install -m755 generate/unix/bin/iasl "$PKG/usr/bin/iasl" || return 1
}
