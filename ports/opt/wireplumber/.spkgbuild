# description : Session and policy manager for PipeWire
# homepage    : https://pipewire.pages.freedesktop.org/wireplumber/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glib pipewire systemd linux-pam lua
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=wireplumber
version=0.5.17
release=1
build_opt="--prefix=/usr --buildtype=release -Dsystem-lua=true"
source="https://gitlab.freedesktop.org/pipewire/$name/-/archive/$version/$name-$version.tar.gz 90-bfsos-audio.preset"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
    install -Dm644 "$SRC/90-bfsos-audio.preset" \
        "$PKG/usr/lib/systemd/user-preset/90-bfsos-audio.preset" || return 1
}
