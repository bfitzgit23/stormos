# description : EDK2 OVMF UEFI firmware for QEMU/KVM x86_64 guests
# homepage    : https://github.com/tianocore/edk2
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : acpica nasm python3
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=edk2-ovmf
version=202608
release=7
brotli_commit=e230f474b87134e8c6c85b630084c612057f253e
mbedtls_commit=0bebf8b8c7f07abe3571ded48a11aa907a1ffb20
openssl_commit=8cf17aaeb4599f8af87fefd810b5b5fee90fe69e
oniguruma_commit=4ef89209a239c1aea328cf13c05a2807e5c146d1
libfdt_commit=cfff805481bdea27f900c32698171286542b8d3c
mipisyst_commit=370b5944c046bab043dd8b133727b2135af7747a
libspdm_commit=f55cf6d48ec69b4ac60a63903e9c6a2cb0fd155d
tpm_commit=bc29a21d44b01396223c152a4834e52318591770
source="https://github.com/tianocore/edk2/archive/refs/tags/edk2-stable$version.tar.gz https://github.com/google/brotli/archive/$brotli_commit.tar.gz https://github.com/ARMmbed/mbedtls/archive/$mbedtls_commit.tar.gz https://github.com/openssl/openssl/archive/$openssl_commit.tar.gz https://github.com/kkos/oniguruma/archive/$oniguruma_commit.tar.gz https://github.com/devicetree-org/pylibfdt/archive/$libfdt_commit.tar.gz https://github.com/MIPI-Alliance/public-mipi-sys-t/archive/$mipisyst_commit.tar.gz https://github.com/DMTF/libspdm/archive/$libspdm_commit.tar.gz https://github.com/TrustedComputingGroup/TPM/archive/$tpm_commit.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	cd "$SRC/edk2-edk2-stable$version" || return 1

	export WORKSPACE="$PWD"
	export EDK_TOOLS_PATH="$PWD/BaseTools"

	make -C BaseTools -j "${JOBS:-1}" || return 1

	. edksetup.sh BaseTools || return 1

	command build \
	    -a X64 \
	    -t GCC \
	    -b RELEASE \
	    -p OvmfPkg/OvmfPkgX64.dsc \
	    -n "${JOBS:-1}" \
	    || return 1

	fvdir="$WORKSPACE/Build/OvmfX64/RELEASE_GCC/FV"

	test -f "$fvdir/OVMF_CODE.fd" || return 1
	test -f "$fvdir/OVMF_VARS.fd" || return 1

	mkdir -p "$PKG/usr/share/edk2/ovmf"

	install -m644 "$fvdir/OVMF_CODE.fd" \
	    "$PKG/usr/share/edk2/ovmf/OVMF_CODE.fd" || return 1

	install -m644 "$fvdir/OVMF_VARS.fd" \
	    "$PKG/usr/share/edk2/ovmf/OVMF_VARS.fd" || return 1

	# Register the BFSOS-maintained OVMF build as an additional libvirt/QEMU
	# firmware choice.  The 70- prefix deliberately leaves QEMU's bundled
	# 50-/60-edk2 descriptors at higher priority and does not replace them.
	mkdir -p "$PKG/usr/share/qemu/firmware" || return 1
	cat > "$PKG/usr/share/qemu/firmware/70-bfsos-ovmf-x86_64.json" <<'JSON'
{
    "description": "BFSOS-built OVMF UEFI firmware for x86_64",
    "interface-types": [
        "uefi"
    ],
    "mapping": {
        "device": "flash",
        "executable": {
            "filename": "/usr/share/edk2/ovmf/OVMF_CODE.fd",
            "format": "raw"
        },
        "nvram-template": {
            "filename": "/usr/share/edk2/ovmf/OVMF_VARS.fd",
            "format": "raw"
        }
    },
    "targets": [
        {
            "architecture": "x86_64",
            "machines": [
                "pc-i440fx-*",
                "pc-q35-*"
            ]
        }
    ],
    "features": [],
    "tags": []
}
JSON
}

pre_build() {
    edk2="$SRC/edk2-edk2-stable$version"

    rm -rf \
        "$edk2/BaseTools/Source/C/BrotliCompress/brotli" \
        "$edk2/MdeModulePkg/Library/BrotliCustomDecompressLib/brotli" \
        "$edk2/CryptoPkg/Library/MbedTlsLib/mbedtls" \
        "$edk2/CryptoPkg/Library/OpensslLib/openssl" \
        "$edk2/MdeModulePkg/Universal/RegularExpressionDxe/oniguruma" \
        "$edk2/MdePkg/Library/BaseFdtLib/libfdt" \
        "$edk2/MdePkg/Library/MipiSysTLib/mipisyst" \
        "$edk2/SecurityPkg/DeviceSecurity/SpdmLib/libspdm" \
        "$edk2/TcgTpmPkg/Library/TpmLib/TPM"

    cp -a "$SRC/brotli-$brotli_commit" \
        "$edk2/BaseTools/Source/C/BrotliCompress/brotli" || return 1

    cp -a "$SRC/brotli-$brotli_commit" \
        "$edk2/MdeModulePkg/Library/BrotliCustomDecompressLib/brotli" || return 1

    cp -a "$SRC/mbedtls-$mbedtls_commit" \
        "$edk2/CryptoPkg/Library/MbedTlsLib/mbedtls" || return 1

    cp -a "$SRC/openssl-$openssl_commit" \
        "$edk2/CryptoPkg/Library/OpensslLib/openssl" || return 1

    cp -a "$SRC/oniguruma-$oniguruma_commit" \
        "$edk2/MdeModulePkg/Universal/RegularExpressionDxe/oniguruma" || return 1

    cp -a "$SRC/pylibfdt-$libfdt_commit" \
        "$edk2/MdePkg/Library/BaseFdtLib/libfdt" || return 1

    cp -a "$SRC/public-mipi-sys-t-$mipisyst_commit" \
        "$edk2/MdePkg/Library/MipiSysTLib/mipisyst" || return 1

    cp -a "$SRC/libspdm-$libspdm_commit" \
        "$edk2/SecurityPkg/DeviceSecurity/SpdmLib/libspdm" || return 1

    cp -a "$SRC/TPM-$tpm_commit" \
        "$edk2/TcgTpmPkg/Library/TpmLib/TPM" || return 1
}
