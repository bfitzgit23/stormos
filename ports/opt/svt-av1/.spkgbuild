# description : Scalable Video Technology AV1 encoder
# homepage    : https://gitlab.com/AOMediaCodec/SVT-AV1
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake ninja nasm
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=svt-av1
version=4.2.0
release=1
source="https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v$version/SVT-AV1-v$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cmake -S . -B build -G Ninja \
	    -DCMAKE_INSTALL_PREFIX=/usr \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DCMAKE_SKIP_INSTALL_RPATH=ON \
	    -DBUILD_SHARED_LIBS=ON \
	    -Wno-dev || return 1
	ninja -C build || return 1
	DESTDIR="$PKG" ninja -C build install || return 1
}
