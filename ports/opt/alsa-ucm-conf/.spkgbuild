# description : ALSA Use Case Manager configuration files
# homepage    : https://github.com/alsa-project/alsa-ucm-conf
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : alsa-lib
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=alsa-ucm-conf
version=1.2.15.3
release=2
source="https://github.com/alsa-project/alsa-ucm-conf/archive/refs/tags/v$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# MSI MEG X870E GODLIKE (USB 0db0:e5c3) uses the Realtek
	# ALC408x USB audio UCM configuration.
	python3 - <<'PY'
from pathlib import Path

p = Path("ucm2/USB-Audio/USB-Audio.conf")
s = p.read_text()

old = "|d1d7|d6e7|e1f8))"
new = "|d1d7|d6e7|e1f8|e5c3))"

if "e5c3" not in s:
    if old not in s:
        raise SystemExit("ERROR: expected MSI ALC408x matcher not found")
    s = s.replace(old, new, 1)
    p.write_text(s)
PY

	install -d "$PKG/usr/share/alsa"

	cp -a ucm "$PKG/usr/share/alsa/"
	cp -a ucm2 "$PKG/usr/share/alsa/"
}
