# description : Collection of boot loaders for the Linux operating system
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : mtools
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=syslinux
version=6.03
release=1
skip_patch=1
source="http://www.kernel.org/pub/linux/utils/boot/$name/$name-$version.tar.xz $name-$version-sysmacros.patch $name-$version-stdio.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	export CFLAGS="$CFLAGS -fcommon"

	patch -p1 -i $SRC/$name-$version-sysmacros.patch
	patch -p1 -i $SRC/$name-$version-stdio.patch

	make OPTFLAGS="$CFLAGS" installer
	make OPTFLAGS="$CFLAGS" INSTALLROOT=$PKG MANDIR=/usr/share/man install
}
