# description : A multi-platform toolkit for creating graphical user interfaces
# homepage    : https://www.gtk.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : at-spi2-core gdk-pixbuf hicolor-icon-theme pango xorg-libs
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gtk
version=2.24.33
release=2
source="https://download.gnome.org/sources/gtk%2B/2.24/gtk%2B-2.24.33.tar.xz 0001-Lower-severity-of-XID-collision-warnings.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	 CFLAGS+=" -Wno-error=implicit-int -Wno-error=incompatible-pointer-types"
		sed -e 's#l \(gtk-.*\).sgml#& -o \1#' \
	    -i docs/{faq,tutorial}/Makefile.in      &&
	./configure --prefix=/usr --sysconfdir=/etc &&
	sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
		make DESTDIR=$PKG install
	cat > $PKG/gtkrc-2.0 << "EOF"
include "/usr/share/themes/Glider/gtk-2.0/gtkrc"
gtk-icon-theme-name = "hicolor"
EOF
	cat > $PKG/etc/gtk-2.0/gtkrc << "EOF"
include "/usr/share/themes/Clearlooks/gtk-2.0/gtkrc"
gtk-icon-theme-name = "elementary"
EOF
	post_build || return 1
}

post_build() {
    rm -f "$PKG/usr/bin/gtk-update-icon-cache"
}
