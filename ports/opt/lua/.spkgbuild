# description : Lightweight embeddable scripting language (Lua 5.4 compatibility line)
# homepage    : https://www.lua.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=lua
version=5.4.9
release=3
source="https://www.lua.org/ftp/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cat > lua.pc <<EOF_PC
V=5.4
R=$version

prefix=/usr
INSTALL_BIN=\${prefix}/bin
INSTALL_INC=\${prefix}/include
INSTALL_LIB=\${prefix}/lib
INSTALL_MAN=\${prefix}/share/man/man1
INSTALL_LMOD=\${prefix}/share/lua/\${V}
INSTALL_CMOD=\${prefix}/lib/lua/\${V}
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: Lua
Description: An Extensible Extension Language
Version: \${R}
Requires:
Libs: -L\${libdir} -llua -lm -ldl
Cflags: -I\${includedir}
EOF_PC

	# Upstream only builds liblua.a.  Build the objects as PIC and construct the
	# shared-library ABI locally instead of carrying a version-specific remote
	# compatibility patch tied to an older Lua release into this package.
	make linux MYCFLAGS="$CFLAGS -fPIC" || return 1
	(
	    cd src || exit 1
	    objects=$(ar t liblua.a | tr '\n' ' ')
	    ${CC:-cc} $LDFLAGS -shared -Wl,-soname,liblua.so.5.4 \
	        -o liblua.so.5.4.9 $objects -lm -ldl || exit 1
	    ln -sfn liblua.so.5.4.9 liblua.so.5.4
	    ln -sfn liblua.so.5.4 liblua.so
	) || return 1

	make DESTDIR="$PKG" \
	     INSTALL_TOP=$PKG/usr \
	     INSTALL_DATA="cp -d" \
	     INSTALL_MAN=$PKG/usr/share/man/man1 \
	     install || return 1

	rm -f "$PKG/usr/lib/liblua.a"
	install -m755 src/liblua.so.5.4.9 "$PKG/usr/lib/liblua.so.5.4.9" || return 1
	ln -sfn liblua.so.5.4.9 "$PKG/usr/lib/liblua.so.5.4"
	ln -sfn liblua.so.5.4 "$PKG/usr/lib/liblua.so"

	install -d "$PKG/usr/share/doc/$name-$version" || return 1
	cp -v doc/*.{html,css,png} "$PKG/usr/share/doc/$name-$version" || return 1
	install -m644 -D lua.pc "$PKG/usr/lib/pkgconfig/lua.pc" || return 1
}
