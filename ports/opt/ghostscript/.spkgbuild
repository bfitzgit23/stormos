# description : Postscript interpreter
# homepage    : https://www.ghostscript.com
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : fontconfig glib util-linux libxt libxext
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=ghostscript
version=10.08.0
release=1
source="https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs${version//./}/$name-$version.tar.xz https://downloads.sourceforge.net/sourceforge/gs-fonts/$name-fonts-std-8.11.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	export CFLAGS+=" -Wno-incompatible-pointer-types -Wno-int-conversion"
		prt-get isinst fontconfig && PKGMK_GHOSTSCRIPT+=' --enable-fontconfig'
		prt-get isinst freetype && PKGMK_GHOSTSCRIPT+=' --enable-freetype'
		prt-get isinst libjpeg-turbo libtiff && PKGMK_GHOSTSCRIPT+=' --enable-openjpeg --with-system-libtiff' && rm -r tiff jpeg
		prt-get isinst jbig2dec && PKGMK_GHOSTSCRIPT+=' --with-jbig2dec' && rm -r jbig2dec
		prt-get isinst openjpeg2 && PKGMK_GHOSTSCRIPT+=' --enable-openjpeg' && rm -r openjpeg
		prt-get isinst libXt libXext || PKGMK_GHOSTSCRIPT+=' --without-x'

		rm -rf zlib &&

	./configure --prefix=/usr           \
	            --disable-compile-inits \
	            --with-system-libtiff   &&

		make
		make DESTDIR=$PKG install-so install

		cd ijs

		./autogen.sh
		./configure --prefix=/usr --enable-shared
		make
		make DESTDIR=$PKG install

		cp -r $SRC/fonts $PKG/usr/share/ghostscript

		rm -r $PKG/usr/share/doc
		rm $PKG/usr/share/ghostscript/fonts/[CRT]*
		rm $PKG/usr/bin/ijs_{client,server}_example
}
