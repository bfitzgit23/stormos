# description : C implementation of Protocol Buffers
# homepage    : https://github.com/protobuf-c/protobuf-c
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : protobuf
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=protobuf-c
version=1.5.2
release=4
source="https://github.com/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.gz https://www.linuxfromscratch.org/patches/blfs/svn/protobuf-c-${version}-protobuf34_fix-1.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	CXXFLAGS="${CXXFLAGS:--O2 -g} -std=c++20" \
	./configure \
	    --prefix=/usr \
	    --disable-static || return 1

	make || return 1
	DESTDIR="$PKG" make install || return 1
}
