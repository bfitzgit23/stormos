# description : An OpenType text shaping engine
# homepage    : https://github.com/harfbuzz/harfbuzz
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cairo gobject-introspection graphite2 icu
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=harfbuzz
version=14.4.0
release=2
source="https://github.com/harfbuzz/harfbuzz/releases/download/$version/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dgraphite2=enabled \
	    -Dicu=enabled \
	    -Dtests=disabled || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" meson install -C build || return 1
}
