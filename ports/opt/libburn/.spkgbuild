# description : libburn is a library for writing preformatted data onto optical media: CD, DVD and BD (Blu-Ray).
# homepage    : https://files.libburnia-project.org
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : doxygen
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libburn
version=1.5.8
release=1
source="https://files.libburnia-project.org/releases/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		./configure --prefix=/usr --disable-static &&
	make
	doxygen doc/doxygen.conf
		make DESTDIR=$PKG install
	install -v -dm755 $PKG/usr/share/doc/$name-$version &&
	install -v -m644 doc/html/* $PKG/usr/share/doc/$name-$version
}
