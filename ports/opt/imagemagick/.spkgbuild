# description : imagemagick
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : xorg-libs llvm cups curl ffmpeg fftw p7zip wget xdg-utils xterm jasper lcms2 libgxps libjpeg-turbo libjxl libpng libraw librsvg libtiff libwebp openjpeg2 pango
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# scratchpkg rejects '-' in `version`; the upstream version 7.1.2-31 is kept verbatim in the source URLs below.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=imagemagick
version=7.1.2
release=1
build_opt="--prefix=/usr
            --sysconfdir=/etc
            --enable-hdri
            --with-modules
            --with-perl
            --disable-static"
source="https://download.imagemagick.org/releases/ImageMagick-7.1.2-31.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
