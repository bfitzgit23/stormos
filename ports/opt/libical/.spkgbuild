# description : The libical package contains an implementation of the iCalendar protocols and data formats.
# homepage    : https://github.com/libical
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake gobject-introspection vala
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libical
version=4.0.5
release=3
build_opt=(
  -DCMAKE_INSTALL_PREFIX=/usr
  -DCMAKE_BUILD_TYPE=Release
  -DLIBICAL_STATIC=NO
  -DLIBICAL_BUILD_DOCS=false
  -DLIBICAL_GOBJECT_INTROSPECTION=true
  -DLIBICAL_GLIB_VAPI=true
  -DLIBICAL_JAVA_BINDINGS=OFF
)
source="https://github.com/$name/$name/releases/download/v$version/$name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cmake -S . -B build "${build_opt[@]}"

	cmake --build build -j1

	DESTDIR="$PKG" cmake --install build
}
