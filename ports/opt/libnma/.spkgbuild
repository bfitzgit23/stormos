# description : Networkmanager GUI client library
# homepage    : https://gitlab.gnome.org/GNOME/libnma
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gcr gtk3 iso-codes networkmanager
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libnma
version=1.10.6
release=3
source="https://gitlab.gnome.org/GNOME/libnma/-/archive/$version/libnma-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	prt-get isinst gtk4 && PKGMK_LIBNMA+=' -D libnma_gtk4=true'
	prt-get isinst mobile-broadband-provider-info || PKGMK_LIBNMA+=' -D mobile_broadband_provider_info=false'
	#prt-get isinst vala || PKGMK_LIBNMA+=' -D vapi=false'
	PKGMK_LIBNMA+=' -D vapi=false'

	meson setup build . $PKGMK_LIBNMA \
	  --prefix=/usr \
	  --buildtype=plain \
	  --wrap-mode nodownload \
	  -D b_lto=true \
	  -D b_pie=true \
	  -D gtk_doc=false
	meson compile -C build
	DESTDIR=$PKG meson install -C build

	rm -r $PKG/usr/share/locale
}
