# description : A set of good-quality plugins for gstreamer under the LGPL.
# homepage    : https://gstreamer.freedesktop.org/modules/gst-plugins-good.html
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gst-plugins-base cairo flac gdk-pixbuf lame libsoup libsoup3 libvpx mpg123 nasm pulseaudio
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gst-plugins-good
version=1.28.7
release=2
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz gst-plugins-good-1.28.7-qt611-qquickwindow.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	  mkdir build &&
	cd    build &&

	meson setup ..            \
	      --prefix=/usr       \
	      --buildtype=release \
	      -Dpackage-origin=https://www.linuxfromscratch.org/blfs/view/systemd/ \
	      -Dpackage-name="GStreamer 1.28.7 BFSOS" &&
	ninja
	  DESTDIR=$PKG ninja install
}
