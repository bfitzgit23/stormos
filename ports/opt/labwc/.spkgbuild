# description : Lightweight Wayland stacking compositor inspired by Openbox
# homepage    : https://labwc.github.io/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : meson wlroots wayland wayland-protocols libinput libxkbcommon libxml2 glib cairo pango pixman libpng libdrm
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=labwc
version=0.20.2
release=1
source="https://github.com/labwc/labwc/archive/refs/tags/${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	    --prefix=/usr \
	    --buildtype=release \
	    --wrap-mode=nodownload \
	    -Dicon=disabled \
	    -Dtest=disabled || return 1

	meson compile -C build || return 1

	DESTDIR="$PKG" meson install -C build || return 1
}
