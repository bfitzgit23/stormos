# description : The lm_sensors package provides userspace support for the hardware monitoring drivers in the Linux kernel. This is useful for monitoring the temperature of the CPU and adjusting the performance of some hardware (such as cooling fans).
# homepage    : https://github.com/lm-sensors/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : which
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# scratchpkg rejects '-' in `version`; the upstream version 3-6-2 is kept verbatim in the source URLs below.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=lm-sensors
version=3
release=1
source="https://github.com/lm-sensors/$name/archive/V3-6-2/$name-3-6-2.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

		make PREFIX=/usr        \
	     BUILD_STATIC_LIB=0 \
	     MANDIR=/usr/share/man
	     make DESTDIR=$PKG PREFIX=/usr        \
	     BUILD_STATIC_LIB=0 \
	     MANDIR=/usr/share/man install &&

	install -v -m755 -d $PKG/usr/share/doc/lm_sensors-$version &&
	cp -rv              README INSTALL doc/* \
	                    $PKG/usr/share/doc/lm_sensors-$version
}
