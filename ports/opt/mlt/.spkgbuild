# description : MLT package is the Media Lovin Toolkit. It is an open source multimedia framework, designed and developed for television broadcasting. It provides a toolkit for broadcasters, video editors, media players, transcoders, web streamers and many more types of applications.
# homepage    : https://github.com/mltframework/mlt/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : ffmpeg frei0r-plugins libsamplerate qt6 rnnoise sdl2
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=mlt
version=7.40.0
release=7
source="https://github.com/mltframework/$name/releases/download/v$version/$name-$version.tar.gz https://www.linuxfromscratch.org/patches/blfs/svn/mlt-7.40.0-ffmpeg-9.0.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	mkdir -p build || return 1
	cd build || return 1

	cmake \
	    -DCMAKE_INSTALL_PREFIX=/usr \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DMOD_QT=OFF \
	    -DMOD_QT6=ON \
	    -DMOD_SOX=OFF \
	    -DMOD_MOVIT=OFF \
	    -DMOD_VIDSTAB=OFF \
	    -DMOD_JACKRACK=OFF \
	    -DMOD_RUBBERBAND=OFF \
	    -DMOD_RNNOISE=ON \
	    -Wno-author \
	    .. || return 1

	make -j${JOBS:-1} || return 1
	make DESTDIR="$PKG" install || return 1
}
