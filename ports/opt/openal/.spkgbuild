# description : Cross-platform 3D audio
# homepage    : https://github.com/kcat/openal-soft
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : alsa-lib
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=openal
version=1.25.2
release=2
source="https://github.com/kcat/openal-soft/archive/$version/openal-soft-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cmake -S . -B build -G Ninja \
	  -D CMAKE_INSTALL_PREFIX=/usr \
	  -D CMAKE_INSTALL_LIBDIR=lib \
	  -D CMAKE_BUILD_TYPE=Release \
	  -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	  -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	  -D ALSOFT_UTILS=ON \
	  -D ALSOFT_INSTALL_CONFIG=ON \
	  -D ALSOFT_INSTALL_HRTF_DATA=ON \
	  -D ALSOFT_INSTALL_UTILS=ON \
	  -D ALSOFT_EXAMPLES=OFF

	cmake --build build
	DESTDIR=$PKG cmake --install build
}
