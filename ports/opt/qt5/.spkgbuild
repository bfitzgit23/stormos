# description : Qt 5 compatibility framework (QtWebEngine packaged separately)
# homepage    : https://www.qt.io/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : alsa-lib bison dbus double-conversion flex glib gperf harfbuzz icu libinput libjpeg-turbo libmng libpng libtiff libwebp libxkbcommon mesa mtdev ninja openssl python3 sqlite xorg-libs xcb-util xcb-util-renderutil xcb-util-image xcb-util-keysyms xcb-util-wm xcb-util-cursor
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# keep_static is implicit here: scratchpkg keeps *.a files.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=qt5
version=5.15.19
release=13
source="https://download.qt.io/archive/qt/5.15/$version/single/qt-everywhere-opensource-src-$version.tar.xz qtbase-debian-patches.xzblob::https://deb.debian.org/debian/pool/main/q/qtbase-opensource-src/qtbase-opensource-src_5.15.19+dfsg-4.debian.tar.xz qtlocation-debian-patches.xzblob::https://deb.debian.org/debian/pool/main/q/qtlocation-opensource-src/qtlocation-opensource-src_5.15.19+dfsg-2.debian.tar.xz qtlocation-rapidjson-gcc16.patch.manual"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	export QT5PREFIX=/opt/qt5

	apply_qt5_compat_patches || return 1

	./configure \
	    -prefix "$QT5PREFIX" \
	    -sysconfdir /etc/xdg \
	    -confirm-license \
	    -opensource \
	    -release \
	    -dbus-linked \
	    -openssl-linked \
	    -system-harfbuzz \
	    -system-sqlite \
	    -skip qtwebengine \
	    -nomake examples \
	    -no-rpath \
	    -journald || return 1

	make -j "${JOBS:-1}" || return 1
	make -j1 INSTALL_ROOT="$PKG" install || return 1

	find "$PKG$QT5PREFIX" -name '*.prl' -exec sed -i '/^QMAKE_PRL_BUILD_DIR/d' {} \;

	install -d "$PKG/etc/ld.so.conf.d"
	printf '%s\n' '/opt/qt5/lib' > "$PKG/etc/ld.so.conf.d/qt5.conf"
	# Public compatibility tools stay versioned so Qt5 and Qt6 can coexist.
	# Libraries, headers, pkg-config and CMake metadata remain canonical under
	# /opt and are discovered through the BFSOS prefix environment instead of
	# ambiguous /usr mirrors.
	install -d "$PKG/usr/bin" || return 1
	for file in moc uic rcc qmake lconvert lrelease lupdate; do
	    test -x "$PKG/opt/qt5/bin/$file" || {
	        echo "qt5: expected compatibility tool missing: $file" >&2
	        return 1
	    }
	    ln -sfn "/opt/qt5/bin/$file" "$PKG/usr/bin/$file-qt5" || return 1
	done
}
