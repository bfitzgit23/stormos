# description : The Oil Runtime Compiler
# homepage    : https://gstreamer.freedesktop.org/projects/orc.html
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=orc
version=0.4.44
release=1
source="https://gstreamer.freedesktop.org/src/$name/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	  --prefix=/usr \
	  --buildtype=plain \
	  --wrap-mode nodownload \
	  -D b_lto=true \
	  -D b_pie=true \
	  -D benchmarks=disabled \
	  -D examples=disabled \
	  -D hotdoc=disabled \
	  -D tests=disabled || return 1

	meson compile -C build -j ${JOBS:-1} || return 1
	DESTDIR=$PKG meson install -C build || return 1
}
