#!/bin/sh
#
# BFSOS scratchpkg install script, generated from the CRUX scripts by scripts/bfs-ports-to-spkgbuild.py.
# scratchpkg calls this with $1 = pre-install|post-install|pre-upgrade|
# post-upgrade|pre-remove|post-remove, $2 = new version, $3 = old version.

case $1 in
	post-install)
		CATALOG=/etc/xml/catalog
		name=docbook-xml

		if [ ! -f "$CATALOG" ]; then
			mkdir -p /etc/xml
			xmlcatalog --noout --create "$CATALOG"
		fi

		xmlcatalog --noout --add "delegatePublic" \
			"-//OASIS//ENTITIES DocBook XML" \
			"file:///etc/xml/$name" $CATALOG

		xmlcatalog --noout --add "delegatePublic" \
			"-//OASIS//DTD DocBook XML" \
			"file:///etc/xml/$name" $CATALOG

		xmlcatalog --noout --add "delegateSystem" \
			"http://www.oasis-open.org/docbook/" \
			"file:///etc/xml/$name" $CATALOG

		xmlcatalog --noout --add "delegateURI" \
			"http://www.oasis-open.org/docbook/" \
			"file:///etc/xml/$name" $CATALOG
		;;
esac
