# description : D-Bus service that performs user authentication for Accounts-SSO clients
# homepage    : https://gitlab.com/accounts-sso/signond/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : qt6
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=signond
version=8.61
release=1
_commit=c8ad98249af541514ff7a81634d3295e712f1a39
source="https://gitlab.com/nicolasfella/$name/-/archive/$_commit/$name-$_commit.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	"$QT6DIR/bin/qmake" PREFIX=/usr LIBDIR=/usr/lib CONFIG+=rtti CONFIG+=release || return 1
	make -j${JOBS:-1} || return 1
	make INSTALL_ROOT="$PKG" install || return 1
	rm -rf "$PKG/usr/share/doc" || return 1
}
