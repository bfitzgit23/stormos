# description : Desktop notification library
# homepage    : https://gitlab.gnome.org/GNOME/libnotify
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gdk-pixbuf
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libnotify
version=0.8.8
release=4
source="https://ftp.gnome.org/pub/GNOME/sources/$name/${version%.*}/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dgtk_doc=false \
	    -Dman=false \
	    -Dtests=false || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" meson install -C build || return 1

	if [ -e "$PKG/usr/share/doc/$name" ]; then
	  rm -rf "$PKG/usr/share/doc/$name-$version"
	  mv -v "$PKG/usr/share/doc/$name" "$PKG/usr/share/doc/$name-$version" || return 1
	fi
}
