# description : Distributed version control system
# homepage    : https://git-scm.com/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : curl expat
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=git
version=2.55.0
release=4
source="https://www.kernel.org/pub/software/scm/$name/$name-$version.tar.xz git"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	./configure \
	    --prefix=/usr \
	    --with-gitconfig=/etc/gitconfig \
	    --with-python=/usr/bin/python3

	make \
	    NO_RUST=YesPlease

	make \
	    DESTDIR="$PKG" \
	    NO_RUST=YesPlease \
	    install
	post_build || return 1
}

post_build() {
    # Install the CRUX ports git driver.
    install -Dm755 "$SRC/git" "$PKG/etc/ports/drivers/git"
}
