# description : rust-bindgen
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : rustc llvm
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=rust-bindgen
version=0.73.2
release=1
source="https://github.com/rust-lang/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache

	mkdir -p "$PKGMK_SOURCE_DIR/rust"

	cargo build \
	    --release \
	    --manifest-path Cargo.toml || return 1

	install -Dm755 \
	    target/release/bindgen \
	    "$PKG/usr/bin/bindgen" || return 1
}
