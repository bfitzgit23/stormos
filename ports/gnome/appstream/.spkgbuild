# description : appstream
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : curl itstool libxml2 libxmlb libyaml libfyaml docbook-xsl-nons
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=appstream
version=1.2.0
release=1
source="https://www.freedesktop.org/software/${name}/releases/AppStream-${version}.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cd "$SRC/AppStream-$version" || return 1

	# AppStream still references the obsolete xsl-ns URL.
	# BFSOS ships the current DocBook XSL non-NS stylesheets.
	sed -i 's/xsl-ns/xsl/g' docs/meson.build || return 1

	meson setup build \
	    --prefix=/usr \
	    --buildtype=release \
	    -Dapidocs=false \
	    -Dstemming=false \
	    || return 1

	meson compile -C build || return 1

	DESTDIR="$PKG" meson install -C build || return 1
}
