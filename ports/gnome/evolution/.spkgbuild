# description : evolution
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : adwaita-icon-theme evolution-data-server gcr4 gnome-autoar shared-mime-info webkitgtk bogofilter enchant gnome-desktop gspell highlight itstool libcanberra libgweather libnotify openldap seahorse
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=evolution
version=3.62.0
release=1
build_opt="-DSYSCONF_INSTALL_DIR=/etc
-DENABLE_INSTALLED_TESTS=OFF
-DENABLE_PST_IMPORT=OFF
-DENABLE_YTNEF=OFF
-DENABLE_CONTACT_MAPS=OFF
-DENABLE_MARKDOWN=OFF
-DENABLE_WEATHER=ON"
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
