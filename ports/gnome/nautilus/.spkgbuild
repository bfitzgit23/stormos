# description : nautilus
# homepage    : 
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : bubblewrap gexiv2 gnome-autoar gnome-desktop libadwaita libnotify libportal libseccomp tinysparql localsearch blueprint-compiler glycin desktop-file-utils exempi glib gobject-introspection gst-plugins-base libcloudproviders libexif gvfs adwaita-icon-theme
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=nautilus
version=51.0.1
release=1
build_opt="--prefix=/usr       
            --buildtype=release 
            -Dselinux=false     
            -Dpackagekit=false"
source="https://download.gnome.org/sources/${name}/${version%%.*}/${name}-${version}.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
glib-compile-schemas /usr/share/glib-2.0/schemas
}
