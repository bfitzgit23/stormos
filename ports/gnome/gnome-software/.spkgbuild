# description : Software store for GNOME with Flatpak and BFSOS native package support
# homepage    : https://apps.gnome.org/Software/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : gtk4 libadwaita appstream libxmlb gnome-desktop gsettings-desktop-schemas flatpak polkit libgudev libsecret gdk-pixbuf glib dbus gnome-keyring
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=gnome-software
version=51.0
release=1
source="https://download.gnome.org/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	mkdir -p build && cd build || return 1

	# BFSOS ships no PackageKit, fwupd, or malcontent ports yet, so those
	# plugins are disabled. The Flatpak plugin provides the working store
	# for Flathub applications; native BFSOS packages are surfaced in the
	# store through the AppStream catalog generated by the bfsos-appstream
	# helper installed below.
	meson setup \
	    --prefix=/usr \
	    --buildtype=release \
	    -D tests=false \
	    -D man=true \
	    -D gtk_doc=false \
	    -D flatpak=true \
	    -D packagekit=false \
	    -D packagekit_autoremove=false \
	    -D fwupd=false \
	    -D malcontent=false \
	    -D polkit=true \
	    -D gudev=true \
	    -D snap=false \
	    -D apt=false \
	    -D rpm_ostree=false \
	    -D eos_updater=false \
	    -D mogwai=false \
	    -D external_appstream=false \
	    -D hardcoded_proprietary_webapps=false \
	    -D hardcoded_foss_webapps=true \
	    .. || return 1

	ninja -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" ninja install || return 1

	install -d -m 0755 "$PKG/usr/bin" || return 1

	# bfsos-appstream: regenerate the native-package AppStream catalog that
	# gnome-software displays alongside Flatpak applications. It walks the
	# installed-package database (prt-get/pkgutils), finds packages that
	# install desktop entries, and writes /usr/share/app-info/xmls/bfsos.xml
	# in the standard XDG AppStream location.
	cat > "$PKG/usr/bin/bfsos-appstream" <<'EOF'
#!/bin/sh
# Regenerate the BFSOS native AppStream catalog for gnome-software.
# Requires: prt-get and pkginfo (CRUX pkgutils), gzip.
set -eu

OUT_DIR=/usr/share/app-info/xmls
TMP="${TMPDIR:-/tmp}/bfsos-appstream.$$"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP"

command -v prt-get >/dev/null 2>&1 || { echo "bfsos-appstream: prt-get not found" >&2; exit 1; }
command -v pkginfo >/dev/null 2>&1 || { echo "bfsos-appstream: pkginfo not found" >&2; exit 1; }

printf '<?xml version="1.0" encoding="UTF-8"?>\n' > "$TMP/bfsos.xml"
printf '<components origin="bfsos" version="0.15">\n' >> "$TMP/bfsos.xml"

prt-get printf --installed '%n\t%v\t%d\n' 2>/dev/null |
while IFS="$(printf '\t')" read -r pkg ver desc; do
    [ -n "$pkg" ] || continue
    # Only expose packages that install a desktop entry (GUI applications).
    if ! pkginfo -f "$pkg" 2>/dev/null | grep -q '^usr/share/applications/.*\.desktop$'; then
        continue
    fi

    desktop="$(pkginfo -f "$pkg" 2>/dev/null | grep '^usr/share/applications/.*\.desktop$' | head -n1)"
    app_id="$(basename "$desktop" .desktop)"
    name="$(grep -m1 '^Name=' "/usr/share/applications/$app_id.desktop" 2>/dev/null |
            cut -d= -f2)"
    [ -n "$name" ] || name="$pkg"
    summary="$(printf '%s' "$desc" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"
    app_id_x="$(printf '%s' "$app_id" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"

    {
        printf '  <component type="desktop-application">\n'
        printf '    <id>%s</id>\n' "$app_id_x"
        printf '    <pkgname>%s</pkgname>\n' "$pkg"
        printf '    <name>%s</name>\n' "$name"
        printf '    <summary>%s</summary>\n' "$summary"
        printf '    <project_license>BFSD-unknown</project_license>\n'
        printf '    <releases>\n'
        printf '      <release version="%s" date="%s"/>\n' \
            "$ver" "$(date +%Y-%m-%d)"
        printf '    </releases>\n'
        printf '  </component>\n'
    } >> "$TMP/bfsos.xml"
done

printf '</components>\n' >> "$TMP/bfsos.xml"

mkdir -p "$OUT_DIR"
gzip -c "$TMP/bfsos.xml" > "$OUT_DIR/bfsos.xml.gz.new"
mv "$OUT_DIR/bfsos.xml.gz.new" "$OUT_DIR/bfsos.xml.gz"
echo "bfsos-appstream: catalog refreshed at $OUT_DIR/bfsos.xml.gz"
EOF
	chmod 0755 "$PKG/usr/bin/bfsos-appstream" || return 1

	# bfsos-store-search: one command that searches the native package tree
	# and Flathub together for users who prefer the terminal.
	cat > "$PKG/usr/bin/bfsos-store-search" <<'EOF'
#!/bin/sh
# Search native BFSOS packages and Flatpak remotes together.
# Usage: bfsos-store-search <term>
term="$*"
[ -n "$term" ] || { echo "usage: bfsos-store-search <term>" >&2; exit 2; }

echo "== Native packages (prt-get) =="
prt-get search "$term" 2>/dev/null || true
echo
echo "== Flatpak applications =="
flatpak search "$term" 2>/dev/null || true
EOF
	chmod 0755 "$PKG/usr/bin/bfsos-store-search" || return 1

	find "$PKG" -name '*.la' -delete
}

post_install() {
    # Build the initial native catalog so gnome-software shows BFSOS
    # applications on first launch. Safe to re-run after prt-get installs.
    if [ -x /usr/bin/bfsos-appstream ] && command -v prt-get >/dev/null 2>&1; then
        /usr/bin/bfsos-appstream >/dev/null 2>&1 || true
    fi
}
