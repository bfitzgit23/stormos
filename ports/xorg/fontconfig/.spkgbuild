# description : A library for configuring and customizing font access
# homepage    : https://www.freedesktop.org/wiki/Software/fontconfig/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : expat freetype
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=fontconfig
version=2.18.3
release=2
source="https://ftp2.osuosl.org/pub/blfs/conglomeration/fontconfig/fontconfig-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	./configure --prefix=/usr        \
	           --sysconfdir=/etc    \
	           --localstatedir=/var \
	           --disable-docs       \
	           --docdir=/usr/share/doc/fontconfig-$version &&
	           make

	make DESTDIR=$PKG install


	# Enabling autohinting by default
	pushd $PKG/etc/fonts/conf.d
	ln -sf /usr/share/fontconfig/conf.avail/10-autohint.conf
	popd

	rm -f $PKG/etc/fonts/conf.d/README
}
