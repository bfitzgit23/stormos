# description : Userspace interface to kernel DRM services
# homepage    : https://dri.freedesktop.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : xorg-libs valgrind
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libdrm
version=2.4.134
release=3
source="libdrm-$version.tar.xz::https://ftp.debian.org/debian/pool/main/libd/libdrm/libdrm_$version.orig.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build . \
	    --prefix="$XORG_PREFIX" \
	    --buildtype=release \
	    -Dudev=true \
	    -Dintel=enabled \
	    -Dvalgrind=enabled \
	    -Damdgpu=enabled \
	    -Dnouveau=enabled \
	    --wrap-mode=nodownload \
	    -Db_lto=true \
	    -Db_pie=true \
	    -Dman-pages=disabled || return $?
	meson compile -C build -j "${JOBS:-1}" || return $?
	DESTDIR="$PKG" meson install -C build || return $?
}
