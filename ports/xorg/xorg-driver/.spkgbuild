# description : Default broadly useful X.Org input/video driver set for BFSOS
# homepage    : https://www.x.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libevdev xf86-video-amdgpu xf86-video-neomagic xf86-input-elographics xf86-video-ast xf86-input-evdev xf86-video-ati xf86-input-joystick xf86-video-cirrus xf86-video-siliconmotion xf86-input-libinput xf86-video-dummy xf86-video-sis xf86-input-synaptics xf86-video-fbdev xf86-input-vmmouse xf86-video-intel xf86-video-vesa xf86-input-wacom xf86-video-mga xf86-video-vmware xf86-video-nouveau xf86-video-openchrome xf86-video-vboxvideo
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xorg-driver
version=7x
release=5
source=""

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	mkdir -p "$PKG/usr/share/bfsos/meta-packages"
	printf '%s
' 'BFSOS xorg-driver meta package' \
	    > "$PKG/usr/share/bfsos/meta-packages/xorg-driver"
}
