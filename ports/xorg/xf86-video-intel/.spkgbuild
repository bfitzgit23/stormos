# description : Intel graphics video driver
# homepage    : https://www.x.org/wiki/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libxscrnsaver xorg-server
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# scratchpkg rejects '-' in `version`; the upstream version 2.99.917-931 is kept verbatim in the source URLs below.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xf86-video-intel
version=2.99.917
release=1
source="https://crux.nu/files/distfiles/xf86-video-intel-2.99.917-931.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1

	./configure \
		--prefix=/usr \
		--libexecdir=/usr/lib/xf86-video-intel \
		--enable-tools \
		--with-default-dri=3

	make
	make DESTDIR=$PKG install
}
