# description : Legacy X.Org driver for VIA/OpenChrome graphics
# homepage    : https://www.freedesktop.org/wiki/Openchrome/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : xorg-server
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xf86-video-openchrome
version=0.6.0
release=3
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-openchrome-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# shadowUpdatePackedWeak() was removed from current Xorg. The normal
	# shadowUpdatePacked callback now has the function-pointer type expected
	# by shadowAdd().
	sed -i 's/shadowUpdatePackedWeak()/shadowUpdatePacked/g' src/via_driver.c || return $?

	./configure --prefix=/usr || return $?
	make -j1 CFLAGS+=" -fcommon" || return $?
	make DESTDIR="$PKG" install || return $?
}
