# description : Xlib-based library for the X Present Extension
# homepage    : https://gitlab.freedesktop.org/xorg/lib/libxpresent
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libxrandr libxrender libxfixes libxext libx11 libxcb libxau libxdmcp
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.
# the CRUX recipe called this package libXpresent

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libxpresent
version=1.0.2
release=3
source="https://xorg.freedesktop.org/archive/individual/lib/libXpresent-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	 ./configure $XORG_CONFIG --docdir=/usr/share/doc/$name-$version
	make
	make DESTDIR=$PKG install
}
