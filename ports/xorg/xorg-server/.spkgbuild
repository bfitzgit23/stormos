# description : X Window System server
# homepage    : https://xorg.freedesktop.org
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libxcvt pixman xorg-fonts xkeyboard-config libepoxy libtirpc libinput systemd xorg-apps
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xorg-server
version=21.1.24
release=3
source="https://xorg.freedesktop.org/archive/individual/xserver/$name-$version.tar.xz https://www.linuxfromscratch.org/patches/blfs/svn/$name-$version-tearfree_backport-2.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
		mkdir build &&
		cd    build &&

	meson setup ..              \
	      --prefix=$XORG_PREFIX \
	      --localstatedir=/var  \
	      -Dglamor=true         \
	      -Dxkb_output_dir=/var/lib/xkb &&
	ninja

		DESTDIR=$PKG ninja install
		rm -rf $PKG/usr/lib/xorg/protocol.txt
		install -m 755 -d $PKG/etc/X11/xorg.conf.d
		echo "needs_root_rights = yes" >> $PKG/etc/X11/Xwrapper.config
}
