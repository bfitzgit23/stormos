# description : Video driver for the AMD GPU families Tonga, Carrizo, Iceland, Fiji and Stoney
# homepage    : https://xorg.freedesktop.org
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : xorg-server meson
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xf86-video-amdgpu
version=25.0.0
release=1
source="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-amdgpu-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cd "$SRC/$name-$version" || return 1

	meson setup build         --prefix=/usr         --buildtype=release         -Dglamor=enabled         || return 1

	meson compile -C build || return 1

	DESTDIR="$PKG" meson install -C build || return 1
}
