# description : The Xorg libraries provide library routines that are used within all X Window applications.
# homepage    : https://www.x.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : xcursor-themes xorg-font-adobe-100dpi xorg-font-daewoo-misc xorg-font-adobe-75dpi xorg-font-dec-misc xorg-font-adobe-utopia-100dpi xorg-font-dejavu-ttf xorg-font-adobe-utopia-75dpi xorg-font-ibm-type1 xorg-font-adobe-utopia-type1 xorg-font-isas-misc xorg-font-alias xorg-font-jis-misc xorg-font-arabic-misc xorg-font-micro-misc xorg-font-bh-100dpi xorg-font-misc-cyrillic xorg-font-bh-75dpi xorg-font-misc-ethiopic xorg-font-bh-lucidatypewriter-100dpi xorg-font-misc-meltho xorg-font-bh-lucidatypewriter-75dpi xorg-font-misc-misc xorg-font-bh-ttf xorg-font-mutt-misc xorg-font-bh-type1 xorg-font-schumacher-misc xorg-font-bitstream-100dpi xorg-font-screen-cyrillic xorg-font-bitstream-75dpi xorg-font-sony-misc xorg-font-bitstream-type1 xorg-font-sun-misc xorg-font-bitstream-vera xorg-font-util xorg-font-cronyx-cyrillic xorg-font-winitzki-cyrillic xorg-font-cursor-misc xorg-font-xfree86-type1
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xorg-fonts
version=7x
release=2
source=""

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	mkdir -p "$PKG/usr/share/bfsos/meta-packages"
	printf '%s
' 'BFSOS xorg-fonts meta package' \
	    > "$PKG/usr/share/bfsos/meta-packages/xorg-fonts"
}
