# description : X.Org protocol headers
# homepage    : https://www.x.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : meson ninja
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xorgproto
version=2025.1
release=3
source="https://xorg.freedesktop.org/archive/individual/proto/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	meson setup build \
	    --prefix=/usr \
	    --buildtype=plain \
	    --wrap-mode=nodownload \
	    -Db_lto=true \
	    -Db_pie=true \
	    -Dlegacy=true || return 1

	meson compile -C build -j "${JOBS:-1}" || return 1

	DESTDIR="$PKG" \
	    meson install -C build || return 1

	rm -f \
	    "$PKG"/usr/include/X11/extensions/apple* \
	    "$PKG"/usr/include/X11/extensions/windows* \
	    "$PKG"/usr/share/pkgconfig/apple* \
	    "$PKG"/usr/share/pkgconfig/windows* \
	    "$PKG/usr/include/X11/extensions/vldXvMC.h" \
	    "$PKG/usr/include/X11/extensions/XKBgeom.h"

	rm -rf "$PKG/usr/share/doc"
}
