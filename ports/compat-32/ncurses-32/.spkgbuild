# description : A System V Release 4.0 curses emulation library
# homepage    : https://invisible-island.net/ncurses/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : 
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=ncurses-32
version=6.6
release=4
build_opt="--with-normal --with-shared --without-debug --without-ada --without-tests --enable-pc-files --with-pkg-config-libdir=/usr/lib32/pkgconfig --without-gpm --enable-widec"
source="https://invisible-mirror.net/archives/ncurses/ncurses-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
    #
    # We only want the 32-bit libraries and pkg-config metadata.
    #
    rm -rf \
        "$PKG/usr/bin" \
        "$PKG/usr/include" \
        "$PKG/usr/share" \
        "$PKG/usr/lib/terminfo"

    #
    # Wide-character compatibility names.
    #
    for lib in ncurses form panel menu; do
        rm -f "$PKG/usr/lib32/lib${lib}.so"

        printf 'INPUT(-l%sw)\n' "$lib" \
            > "$PKG/usr/lib32/lib${lib}.so"

        if [ -f "$PKG/usr/lib32/pkgconfig/${lib}w.pc" ]; then
            ln -sfn "${lib}w.pc" \
                "$PKG/usr/lib32/pkgconfig/${lib}.pc"
        fi
    done

    #
    # curses compatibility names.
    #
    printf 'INPUT(-lncursesw)\n' \
        > "$PKG/usr/lib32/libcursesw.so"

    ln -sfn libncurses.so \
        "$PKG/usr/lib32/libcurses.so"

    #
    # tinfo compatibility.  BFSOS links tinfo compatibility to
    # the wide ncurses implementation.
    #
    rm -f "$PKG/usr/lib32/libtinfo.so"

    printf 'INPUT(-lncursesw)\n' \
        > "$PKG/usr/lib32/libtinfo.so"

    if [ -f "$PKG/usr/lib32/pkgconfig/ncursesw.pc" ]; then
        ln -sfn ncursesw.pc \
            "$PKG/usr/lib32/pkgconfig/tinfo.pc"
    fi
}
