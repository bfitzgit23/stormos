# description : Sandboxed and extendable image loading - 32-bit
# homepage    : https://gitlab.gnome.org/GNOME/glycin
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glycin libseccomp-32 fontconfig-32 lcms2-32 llvm-32 glib-32 rustc
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=glycin-32
version=2.2.0
release=3
build_opt="-Dglycin-loaders=true \
-Dtest_skip_install=false \
-Dtests=false \
-Dglycin-thumbnailer=false \
-Dvapi=false \
-Dlibglycin-gtk4=false \
-Dintrospection=false \
-Dcapi_docs=false"
source="https://gitlab.gnome.org/GNOME/glycin/-/archive/$version/glycin-$version.tar.bz2 i686"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	(
	    set -e

	    prt-get isinst sccache && export RUSTC_WRAPPER=/usr/bin/sccache
	    export PKG_CONFIG_ALLOW_CROSS=1

	    local loaders="glycin-image-rs"
	    prt-get isinst libheif-32 && loaders+=",glycin-heif"
	    prt-get isinst libjxl-32  && loaders+=",glycin-jxl"
	    prt-get isinst librsvg-32 && loaders+=",glycin-svg"

	    meson setup build . \
	        --cross-file="$SRC/i686" \
	        --prefix=/usr \
	        --libdir=lib32 \
	        --libexecdir=lib32/$name \
	        --buildtype=plain \
	        --wrap-mode=nodownload \
	        -Db_lto=true \
	        -Db_pie=true \
	        $build_opt \
	        -Dloaders="$loaders"

	    meson compile -C build -j "${JOBS:-1}"
	    DESTDIR="$PKG" meson install -C build
	)
	post_build || return 1
}

post_build() {
    rm -rf "$PKG/usr/include" "$PKG/usr/share"
}
