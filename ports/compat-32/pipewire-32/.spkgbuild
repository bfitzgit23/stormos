# description : Low-latency audio/video router and processor - 32-bit client library
# homepage    : https://pipewire.org
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : dbus-32 gst-plugins-base-32 pipewire
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=pipewire-32
version=1.6.8
release=3
source="https://gitlab.freedesktop.org/pipewire/pipewire/-/archive/$version/pipewire-$version.tar.bz2"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	 (
	   set -e
	prt-get isinst alsa-lib-32 && PKGMK_PW+=' -D alsa=enabled -D pipewire-alsa=enabled'
	prt-get isinst avahi-32 && PKGMK_PW+=' -D avahi=enabled'
	prt-get isinst dbus-32 && PKGMK_PW+=' -D dbus=enabled'
	prt-get isinst libsdl2-32 && PKGMK_PW+=' -D sdl2=enabled'
	prt-get isinst libsndfile-32 && PKGMK_PW+=' -D sndfile=enabled'
	prt-get isinst pulseaudio-32 && PKGMK_PW+=' -D libpulse=enabled'
	prt-get isinst vulkan-loader-32 && PKGMK_PW+=' -D vulkan=enabled'

	meson setup build . $PKGMK_PW \
		-D prefix=/usr \
		--libdir=lib32 \
		--buildtype=plain \
		--auto-features=disabled \
		-D man=disabled \
		-D tests=disabled \
		-D examples=disabled \
		-D pw-cat=disabled \
		-D libffado=disabled \
		-D pipewire-jack=disabled \
		-D jack=disabled \
		-D opus=disabled \
		-D bluez5-codec-opus=disabled \
		-D session-managers='[]' || return 1

	meson compile -C build || return 1
	DESTDIR="$PKG" meson install -C build || return 1

	# remove leftovers
	rm -rf "$PKG/etc" "$PKG/usr/bin" "$PKG/usr/include" "$PKG/usr/share/locale" "$PKG/usr/share/pipewire"

	prt-get isinst alsa-lib-32 && \
		rm -rf "$PKG/usr/share/alsa" "$PKG/usr/share/alsa-card-profile" && \
		rm -f "$PKG/usr/lib/udev/rules.d/90-pipewire-alsa.rules"

	find $PKG -type d -empty -delete
	 )
}
