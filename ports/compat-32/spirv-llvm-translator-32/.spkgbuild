# description : Bidirectional translation between LLVM IR and SPIR-V (32-bit compatibility libraries)
# homepage    : https://github.com/KhronosGroup/SPIRV-LLVM-Translator
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : libxml2-32 llvm-32 spirv-headers spirv-tools-32 spirv-llvm-translator
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=spirv-llvm-translator-32
version=23.1.1
release=1
source="https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/v${version}/SPIRV-LLVM-Translator-${version}.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	(
	    set -e

	    rm -rf build

	    cmake -S . -B build \
	        -G Ninja \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib32 \
	        -DCMAKE_BUILD_TYPE=Release \
	        -DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
	        -DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
	        -DBUILD_SHARED_LIBS=ON \
	        -DCMAKE_SKIP_INSTALL_RPATH=ON \
	        -DLLVM_LINK_LLVM_DYLIB=ON \
	        -DLLVM_BUILD_LLVM_DYLIB=ON \
	        -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \
	        -DCMAKE_PREFIX_PATH=/usr/lib32/cmake \
	        || return 1

	    cmake --build build -j "${JOBS:-1}" || return 1

	    DESTDIR="$PKG" cmake --install build || return 1

	    rm -rf \
	        "$PKG/usr/bin" \
	        "$PKG/usr/include"

	    if [ -d "$PKG/usr/lib" ]; then
	        echo "ERROR: spirv-llvm-translator-32 installed files into /usr/lib"
	        find "$PKG/usr/lib" -maxdepth 3 -print
	        return 1
	    fi
	)
}
