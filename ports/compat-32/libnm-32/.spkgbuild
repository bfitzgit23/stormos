# description : Network configuration tool
# homepage    : https://wiki.gnome.org/Projects/NetworkManager/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : curl-32 dbus-glib-32 jansson-32 libndp-32 libpsl-32 networkmanager nss-32
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libnm-32
version=1.58.1
release=7
build_opt="--libexecdir=/usr/lib/networkmanager \
-Dcrypto=nss \
-Ddbus_conf_dir=/usr/share/dbus-1/system.d \
-Dudev_dir=/lib/udev \
-Dintrospection=false \
-Dsession_tracking=no \
-Dlibaudit=no \
-Dbluez5_dun=false \
-Dconcheck=false \
-Dclat=false \
-Dnbft=false \
-Debpf=false \
-Diwd=false \
-Dmodem_manager=false \
-Dnm_cloud_setup=false \
-Dnmcli=false \
-Dnmtui=false \
-Dovs=false \
-Dppp=false \
-Dteamdctl=false \
-Dtests=no \
-Dmore_asserts=no \
-Dmore_logging=false \
-Dqt=false \
-Dsystemdsystemunitdir=no \
-Dsystemd_journal=false \
-Dselinux=false \
-Dsuspend_resume=consolekit \
-Dpolkit=false"
source="https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/$version/downloads/NetworkManager-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
    rm -rf "$PKG/usr/bin" \
           "$PKG/usr/include" \
           "$PKG/usr/sbin" \
           "$PKG/usr/share" \
           "$PKG/usr/lib" \
           "$PKG/etc" \
           "$PKG/lib" \
           "$PKG/var"
}
