# description : Netscape Portable Runtime library
# homepage    : https://developer.mozilla.org/en-US/docs/Mozilla/Projects/NSPR
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : nspr
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=nspr-32
version=4.40
release=3
build_opt="--includedir=/usr/include/nspr --enable-optimize=$CFLAGS --disable-64bit --disable-debug"
source="https://ftp.mozilla.org/pub/mozilla.org/nspr/releases/v$version/src/${name%-*}-$version.tar.gz nspr.pc.in"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

pre_build() {
	cd nspr || return 1
}

post_build() {
	local NSPR_LIBS NSPR_CFLAGS NSPR_VERSION

	mv $PKG/usr/bin/nspr-config{,-32}
	rm $PKG/usr/bin/{compile-et.pl,prerr.properties}

	NSPR_LIBS=`./config/nspr-config --libs`
	NSPR_CFLAGS=`./config/nspr-config --cflags`
	NSPR_VERSION=`./config/nspr-config --version`

	install -d $PKG/usr/lib32/pkgconfig

	sed $SRC/nspr.pc.in \
		-e "s,@libdir@,/usr/lib32," \
		-e "s,@prefix@,/usr," \
		-e "s,@exec_prefix@,/usr/bin," \
		-e "s,@includedir@,/usr/include/nspr," \
		-e "s,@NSPR_VERSION@,$NSPR_VERSION," \
		-e "s,@FULL_NSPR_LIBS@,$NSPR_LIBS," \
		-e "s,@FULL_NSPR_CFLAGS@,$NSPR_CFLAGS," > \
		$PKG/usr/lib32/pkgconfig/nspr.pc

	rm -r $PKG/usr/{include,share
}
