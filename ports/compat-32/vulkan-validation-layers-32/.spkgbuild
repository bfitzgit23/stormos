# description : Vulkan validation layers, 32bit
# homepage    : https://www.khronos.org/vulkan/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : robin-hood-hashing-32 spirv-tools-32 vulkan-utility-libraries-32 vulkan-validation-layers libxrandr-32
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=vulkan-validation-layers-32
version=1.4.357.0
release=3
_name=Vulkan-ValidationLayers
_version=vulkan-sdk-$version
source="https://github.com/KhronosGroup/Vulkan-ValidationLayers/archive/$_version/$_name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	 (
	   set -e
	prt-get isinst wayland-32 || PKGMK_VULKAN_VALIDATION_LAYERS+=' -D BUILD_WSI_WAYLAND_SUPPORT=OFF'

	cmake -S . -B build -G Ninja $PKGMK_VULKAN_VALIDATION_LAYERS \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=lib32 \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
		-D SPIRV_HEADERS_INSTALL_DIR=/usr \
		-D VULKAN_HEADERS_INSTALL_DIR=/usr \
		-D USE_ROBIN_HOOD_HASHING=ON \
		-D BUILD_TESTS=OFF \
		-Wno-dev

	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -r $PKG/usr/share
	 )
}
