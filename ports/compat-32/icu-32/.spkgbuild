# description : Widely used set of C/C++ libraries providing Unicode and Globalization support.
# homepage    : https://icu.unicode.org
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : icu
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=icu-32
version=78.3
release=3
build_opt="--disable-samples --disable-tests"
source="https://github.com/unicode-org/icu/releases/download/release-${version//./-}/icu4c-${version/./_}-src.tgz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	pre_build || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

pre_build() {
	cd source || return 1

	touch ../LICENSE

	# icu tries to use clang by default, only do so if installed
	prt-get isinst llvm lld && LDFLAGS+=' -fuse-ld=lld -flto=thin'
	prt-get isinst llvm && export CC=clang CXX=clang++ AR=llvm-ar NM=llvm-nm RANLIB=llvm-ranlib || \
		export CC=gcc CXX=g++
}

post_build() {
	rm -r \
		$PKG/usr/bin \
		$PKG/usr/sbin \
		$PKG/usr/share/man \
		$PKG/usr/share/icu \
		$PKG/usr/include/unicode
}
