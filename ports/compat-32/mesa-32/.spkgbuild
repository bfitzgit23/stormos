# description : Mesa 3D Graphics Library (32-bit)
# homepage    : https://www.mesa3d.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cbindgen elfutils-32 expat-32 glslang libclc libdrm-32 libglvnd-32 llvm-32 mesa libxdamage-32 libxrandr-32 libxshmfence-32 libxxf86vm-32 lua python3-ply rust-bindgen rustc spirv-llvm-translator-32 vulkan-loader-32 wayland-32 wayland-protocols
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=mesa-32
version=26.2.3
release=11
build_opt="-Db_lto=false \
-Db_pie=true \
-Degl=enabled \
-Dllvm=enabled \
-Dshared-llvm=enabled \
-Dgbm=enabled \
-Dgles1=disabled \
-Dgles2=enabled \
-Dglx=dri \
-Dvideo-codecs=all \
-Dglvnd=enabled"
source="https://archive.mesa3d.org/mesa-$version.tar.xz x86-linux-gnu x86-linux-gnu-ccache"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	(
	    set -e
	    export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
	    export BINDGEN_EXTRA_CLANG_ARGS="--target=i686-unknown-linux-gnu"

	    local _cross_file="x86-linux-gnu"
	    local _mesa_opt=""
	    local _gallium_drivers="nouveau,r300,r600,radeonsi,svga,virgl,i915,llvmpipe,softpipe"
	    local _platforms="x11"
	    local _vulkan_drivers=""
	    local _vulkan_layers=""

	    if prt-get isinst ccache >/dev/null 2>&1; then
	        _cross_file="x86-linux-gnu-ccache"
	    fi

	    #
	    # Optional D3D12 Gallium driver.
	    #
	    if prt-get isinst directx-headers-32 >/dev/null 2>&1; then
	        _gallium_drivers="d3d12,${_gallium_drivers}"
	    fi

	    #
	    # Iris and Crocus require Mesa's CLC compiler support.
	    # Do not enable them unless the complete 32-bit compiler stack exists.
	    #
	    if pc32_has libclc &&
	       pc32_has LLVMSPIRVLib; then
	        _gallium_drivers="iris,crocus,${_gallium_drivers}"
	    fi

	    #
	    # Optional Rusticl OpenCL frontend.
	    #
	    # Only enable it when the complete 32-bit toolchain is present.
	    #
	    if pc32_has libclc &&
	       pc32_has LLVMSPIRVLib &&
	       pkg_is_installed rust-bindgen &&
	       command -v rustc >/dev/null 2>&1 &&
	       _rustlib="$(rustc --print target-libdir --target i686-unknown-linux-gnu 2>/dev/null)" &&
	       ls "$_rustlib"/libstd-*.rlib >/dev/null 2>&1; then
	        _mesa_opt+=" -Dgallium-rusticl=true"
	    else
	        _mesa_opt+=" -Dgallium-rusticl=false"
	    fi

	    #
	    # Optional libunwind support.
	    #
	    if prt-get isinst libunwind-32 >/dev/null 2>&1; then
	        _mesa_opt+=" -Dlibunwind=enabled"
	    else
	        _mesa_opt+=" -Dlibunwind=disabled"
	    fi

	    #
	    # Optional VA-API frontend.
	    #
	    if prt-get isinst libva-32 >/dev/null 2>&1; then
	        _mesa_opt+=" -Dgallium-va=enabled"
	    else
	        _mesa_opt+=" -Dgallium-va=disabled"
	    fi

	    #
	    # Optional lm_sensors HUD support.
	    #
	    if prt-get isinst lm_sensors-32 >/dev/null 2>&1; then
	        _mesa_opt+=" -Dlmsensors=enabled"
	    else
	        _mesa_opt+=" -Dlmsensors=disabled"
	    fi

	    #
	    # Wayland support uses native wayland-protocols together with
	    # the 32-bit wayland libraries.
	    #
	    if prt-get isinst wayland-protocols >/dev/null 2>&1; then
	        _platforms="wayland,x11"
	    fi

	    #
	    # Build Vulkan drivers when the 32-bit loader is installed.
	    #
	    if prt-get isinst vulkan-loader-32 >/dev/null 2>&1; then
	        _gallium_drivers="zink,${_gallium_drivers}"

	        #
	        # RADV.
	        #
	        if prt-get isinst glslang >/dev/null 2>&1; then
	            _vulkan_drivers+="amd,"
	            _vulkan_layers+="overlay,"
	        fi

	        #
	        # ANV.
	        #
	        if pkg_is_installed glslang &&
	           pc32_has libclc &&
	           pc32_has LLVMSPIRVLib &&
	           pkg_is_installed lua &&
	           pkg_is_installed python3-ply; then
	            _vulkan_drivers+="intel,"
	            _vulkan_layers+="intel-nullhw,"
	        fi

	        #
	        # NVK.
	        #
	        # Mesa 26.2 requires Rust for vulkan-drivers=nouveau.
	        # BFSOS rustc release 3 provides the i686 Rust stdlib.
	        #
	        if pkg_is_installed cbindgen &&
	           pc32_has libclc &&
	           pc32_has LLVMSPIRVLib &&
	           pkg_is_installed rust-bindgen &&
	           command -v rustc >/dev/null 2>&1 &&
	           _rustlib="$(rustc --print target-libdir --target i686-unknown-linux-gnu 2>/dev/null)" &&
	           ls "$_rustlib"/libstd-*.rlib >/dev/null 2>&1; then
	            _vulkan_drivers+="nouveau,"
	        fi

	        #
	        # HasVK, VirtIO and Lavapipe.
	        #
	        if pc32_has LLVMSPIRVLib; then
	            _vulkan_drivers+="intel_hasvk,"
	        fi

	        _vulkan_drivers+="virtio,swrast"

	        _vulkan_drivers="${_vulkan_drivers%,}"
	        _vulkan_layers="${_vulkan_layers%,}"
	    fi

	    rm -rf build

	    meson setup build . \
	        $build_opt \
	        $_mesa_opt \
	        --cross-file="$SRC/$_cross_file" \
	        --prefix=/usr \
	        --libdir=/usr/lib32 \
	        --sysconfdir=/etc \
	        --buildtype=plain \
	        -Dgallium-drivers="$_gallium_drivers" \
	        -Dplatforms="$_platforms" \
	        -Dvulkan-drivers="$_vulkan_drivers" \
	        -Dvulkan-layers="$_vulkan_layers" \
	        || return 1

	    meson compile -C build -j "${JOBS:-1}" \
	        || return 1

	    DESTDIR="$PKG" meson install -C build \
	        || return 1

	    #
	    # 32-bit indirect GLX entry point.
	    #
	    install -d "$PKG/usr/lib32"

	    ln -sfn libGLX_mesa.so.0 \
	        "$PKG/usr/lib32/libGLX_indirect.so.0"

	    #
	    # mesa-32 supplies the 32-bit libraries/drivers only.
	    # Native Mesa owns the architecture-independent files.
	    #
	    rm -rf \
	        "$PKG/usr/include" \
	        "$PKG/usr/bin" \
	        "$PKG/usr/share/drirc.d" \
	        "$PKG/usr/share/glvnd" \
	        "$PKG/usr/share/vulkan/explicit_layer.d" \
	        "$PKG/usr/share/vulkan/implicit_layer.d"
	)
}
