# description : Library for passing menus over DBus - Common Files (32bit)
# homepage    : https://launchpad.net/libdbusmenu
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glib-32 libdbusmenu-glib
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=libdbusmenu-glib-32
version=18.10
release=4
source="http://cdn-fastly.deb.debian.org/debian/pool/main/libd/libdbusmenu/libdbusmenu_18.10.20180917~bzr492+repack1.orig.tar.xz 0001_no-deprecated-gnome-common-macros.patch 0003_port-tools-dbusmenu-bench-to-py3.patch 0004_prevent-test-json-from-failing.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	(
	  set -e
	export HAVE_VALGRIND_TRUE='#'
	export HAVE_VALGRIND_FALSE=''

	sed -e 's/-Werror -Wno-error=deprecated-declarations//g' -i libdbusmenu-{glib,gtk}/Makefile.am
	sed -e 's/gtkdocize || exit 1//g' -i autogen.sh
	sed -e 's/--enable-gtk-doc//g' -i autogen.sh

	./autogen.sh --prefix=/usr \
	  --sysconfdir=/etc \
	  --libdir=/usr/lib32 \
	  --libexecdir=/usr/lib32/$name \
	  --localstatedir=/var \
	  --disable-{dumper,tests,vala,nls,gtk}
	make -j1
	make DESTDIR=$PKG -C libdbusmenu-glib -j1 install

	rm -fr $PKG/usr/{lib,include,share}

	find $PKG -print0 | xargs -0 file | grep -e "executable" -e "shared object" | grep ELF \
	  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null || true
	)
}
