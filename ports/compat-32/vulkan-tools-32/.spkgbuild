# description : Vulkan tools
# homepage    : https://www.khronos.org/vulkan/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : glslang volk-32 vulkan-headers vulkan-loader-32
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=vulkan-tools-32
version=1.4.357.0
release=3
_name=Vulkan-Tools
_version=vulkan-sdk-$version
source="https://github.com/KhronosGroup/Vulkan-Tools/archive/$_version/$_name-$version.tar.gz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	 (
	   set -e
	prt-get isinst wayland-32 || PKGMK_VULKAN_TOOLS+=' -D BUILD_WSI_WAYLAND_SUPPORT=OFF'
	prt-get isinst wayland-32 && export PKG_CONFIG_LIBDIR=/usr/lib32/pkgconfig:/usr/share/pkgconfig

	export ASFLAGS='--32'

	cmake -S . -B build -G Ninja $PKGMK_VULKAN_TOOLS \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=lib32 \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
		-D CMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
		-D GLSLANG_INSTALL_DIR=/usr \
		-D BUILD_CUBE=True \
		-D BUILD_VULKANINFO=True \
		-D CUBE_WSI_SELECTION=XCB \
		-D BUILD_WSI_XCB_SUPPORT=True \
		-D BUILD_WSI_XLIB_SUPPORT=True \
		-D BUILD_ICD=OFF \
		-Wno-dev

	cmake --build build
	DESTDIR=$PKG cmake --build build --target install

	for app in $PKG/usr/bin/* ; do
		mv $app $app-32
	done
	 )
}
