# description : CDDA extraction tool with jitter correction
# homepage    : https://xiph.org/paranoia/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cdparanoia
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

# compat-32: build and stage 32-bit objects against /usr/lib32.
export BFS_PKG_LIBDIR="/usr/lib32"
export BFS_PKG_LIBDIR_NAME="lib32"
export BFS_MULTILIB_HOST="${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
export PKG_CONFIG_LIBDIR="/usr/lib32/pkgconfig:/usr/share/pkgconfig"
export CFLAGS="${CFLAGS:--O2 -march=x86-64 -pipe} -m32"
export CXXFLAGS="${CXXFLAGS:-$CFLAGS}"
export CC="${CC:-gcc} -m32"
export CXX="${CXX:-g++} -m32"
export LDFLAGS="${LDFLAGS:-} -L/usr/lib32"

. /usr/libexec/bfs/spkgbuild-lib.sh

name=cdparanoia-32
version=10.2
release=5
PKGMK_AUTO_PATCH=no
build_opt="--prefix=/usr --libdir=/usr/lib32 --host=${BFS_MULTILIB_HOST:-i686-pc-linux-gnu}"
source="https://downloads.xiph.org/releases/cdparanoia/cdparanoia-III-$version.src.tgz cdparanoia-10.2-463009.patch cdparanoia-10.2-endian.patch cdparanoia-10.2-install.patch cdparanoia-10.2-format-security.patch cdparanoia-use-proper-gnu-config-files.patch cdparanoia-10.2-ldflags.patch cdparanoia-10.2-add-pkgconfig.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	 (
	   set -e
	patch -p3 -i $SRC/cdparanoia-10.2-463009.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-endian.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-install.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-format-security.patch || return 1
	patch -p1 -i $SRC/cdparanoia-use-proper-gnu-config-files.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-ldflags.patch || return 1
	patch -p1 -i $SRC/cdparanoia-10.2-add-pkgconfig.patch || return 1
	autoreconf -ifv || return 1

	./configure $build_opt || return 1

	make -j1 || return 1
	make DESTDIR="$PKG" install || return 1

	rm -rf "$PKG/usr/bin" "$PKG/usr/include" "$PKG/usr/share"
	 )
}
