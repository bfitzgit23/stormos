# description : Experimental Compiz Reloaded plugin collection
# homepage    : https://gitlab.com/compiz/compiz-plugins-experimental
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : compiz compiz-bcop compiz-plugins-main compiz-plugins-extra cairo curl glew glu libsm libx11 libxscrnsaver libxcomposite libxcursor libxdamage libxext libxfixes libxi libxinerama libxrandr libxml2 startup-notification
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=compiz-plugins-experimental
version=0.8.18
release=1
source="https://gitlab.com/compiz/$name/-/archive/v$version/$name-v$version.tar.bz2 https://gitlab.com/compiz/$name/-/commit/35ce86af.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	NOCONFIGURE=1 ./autogen.sh || return 1
	./configure --prefix=/usr --disable-static || return 1
	make -j"${JOBS:-1}" || return 1
	make DESTDIR="$PKG" install || return 1
}
