# description : Panel for the Xfce desktop environment
# homepage    : https://docs.xfce.org/xfce/xfce4-panel/start
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cairo exo garcon libwnck libxfce4windowing
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=xfce4-panel
version=4.20.8
release=4
source="https://archive.xfce.org/src/xfce/${name}/${version%.*}/${name}-${version}.tar.bz2 default.xml bfs-terminal.desktop bfs-files.desktop bfs-image-viewer.desktop bfs-media-player.desktop bfs-disc-burner.desktop bfs-xfce-first-login bfs-xfce-first-login.desktop"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
	post_build || return 1
}

post_build() {
    # Xfce reads this template when a user has no panel configuration yet.
    # Keep the normal status cluster useful on first login rather than
    # requiring each user to add notifications, power and audio manually.
    install -Dm644 "$SRC/default.xml" \
        "$PKG/etc/xdg/xfce4/panel/default.xml" || return 1

    # Launcher plugin state lives beside the default panel XML.  Supplying the
    # desktop entries here makes the BFSOS bottom launcher panel functional on
    # first login instead of creating empty launcher placeholders.
    local id file
    for spec in \
        "11:bfs-terminal.desktop" \
        "12:bfs-files.desktop" \
        "13:bfs-image-viewer.desktop" \
        "14:bfs-media-player.desktop" \
        "15:bfs-disc-burner.desktop"; do
        id=${spec%%:*}
        file=${spec#*:}
        install -Dm644 "$SRC/$file" \
            "$PKG/etc/xdg/xfce4/panel/launcher-$id/$file" || return 1
    done

    install -Dm755 "$SRC/bfs-xfce-first-login" \
        "$PKG/usr/libexec/bfs-xfce-first-login" || return 1
    install -Dm644 "$SRC/bfs-xfce-first-login.desktop" \
        "$PKG/etc/xdg/autostart/bfs-xfce-first-login.desktop" || return 1
}
