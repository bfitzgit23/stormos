# description : Additional KIO workers and plugins for KDE resource and network access
# homepage    : https://invent.kde.org/network/kio-extras
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : extra-cmake-modules kde-frameworks-6 kdsoap-ws-discovery-client libkexiv2 libproxy plasma-activities-stats qcoro qt6
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=kio-extras
version=26.08.1
release=1
source="https://download.kde.org/stable/release-service/$version/src/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cmake -B build -S . \
	    -DCMAKE_INSTALL_PREFIX="/opt/kf6" \
	    -DCMAKE_PREFIX_PATH="/opt/qt6;/opt/kf6" \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DBUILD_TESTING=OFF \
	    -Wno-author || return 1
	cmake --build build -j${JOBS:-1} || return 1
	DESTDIR="$PKG" cmake --install build || return 1
}
