# description : Extra CMake modules used by KDE Frameworks and Plasma
# homepage    : https://download.kde.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : cmake
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=extra-cmake-modules
version=6.30.0
release=1
source="https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz ecm-shiboken-qt-system-includes.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	sed -i '/"lib64"/s/64//' kde-modules/KDEInstallDirsCommon.cmake || return 1

	sed -e '/PACKAGE_INIT/i set(SAVE_PACKAGE_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")' \
	    -e '/^include/a set(PACKAGE_PREFIX_DIR "${SAVE_PACKAGE_PREFIX_DIR}")' \
	    -i ECMConfig.cmake.in || return 1

	cmake -S . -B build \
	    -DCMAKE_INSTALL_PREFIX=/usr \
	    -DBUILD_WITH_QT6=ON || return 1

	cmake --build build -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" cmake --install build || return 1
}
