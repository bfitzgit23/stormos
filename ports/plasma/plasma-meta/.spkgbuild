# description : KDE Plasma 6 desktop meta package
# homepage    : https://kde.org/plasma-desktop/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : kde-frameworks-6 pulseaudio-qt kdecoration libkscreen libksysguard breeze breeze-gtk layer-shell-qt plasma-activities libplasma kscreenlocker kinfocenter kglobalacceld kwayland kwin plasma5support plasma-activities-stats kpipewire plasma-workspace plasma-disks bluedevil kde-gtk-config kmenuedit kscreen kwallet-pam kwrited milou plasma-nm plasma-pa plasma-workspace-wallpapers polkit-kde-agent-1 powerdevil plasma-desktop kgamma ksshaskpass sddm-kcm kactivitymanagerd plasma-integration xdg-desktop-portal-kde drkonqi plasma-vault plasma-browser-integration kde-cli-tools systemsettings plasma-thunderbolt plasma-firewall plasma-systemmonitor qqc2-breeze-style ksystemstats oxygen-sounds kdeplasma-addons plasma-welcome ocean-sound-theme print-manager kwin-x11 pipewire wireplumber alsa-utils rtkit plasma-default-apps spectacle phonon-backend-vlc sddm samba cifs-utils nfs-utils
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=plasma-meta
version=6.7.5
release=4
source=""

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	install -d "$PKG/usr/share/bfsos/meta-packages" || return 1

	printf '%s\n'         'BFSOS Plasma meta-package. Desktop audio activation is owned by the WirePlumber systemd user preset.'         > "$PKG/usr/share/bfsos/meta-packages/plasma-meta" || return 1
}
