# description : KDE Frameworks is a collection of libraries based on top of Qt6 and QML derived from the previous KDE libraries. They can be used independent of the KDE Display Environment (Plasma 6).
# homepage    : https://kde.org/
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : extra-cmake-modules docbook-xml docbook-xsl-nons libcanberra libgcrypt libical libxslt lmdb qca qrencode plasma-wayland-protocols shared-mime-info p5-uri wget aspell avahi modemmanager networkmanager polkit-qt-1 vulkan-loader attica kapidox karchive kcodecs kconfig kcoreaddons kdbusaddons kdnssd kguiaddons ki18n kidletime kimageformats kitemmodels kitemviews kplotting kwidgetsaddons kwindowsystem networkmanager-qt solid sonnet threadweaver kauth kcompletion kcrash kdoctools kpty kunitconversion kcolorscheme kconfigwidgets kservice kglobalaccel kpackage kdesu kiconthemes knotifications kjobwidgets ktextwidgets kxmlgui kbookmarks kwallet kded kio kdeclarative kcmutils kirigami syndication knewstuff frameworkintegration kparts syntax-highlighting ktexteditor kcontacts kpeople bluez kfilemetadata baloo breeze-icons krunner prison qqc2-desktop-style kholidays purpose kcalendarcore kquickcharts knotifyconfig kdav kstatusnotifieritem ksvg ktexttemplate kuserfeedback qt6
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=kde-frameworks-6
version=6.30.0
release=2
source=""

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	install -d "$PKG/usr/share/bfsos/metapackages" || return 1
	printf '%s\n' "$name $version" >         "$PKG/usr/share/bfsos/metapackages/$name" || return 1
}
