# description : Image format plugins for Qt6/KF6
# homepage    : https://invent.kde.org/frameworks/kimageformats
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : qt6 libavif libjxl libraw extra-cmake-modules
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=kimageformats
version=6.30.0
release=1
build_opt="-DQT_MAJOR_VERSION=6 \
-DCMAKE_INSTALL_PREFIX=/opt/kf6 \
-DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6 \
-DCMAKE_INSTALL_LIBEXECDIR=libexec \
-DCMAKE_BUILD_TYPE=Release \
-DBUILD_TESTING=OFF"
source="https://download.kde.org/stable/frameworks/${version%.*}/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
