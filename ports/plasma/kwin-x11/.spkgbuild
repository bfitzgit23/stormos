# description : KDE Plasma X11 window manager
# homepage    : https://invent.kde.org/plasma/kwin-x11
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : extra-cmake-modules qt6 kde-frameworks-6 kdecoration kglobalaccel kglobalacceld knighttime libplasma plasma-activities plasma-wayland-protocols breeze libcanberra lcms2 libdisplay-info libdrm libepoxy libinput libxkbcommon mesa wayland wayland-protocols xorg-libs xcb-util-cursor xcb-util-keysyms xcb-util-wm
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=kwin-x11
version=6.7.5
release=1
build_opt="-DCMAKE_INSTALL_PREFIX=/opt/kf6
           -DCMAKE_PREFIX_PATH=/opt/qt6;/opt/kf6
           -DCMAKE_INSTALL_LIBEXECDIR=libexec
           -DCMAKE_BUILD_TYPE=Release
           -DBUILD_TESTING=OFF
           -Wno-author"
source="https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	# No custom build steps in the CRUX recipe: run the build system
	# the pkgmk extension would have detected.
	bfs_standard_build
}
