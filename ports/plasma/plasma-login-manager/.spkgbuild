# description : KDE Plasma integrated display/login manager and configuration KCM
# homepage    : https://invent.kde.org/plasma/plasma-login-manager
# maintainer  : Brian Madonna <bmadonnaster@gmail.com>
# depends     : extra-cmake-modules kauth kconfig kcoreaddons kdbusaddons ki18n kimageformats kpackage kwindowsystem layer-shell-qt libkscreen libplasma linux-pam plasma-workspace kwin qt6 systemd
#
# BFSOS scratchpkg recipe, converted from the CRUX Pkgfile by scripts/bfs-ports-to-spkgbuild.py.
# Build it with `pkgbuild` (or `scratch install <port>`) from this directory.

. /usr/libexec/bfs/spkgbuild-lib.sh

name=plasma-login-manager
version=6.7.5
release=2
source="https://download.kde.org/stable/plasma/$version/$name-$version.tar.xz bfs-display-manager plasmalogin.pam plasmalogin-autologin.pam plasmalogin-greeter.pam remember-session-binding-fix.patch"

build() {
	# scratchpkg calls build() from $SRC; enter the unpacked source tree.
	bfs_enter_srcdir || return 1
	bfs_apply_patches || return 1
	cmake -S . -B build \
	    -DCMAKE_INSTALL_PREFIX=/opt/kf6 \
	    -DCMAKE_PREFIX_PATH=/opt/qt6\;/opt/kf6 \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DBUILD_TESTING=OFF -DINSTALL_PAM_CONFIGURATION=OFF \
	    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 || return 1

	cmake --build build -j "${JOBS:-1}" || return 1
	DESTDIR="$PKG" cmake --install build || return 1

	# systemd, sysusers, tmpfiles, PAM and system-bus policy are host services;
	# keep them in standard system paths even though KDE itself lives in /opt/kf6.
	install -d "$PKG/usr/lib/systemd/system" "$PKG/usr/lib/systemd/user" \
	    "$PKG/usr/lib/sysusers.d" "$PKG/usr/lib/tmpfiles.d" \
	    "$PKG/usr/share/dbus-1/system.d" "$PKG/etc/pam.d" "$PKG/usr/sbin" || return 1

	for unit in "$PKG"/opt/kf6/lib/systemd/system/*; do
	    [ -e "$unit" ] || continue
	    mv "$unit" "$PKG/usr/lib/systemd/system/" || return 1
	done
	for unit in "$PKG"/opt/kf6/lib/systemd/user/*; do
	    [ -e "$unit" ] || continue
	    mv "$unit" "$PKG/usr/lib/systemd/user/" || return 1
	done
	for f in "$PKG"/opt/kf6/lib/sysusers.d/*; do
	    [ -e "$f" ] || continue
	    mv "$f" "$PKG/usr/lib/sysusers.d/" || return 1
	done
	for f in "$PKG"/opt/kf6/lib/tmpfiles.d/*; do
	    [ -e "$f" ] || continue
	    mv "$f" "$PKG/usr/lib/tmpfiles.d/" || return 1
	done
	for f in "$PKG"/opt/kf6/share/dbus-1/system.d/*; do
	    [ -e "$f" ] || continue
	    mv "$f" "$PKG/usr/share/dbus-1/system.d/" || return 1
	done

	# plasmalogin is started by systemd, whose default PATH does not contain
	# /opt/kf6/bin. Tell the daemon exactly where its Wayland greeter launcher is.
	sed -i '/^ExecStart=\/opt\/kf6\/bin\/plasmalogin$/a Environment="PLASMALOGIN_GREETER_EXEC=/opt/kf6/bin/startplasma-login-wayland"' \
	    "$PKG/usr/lib/systemd/system/plasmalogin.service" || return 1

	grep -qF 'Environment="PLASMALOGIN_GREETER_EXEC=/opt/kf6/bin/startplasma-login-wayland"' \
	    "$PKG/usr/lib/systemd/system/plasmalogin.service" || {
	    echo "plasma-login-manager packaging error: greeter environment was not added" >&2
	    return 1
	}

	# Use the BFSOS PAM policy regardless of any distro-specific upstream sample.
	install -m0644 "$SRC/plasmalogin.pam" "$PKG/etc/pam.d/plasmalogin" || return 1
	install -m0644 "$SRC/plasmalogin-autologin.pam" "$PKG/etc/pam.d/plasmalogin-autologin" || return 1
	install -m0644 "$SRC/plasmalogin-greeter.pam" "$PKG/etc/pam.d/plasmalogin-greeter" || return 1
	install -m0755 "$SRC/bfs-display-manager" "$PKG/usr/sbin/bfs-display-manager" || return 1

	# Fail the package build if upstream changes the service name/layout. The
	# installer/helper must never guess a display-manager unit name.
	[ -f "$PKG/usr/lib/systemd/system/plasmalogin.service" ] || {
	    echo "plasma-login-manager packaging error: plasmalogin.service was not installed" >&2
	    return 1
	}
}
